node_modules/
dist/
.astro/
.env
.env.local
.tmp/
build/
.cache/
public/uploads/
*.log
.DS_Store
state/*
!state/.gitkeep
# Stock covers: tieni README e struttura tracked, ma NON le foto stesse
!state/stock-covers/
state/stock-covers/*
!state/stock-covers/README.md
!state/stock-covers/.gitkeep
!state/stock-covers/blog/
!state/stock-covers/tutorial/
!state/stock-covers/recipe/
!state/stock-covers/default/
state/stock-covers/blog/*
state/stock-covers/tutorial/*
state/stock-covers/recipe/*
state/stock-covers/default/*
!state/stock-covers/blog/.gitkeep
!state/stock-covers/tutorial/.gitkeep
!state/stock-covers/recipe/.gitkeep
!state/stock-covers/default/.gitkeep
# Fonts editoriale per overlay cover (Oswald-Bold.ttf etc.)
!state/fonts/
state/fonts/*
!state/fonts/.gitkeep
.env.windows
scripts/agents/.env.windows
docs/audit/

# Python bytecode caches (Ubuntu agents + Windows gate runner)
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Local backup files (es. cover_generator.py.local-backup pre-refactor)
*.local-backup
*.bak

# Runtime log dirs (i singoli *.log sono già coperti sopra ma il dir va escluso)
logs/

# One-off seed scripts manuali (Strapi POST batch — non production)
scripts/batch*.mjs
