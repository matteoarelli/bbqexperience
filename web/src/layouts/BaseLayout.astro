---
/**
 * Layout base — struttura HTML con SEO head, dark theme, e slot per header/footer
 */
import SEOHead from '@components/common/SEOHead.astro';
import ThemeToggle from '@components/common/ThemeToggle.svelte';
import CookieConsent from '@components/common/CookieConsent.astro';
import BackToTop from '@components/common/BackToTop.astro';
import KeyboardShortcuts from '@components/common/KeyboardShortcuts.astro';
import { loadTranslations, getTranslation } from '@lib/i18n';
import type { Locale } from '@lib/i18n';
import '@styles/global.css';
import '@styles/print.css';

interface Props {
  title: string;
  description: string;
  locale?: string;
  canonicalPath?: string;
  canonicalQuery?: string;
  ogImage?: string;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
  class?: string;
}

const {
  title,
  description,
  locale = 'en',
  canonicalPath = '',
  canonicalQuery = '',
  ogImage = '',
  type = 'website',
  publishedTime,
  modifiedTime,
  class: className = '',
} = Astro.props;

const translations = await loadTranslations(locale as any);
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <script is:inline>
      (function(){
        var t = localStorage.getItem('bbq-theme');
        if (t === 'light') document.documentElement.dataset.theme = 'light';
      })();
    </script>
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Umami Analytics — privacy-friendly, no cookies */}
    <script defer src="https://analytics.bbq-experience.com/script.js" data-website-id="REPLACE_WITH_WEBSITE_ID"></script>
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      canonicalPath={canonicalPath}
      canonicalQuery={canonicalQuery}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-accent-fire)] focus:text-[var(--color-text-inverse)] focus:rounded-md focus:font-bold focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-fire)] focus:ring-offset-2">
      {getTranslation(translations, 'common.skipToContent')}
    </a>

    <div class="fixed top-4 right-4 z-50">
      <ThemeToggle client:load label={getTranslation(translations, 'theme.toggle')} />
    </div>

    <slot name="header" />

    <main id="main-content" class={className}>
      <slot />
    </main>

    <slot name="footer" />

    <BackToTop />
    <KeyboardShortcuts />
    <CookieConsent locale={locale as Locale} translations={translations} />

    <!-- Scroll-reveal observer globale per data-animate -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('[data-animate], [data-animate-stagger]').forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
