---
/**
 * Layout base — struttura HTML con SEO head, dark theme, e slot per header/footer
 */
import SEOHead from '@components/common/SEOHead.astro';
import CookieConsent from '@components/common/CookieConsent.astro';
import BackToTop from '@components/common/BackToTop.astro';
import KeyboardShortcuts from '@components/common/KeyboardShortcuts.astro';
import TrustBar from '@components/common/TrustBar.astro';
import MobileMenuPanel from '@components/common/MobileMenuPanel.astro';
import ExitIntentModal from '@components/common/ExitIntentModal.astro';
import StickyNewsletterBar from '@components/common/StickyNewsletterBar.astro';
import { loadTranslations, getTranslation } from '@lib/i18n';
import type { Locale } from '@lib/i18n';
import '@styles/global.css';
import '@styles/print.css';

interface Props {
  title: string;
  description: string;
  locale?: string;
  canonicalPath?: string;
  canonicalQuery?: string;
  ogImage?: string;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
  class?: string;
  /**
   * URL della LCP image above-the-fold (cover hero per home/blog/tutorial/review).
   * Quando passata, emette un `<link rel="preload" as="image">` nello <head> per
   * anticipare il download della LCP image PRIMA che il browser parsi il <body>.
   * Riduce LCP di ~200-400 ms su mobile throttled. Pair con fetchpriority="high"
   * sull'<img>: il preload avvia il download, fetchpriority dice quale tra le
   * immagini in coda servire per prima.
   */
  preloadImage?: string;
  /** Se true, aggiunge noindex,follow al meta robots (per pagine filtrate) */
  noindex?: boolean;
  /** Locale disponibili con traduzione pubblicata (se omesso, emette hreflang per tutte le locale) */
  availableLocales?: string[];
}

const {
  title,
  description,
  locale = 'en',
  canonicalPath = '',
  canonicalQuery = '',
  ogImage = '',
  type = 'website',
  publishedTime,
  modifiedTime,
  class: className = '',
  preloadImage = '',
  noindex = false,
  availableLocales,
} = Astro.props;

const translations = await loadTranslations(locale as any);
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <script is:inline>
      (function(){
        var t = localStorage.getItem('bbq-theme');
        if (t === 'light') document.documentElement.dataset.theme = 'light';
      })();
    </script>
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* LCP preload: anticipa il download dell'immagine cover above-the-fold */}
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    {/* Umami Analytics — privacy-friendly, no cookies */}
    <script defer src="https://analytics.bbq-experience.com/script.js" data-website-id="78df95b7-1b94-43e7-9f0d-38c63e99cf64"></script>
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      canonicalPath={canonicalPath}
      canonicalQuery={canonicalQuery}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
      availableLocales={availableLocales}
    />
    {/* Slot esteso per <link rel="preload"> e altri tag <head> page-specifici */}
    <slot name="head-extras" />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-accent-fire)] focus:text-[var(--color-text-inverse)] focus:rounded-md focus:font-bold focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-fire)] focus:ring-offset-2">
      {getTranslation(translations, 'common.skipToContent')}
    </a>

    <slot name="header" />
    <TrustBar translations={translations} />

    <main id="main-content" class={className}>
      <slot />
    </main>

    <slot name="footer" />

    <MobileMenuPanel locale={locale as Locale} translations={translations} currentPath={Astro.url.pathname} />
    <ExitIntentModal locale={locale as Locale} translations={translations} />
    <StickyNewsletterBar locale={locale as Locale} translations={translations} />
    <BackToTop />
    <KeyboardShortcuts />
    <CookieConsent locale={locale as Locale} translations={translations} />

    <!-- Scroll-reveal observer globale per data-animate
         + fallback defensive: dopo 1.5s tutti gli elementi non ancora rivelati
         vengono forzati visibili (evita "phantom hidden" se l'observer non scatta) -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      const animated = document.querySelectorAll('[data-animate], [data-animate-stagger]');
      animated.forEach((el) => observer.observe(el));
      // Fallback: se l'observer non triggera (es. screenshot tool, prerender stale),
      // dopo 1.5s rendi visibile qualunque cosa sia ancora hidden.
      setTimeout(() => {
        animated.forEach((el) => {
          if (!el.classList.contains('visible')) {
            el.classList.add('visible');
            observer.unobserve(el);
          }
        });
      }, 1500);
    </script>
  </body>
</html>
