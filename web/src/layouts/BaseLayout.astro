---
/**
 * Layout base — struttura HTML con SEO head, dark theme, e slot per header/footer
 */
import SEOHead from '@components/common/SEOHead.astro';
import ThemeToggle from '@components/common/ThemeToggle.svelte';
import CookieConsent from '@components/common/CookieConsent.astro';
import BackToTop from '@components/common/BackToTop.astro';
import { loadTranslations, getTranslation } from '@lib/i18n';
import type { Locale } from '@lib/i18n';
import { ViewTransitions } from 'astro:transitions';
import '@styles/global.css';
import '@styles/print.css';

interface Props {
  title: string;
  description: string;
  locale?: string;
  canonicalPath?: string;
  ogImage?: string;
  class?: string;
}

const {
  title,
  description,
  locale = 'en',
  canonicalPath = '',
  ogImage = '',
  class: className = '',
} = Astro.props;

const translations = await loadTranslations(locale as any);
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <script is:inline>
      (function(){
        var t = localStorage.getItem('bbq-theme');
        if (t === 'light') document.documentElement.dataset.theme = 'light';
      })();
    </script>
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <SEOHead
      title={title}
      description={description}
      locale={locale}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
    />
    <ViewTransitions />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[var(--color-accent-fire)] focus:text-[var(--color-text-inverse)] focus:rounded-md focus:font-bold focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-fire)] focus:ring-offset-2">
      Skip to content
    </a>

    <div class="fixed top-4 right-4 z-50">
      <ThemeToggle client:load label={getTranslation(translations, 'theme.toggle')} />
    </div>

    <slot name="header" />

    <main id="main-content" class={className}>
      <slot />
    </main>

    <slot name="footer" />

    <BackToTop />
    <CookieConsent locale={locale as Locale} translations={translations} />
  </body>
</html>
