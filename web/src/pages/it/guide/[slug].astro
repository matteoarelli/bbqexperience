---
/**
 * Pagina dettaglio tutorial (IT) — articolo completo con breadcrumbs e metadata
 * SSR per supportare la modalita anteprima con contenuti draft.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import ContentLayout from '@components/content/ContentLayout.astro';
import ArticleSchema from '@components/content/ArticleSchema.astro';
import RelatedContent from '@components/content/RelatedContent.astro';
import SocialShareBar from '@components/social/SocialShareBar.astro';
import BreadcrumbJsonLd from '@components/common/BreadcrumbJsonLd.astro';
import { fetchBySlug } from '@lib/strapi';
import type { StrapiTutorial } from '@lib/types';
import { getContentStatus } from '@lib/preview';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';
import { getStrapiMediaURL } from '@lib/media';

export const prerender = false;

const locale: Locale = 'it';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

const { slug } = Astro.params;
const status = getContentStatus(Astro.cookies);

const tutorial = await fetchBySlug<StrapiTutorial>('tutorials', slug!, {
  locale,
  populate: 'cover_image',
  status,
});

if (!tutorial) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const tutorialRoute = localizedRoutes.tutorials[locale];
const seoTitle = tutorial.seo_title || tutorial.title;
const seoDescription = tutorial.seo_description || tutorial.excerpt || '';
const canonicalUrl = `https://bbqexperience.com/${locale}/${tutorialRoute}/${tutorial.slug}/`;
const coverImageUrl = getStrapiMediaURL(tutorial.cover_image);
const pageUrl = new URL(Astro.url.pathname, Astro.site || 'https://bbqexperience.com').href;

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.tutorials'), href: `/${locale}/${tutorialRoute}/` },
  { label: tutorial.title },
];

// Colori badge difficolta
const difficultyColors: Record<string, string> = {
  beginner: '#22c55e',
  intermediate: '#f59e0b',
  advanced: '#ef4444',
};
---

<BaseLayout
  title={`${seoTitle} - ${t('site.name')}`}
  description={seoDescription}
  locale={locale}
  canonicalPath={`/${locale}/${tutorialRoute}/${tutorial.slug}/`}
  ogImage={coverImageUrl || ''}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${tutorialRoute}/${tutorial.slug}/`} />

  <ArticleSchema
    title={seoTitle}
    description={seoDescription}
    url={canonicalUrl}
    datePublished={tutorial.published_date}
    dateModified={tutorial.updatedAt}
    imageUrl={coverImageUrl}
    locale={locale}
  />

  {Astro.locals.isPreview && (
    <div class="preview-banner">
      MODALITA ANTEPRIMA — Questo contenuto non e pubblicato
      <a href="/api/preview?action=exit" class="preview-exit">Esci dall'anteprima</a>
    </div>
  )}

  <div data-pagefind-body>
    <ContentLayout
      title={tutorial.title}
      content={tutorial.content}
      coverImage={tutorial.cover_image}
      readingTime={tutorial.reading_time}
      publishedDate={tutorial.published_date}
      category={tutorial.category}
      locale={locale}
      translations={translations}
    >
      <Breadcrumbs slot="breadcrumbs" items={breadcrumbItems} locale={locale} />

      {tutorial.difficulty && (
        <div slot="badges" class="difficulty-badge-row">
          <span
            class="difficulty-badge"
            style={`background-color: ${difficultyColors[tutorial.difficulty] || 'var(--color-accent-fire)'};`}
          >
            {t(`content.${tutorial.difficulty}`)}
          </span>
        </div>
      )}

      <RelatedContent slot="related" locale={locale} translations={translations} currentSlug={tutorial.slug} currentType="tutorial" />
    </ContentLayout>
  </div>

  <div class="max-w-4xl mx-auto px-[var(--container-padding)]" style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border-subtle);">
    <SocialShareBar url={pageUrl} title={tutorial.title} locale={locale} translations={translations} />
  </div>

  <BreadcrumbJsonLd items={breadcrumbItems} />

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .preview-banner {
    background-color: #f59e0b;
    color: #000;
    text-align: center;
    padding: var(--space-2) var(--space-4);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .preview-exit {
    color: #000;
    text-decoration: underline;
    margin-left: var(--space-4);
  }

  .difficulty-badge-row {
    margin-bottom: var(--space-4);
  }

  .difficulty-badge {
    display: inline-block;
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }
</style>
