---
/**
 * Pagina listing tutorial (IT) — griglia di guide con filtro categoria, ordinamento e paginazione.
 * SSR per supportare filtro categoria, sort e paginazione dinamici via query param.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import ArticleCard from '@components/content/ArticleCard.astro';
import Pagination from '@components/common/Pagination.astro';
import SortControls from '@components/common/SortControls.astro';
import CollectionPageSchema from '@components/common/CollectionPageSchema.astro';
import { fetchCollection } from '@lib/strapi';
import type { StrapiTutorial } from '@lib/types';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = false;

const locale: Locale = 'it';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

// Categorie disponibili per i tutorial
const categories = ['technique', 'equipment', 'knowledge', 'safety'] as const;
const activeCategory = Astro.url.searchParams.get('category') || null;

// Paginazione e ordinamento da query params
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const activeSort = Astro.url.searchParams.get('sort') || 'newest';

// Mappa ordinamento -> campo Strapi
const sortMap: Record<string, string> = {
  newest: 'published_date:desc',
  alphabetical: 'title:asc',
};

// Opzioni di ordinamento per il componente SortControls
const sortOptions = [
  { value: 'newest', label: t('sort.newest') },
  { value: 'alphabetical', label: t('sort.alphabetical') },
];

// Recupera i tutorial con filtro categoria opzionale
const fetchOptions: Parameters<typeof fetchCollection>[1] = {
  locale,
  populate: '*',
  sort: sortMap[activeSort] || sortMap.newest,
  pageSize: 12,
  page: currentPage,
};

if (activeCategory && categories.includes(activeCategory as typeof categories[number])) {
  fetchOptions.filters = { category: { $eq: activeCategory } };
}

let tutorials: (StrapiTutorial & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
let totalCount = 0;
let totalPages = 1;
let fetchError = false;
try {
  const response = await fetchCollection<StrapiTutorial>('tutorials', fetchOptions);
  tutorials = response.data;
  totalCount = response.meta.pagination.total;
  totalPages = response.meta.pagination.pageCount;
} catch {
  fetchError = true;
}
const tutorialRoute = localizedRoutes.tutorials[locale];

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.tutorials') },
];
---

<BaseLayout
  title={`${t('content.tutorials')} - ${t('site.name')}`}
  description={t('site.description')}
  locale={locale}
  canonicalPath={`/${tutorialRoute}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${tutorialRoute}/`} />

  <section class="container-bbq py-12">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <CollectionPageSchema
      title={`${t('content.allTutorials')} - ${t('site.name')}`}
      description={t('site.description')}
      url={`https://bbq-experience.com/${locale}/${tutorialRoute}/`}
      itemCount={totalCount}
    />

    <h1 class="page-title">{t('content.allTutorials')}</h1>

    {/* Barra filtro categorie */}
    <div class="category-filter">
      <a
        href={`/${locale}/${tutorialRoute}/`}
        class:list={['filter-btn', { 'filter-btn--active': !activeCategory }]}
      >
        {t('content.allCategories')}
      </a>
      {categories.map((cat) => (
        <a
          href={`/${locale}/${tutorialRoute}/?category=${cat}`}
          class:list={['filter-btn', { 'filter-btn--active': activeCategory === cat }]}
        >
          {t(`content.${cat}`)}
        </a>
      ))}
    </div>

    {/* Controlli ordinamento */}
    <SortControls
      currentSort={activeSort}
      options={sortOptions}
      baseUrl={Astro.url.href}
    />

    {/* Conteggio risultati */}
    {!fetchError && totalCount > 0 && (
      <p class="result-count">
        {t('common.showing')} {tutorials.length} {t('common.of')} {totalCount} {t('common.results')}
      </p>
    )}

    {fetchError ? (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('common.contentUnavailable')}</p>
      </div>
    ) : tutorials.length > 0 ? (
      <div class="tutorial-grid" data-animate>
        {tutorials.map((tutorial) => (
          <ArticleCard
            title={tutorial.title}
            excerpt={tutorial.excerpt}
            slug={tutorial.slug}
            href={`/${locale}/${tutorialRoute}/${tutorial.slug}/`}
            coverImage={tutorial.cover_image}
            category={tutorial.category}
            readingTime={tutorial.reading_time}
            publishedDate={tutorial.published_date}
            locale={locale}
            translations={translations}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('content.noArticles')}</p>
      </div>
    )}

    {/* Paginazione */}
    {!fetchError && totalPages > 1 && (
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={Astro.url.href}
        translations={translations}
      />
    )}
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .filter-btn {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    background-color: transparent;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-secondary);
  }

  .filter-btn--active {
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    border-color: var(--color-accent-fire);
  }

  .filter-btn--active:hover {
    background-color: var(--color-accent-ember);
    border-color: var(--color-accent-ember);
    color: var(--color-text-inverse);
  }

  .result-count {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-6);
  }

  .tutorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .tutorial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tutorial-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-24) 0;
  }

  .empty-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
