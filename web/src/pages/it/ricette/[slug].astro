---
/**
 * Pagina ricetta (IT) — Template completo con intro editoriale, ingredienti,
 * istruzioni passo-passo, e dati strutturati JSON-LD per SEO.
 * SSR per supportare la modalita anteprima con contenuti draft.
 */
import { fetchBySlug } from '@lib/strapi';
import type { StrapiRecipe } from '@lib/types';
import { getStrapiMediaURL } from '@lib/media';
import { getContentStatus } from '@lib/preview';
import BaseLayout from '@layouts/BaseLayout.astro';
import JumpToRecipe from '@components/recipe/JumpToRecipe.astro';
import RecipeHeader from '@components/recipe/RecipeHeader.astro';
import RecipeInstructions from '@components/recipe/RecipeInstructions.astro';
import RecipeJsonLd from '@components/recipe/RecipeJsonLd.astro';
import RecipeInteractive from '@components/recipe/RecipeInteractive.svelte';
import CookMode from '@components/recipe/CookMode.svelte';
import PrintRecipeCard from '@components/recipe/PrintRecipeCard.astro';
import SocialShareBar from '@components/social/SocialShareBar.astro';
import BookmarkButton from '@components/common/BookmarkButton.svelte';
import AuthorCard from '@components/content/AuthorCard.astro';
import BreadcrumbJsonLd from '@components/common/BreadcrumbJsonLd.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import LastUpdated from '@components/content/LastUpdated.astro';
import { loadTranslations, getTranslation } from '@lib/i18n';
import PrevNextNav from '@components/content/PrevNextNav.astro';
import RelatedRecipes from '@components/content/RelatedRecipes.astro';
import '@styles/print.css';
import { renderMarkdown } from '@lib/markdown';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';
import CollectionBadge from '@components/collection/CollectionBadge.astro';

export const prerender = false;

const { slug } = Astro.params;
const status = getContentStatus(Astro.cookies);
const recipe = await fetchBySlug<StrapiRecipe>('recipes', slug!, {
  locale: 'it',
  populate: '*',
  status,
});

if (!recipe) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Calcolo tempo di lettura dal contenuto editoriale
const introWordCount = recipe.editorial_intro ? recipe.editorial_intro.replace(/<[^>]+>/g, '').split(/\s+/).filter(Boolean).length : 0;
const instructionsWordCount = recipe.instructions ? recipe.instructions.reduce((acc: number, inst: { text?: string }) => acc + (inst.text ? inst.text.split(/\s+/).filter(Boolean).length : 0), 0) : 0;
const readingTime = Math.max(1, Math.ceil((introWordCount + instructionsWordCount) / 200));

const coverImageUrl = getStrapiMediaURL(recipe.cover_image);
const pageTitle = recipe.seo_title || recipe.title;
const pageDescription = recipe.seo_description || recipe.excerpt || '';
const translations = await loadTranslations('it');
const pageUrl = new URL(Astro.url.pathname, Astro.site || 'https://bbq-experience.com').href;

// Breadcrumbs
const breadcrumbItems = [
  { label: getTranslation(translations, 'content.home'), href: '/it/' },
  { label: getTranslation(translations, 'nav.recipes'), href: '/it/ricette/' },
  { label: recipe.title },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale="it"
  canonicalPath={`/ricette/${recipe.slug}/`}
  ogImage={coverImageUrl || ''}
>
  <Header slot="header" locale="it" translations={translations} currentPath={Astro.url.pathname} />

  {status === 'draft' && (
    <div class="bg-amber-500 text-black text-center py-2 px-4 font-bold text-sm">
      MODALITA ANTEPRIMA — Questo contenuto non e pubblicato
      <a href="/api/preview?action=exit" class="underline ml-4">Esci dall'anteprima</a>
    </div>
  )}

  <!-- Hero ricetta con immagine, titolo overlay e badge -->
  {coverImageUrl && (
    <div class="recipe-hero">
      <img src={coverImageUrl} alt={recipe.title} class="recipe-hero__image" loading="eager" />
      <div class="recipe-hero__overlay"></div>
      <div class="recipe-hero__content">
        <h1 class="recipe-hero__title">{recipe.title}</h1>
        <div class="recipe-hero__badges">
          {recipe.total_time && (
            <span class="recipe-hero__badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              {recipe.total_time} min
            </span>
          )}
          {recipe.difficulty && (
            <span class="recipe-hero__badge recipe-hero__badge--fire">
              {getTranslation(translations, `content.${recipe.difficulty}`)}
            </span>
          )}
          {recipe.servings && (
            <span class="recipe-hero__badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              {recipe.servings} porzioni
            </span>
          )}
        </div>
      </div>
    </div>
  )}

  <article class="max-w-3xl mx-auto px-4 py-12" style="color: var(--color-text-primary);">
    <Breadcrumbs items={breadcrumbItems} locale="it" />

    {recipe.collection && (
      <div style="margin-bottom: var(--space-4);">
        <CollectionBadge
          collectionTitle={recipe.collection.title}
          collectionSlug={recipe.collection.slug}
          locale="it"
          translations={translations}
        />
      </div>
    )}

    {recipe.updatedAt && (
      <LastUpdated date={recipe.updatedAt} locale="it" translations={translations} />
    )}

    <!-- Metadati data e tempo lettura -->
    <div class="flex flex-wrap gap-3 mb-[var(--space-4)]" style="color: var(--color-text-muted); font-size: var(--text-sm);">
      {recipe.published_date && (
        <span>{new Date(recipe.published_date).toLocaleDateString('it', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      )}
      {readingTime && (
        <span>| {getTranslation(translations, 'content.minRead').replace('{time}', String(readingTime))}</span>
      )}
    </div>

    <div class="no-print">
      <JumpToRecipe label="Vai alla Ricetta" totalTime={recipe.total_time} />
    </div>

    {/* Sezione intro editoriale (nascosta in stampa) */}
    {recipe.editorial_intro && (
      <div
        class="prose prose-invert max-w-none mb-12 no-print recipe-editorial"
        style="color: var(--color-text-secondary);"
        set:html={renderMarkdown(recipe.editorial_intro)}
      />
    )}

    {/* Card ricetta principale */}
    <div id="recipe-card" class="rounded-xl p-6 md:p-8" style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border-subtle);">
      <RecipeHeader
        title={recipe.title}
        coverImage={recipe.cover_image}
        prepTime={recipe.prep_time}
        cookTime={recipe.cook_time}
        totalTime={recipe.total_time}
        difficulty={recipe.difficulty}
        servings={recipe.servings}
        meatType={recipe.meat_type}
        technique={recipe.technique}
      />

      <PrintRecipeCard
        recipeUrl={`https://bbq-experience.com/it/ricette/${recipe.slug}`}
        label="Stampa Ricetta"
      />

      {/* Sezione ingredienti — isola interattiva Svelte */}
      {recipe.ingredients && recipe.ingredients.length > 0 && (
        <section class="mb-10" id="ingredients-section">
          <RecipeInteractive
            client:visible
            ingredients={recipe.ingredients || []}
            baseServings={recipe.servings || 4}
            labels={{ servings: "Porzioni", metric: "Metrico", imperial: "Imperiale", ingredients: "Ingredienti" }}
          />
        </section>
      )}

      {/* Sezione istruzioni */}
      {recipe.instructions && recipe.instructions.length > 0 && (
        <section class="mb-6">
          <h2
            class="text-2xl font-bold mb-6 uppercase tracking-wide"
            style="font-family: var(--font-heading); color: var(--color-accent-amber);"
          >
            Istruzioni
          </h2>
          <RecipeInstructions instructions={recipe.instructions} />

          <CookMode
            client:visible
            instructions={(recipe.instructions || []).map((inst) => ({
              step: inst.step,
              text: inst.text,
              imageUrl: inst.image ? getStrapiMediaURL(inst.image) ?? undefined : undefined,
            }))}
            recipeName={recipe.title}
            labels={{ cookMode: "Modalita Cottura", step: "Passo", of: "di", prev: "Precedente", next: "Successivo", finish: "Fine", exit: "Esci" }}
          />
        </section>
      )}
    </div>

    <!-- Card autore -->
    <AuthorCard locale="it" translations={translations} />

    <!-- Condivisione social -->
    <div style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border-subtle);">
      <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
        <SocialShareBar url={pageUrl} title={recipe.title} locale="it" translations={translations} />
        <BookmarkButton client:load slug={recipe.slug} title={recipe.title} contentType="recipe" locale="it" labelSave={getTranslation(translations, 'bookmarks.save')} labelRemove={getTranslation(translations, 'bookmarks.remove')} />
      </div>
    </div>

    <!-- Ricette correlate -->
    <RelatedRecipes
      locale="it"
      translations={translations}
      currentSlug={recipe.slug}
      technique={recipe.technique}
      meatType={recipe.meat_type}
    />

    <!-- Navigazione precedente/successivo -->
    <PrevNextNav contentType="recipes" currentSlug={recipe.slug} locale="it" translations={translations} />

    <RecipeJsonLd recipe={recipe} locale="it" />
    <BreadcrumbJsonLd items={breadcrumbItems} />
  </article>

  <div class="max-w-4xl mx-auto px-[var(--container-padding)]" style="margin-top: var(--space-8);">
    <NewsletterSignup translations={translations} source="inline" />
  </div>

  <Footer slot="footer" locale="it" translations={translations} />
</BaseLayout>

<style>
  /* Hero ricetta con immagine full-width e overlay */
  .recipe-hero {
    position: relative;
    width: 100%;
    max-height: 450px;
    overflow: hidden;
  }

  .recipe-hero__image {
    width: 100%;
    height: 450px;
    object-fit: cover;
  }

  .recipe-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 30%, rgba(13, 13, 13, 0.95) 100%);
    pointer-events: none;
  }

  .recipe-hero__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-8);
    z-index: 2;
    text-align: center;
  }

  .recipe-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw + 0.5rem, 3.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.95;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4) 0;
  }

  .recipe-hero__badges {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .recipe-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .recipe-hero__badge--fire {
    background: rgba(249, 115, 22, 0.2);
    border-color: rgba(249, 115, 22, 0.4);
    color: var(--color-accent-amber);
  }

  /* Drop cap nell'intro editoriale */
  .recipe-editorial :global(p:first-of-type::first-letter) {
    float: left;
    font-family: var(--font-heading);
    font-size: 3.8em;
    font-weight: 900;
    line-height: 0.8;
    margin-right: 0.08em;
    margin-top: 0.05em;
    color: transparent;
    background: linear-gradient(135deg, var(--color-accent-fire), var(--color-accent-amber));
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>
