---
/**
 * Pagina ricetta (IT) — Template completo con intro editoriale, ingredienti,
 * istruzioni passo-passo, e dati strutturati JSON-LD per SEO.
 * SSR per supportare la modalita anteprima con contenuti draft.
 */
import { fetchBySlug } from '@lib/strapi';
import type { StrapiRecipe } from '@lib/types';
import { getStrapiMediaURL } from '@lib/media';
import { getContentStatus } from '@lib/preview';
import BaseLayout from '@layouts/BaseLayout.astro';
import JumpToRecipe from '@components/recipe/JumpToRecipe.astro';
import RecipeHeader from '@components/recipe/RecipeHeader.astro';
import RecipeInstructions from '@components/recipe/RecipeInstructions.astro';
import RecipeJsonLd from '@components/recipe/RecipeJsonLd.astro';
import RecipeInteractive from '@components/recipe/RecipeInteractive.svelte';
import CookMode from '@components/recipe/CookMode.svelte';
import PrintRecipeCard from '@components/recipe/PrintRecipeCard.astro';
import SocialShareBar from '@components/social/SocialShareBar.astro';
import BreadcrumbJsonLd from '@components/common/BreadcrumbJsonLd.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import { loadTranslations, getTranslation } from '@lib/i18n';
import '@styles/print.css';

export const prerender = false;

const { slug } = Astro.params;
const status = getContentStatus(Astro.cookies);
const recipe = await fetchBySlug<StrapiRecipe>('recipes', slug!, {
  locale: 'it',
  populate: '*',
  status,
});

if (!recipe) {
  return Astro.redirect('/it/');
}

const coverImageUrl = getStrapiMediaURL(recipe.cover_image);
const pageTitle = recipe.seo_title || recipe.title;
const pageDescription = recipe.seo_description || recipe.excerpt || '';
const translations = await loadTranslations('it');
const pageUrl = new URL(Astro.url.pathname, Astro.site || 'https://bbqexperience.com').href;

// Breadcrumbs
const breadcrumbItems = [
  { label: getTranslation(translations, 'content.home'), href: '/it/' },
  { label: getTranslation(translations, 'nav.recipes'), href: '/it/ricette/' },
  { label: recipe.title },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  locale="it"
  canonicalPath={`/it/ricette/${recipe.slug}`}
  ogImage={coverImageUrl || ''}
>
  <Header slot="header" locale="it" translations={translations} currentPath={Astro.url.pathname} />

  {status === 'draft' && (
    <div class="bg-amber-500 text-black text-center py-2 px-4 font-bold text-sm">
      MODALITA ANTEPRIMA — Questo contenuto non e pubblicato
      <a href="/api/preview?action=exit" class="underline ml-4">Esci dall'anteprima</a>
    </div>
  )}

  <article class="max-w-3xl mx-auto px-4 py-12" style="color: var(--color-text-primary);">
    <Breadcrumbs items={breadcrumbItems} locale="it" />

    <div class="no-print">
      <JumpToRecipe label="Vai alla Ricetta" totalTime={recipe.total_time} />
    </div>

    {/* Sezione intro editoriale (nascosta in stampa) */}
    {recipe.editorial_intro && (
      <div
        class="prose prose-invert max-w-none mb-12 no-print"
        style="color: var(--color-text-secondary);"
        set:html={recipe.editorial_intro}
      />
    )}

    {/* Card ricetta principale */}
    <div id="recipe-card" class="rounded-xl p-6 md:p-8" style="background-color: var(--color-bg-secondary); border: 1px solid var(--color-border-subtle);">
      <RecipeHeader
        title={recipe.title}
        coverImage={recipe.cover_image}
        prepTime={recipe.prep_time}
        cookTime={recipe.cook_time}
        totalTime={recipe.total_time}
        difficulty={recipe.difficulty}
        servings={recipe.servings}
        meatType={recipe.meat_type}
        technique={recipe.technique}
      />

      <PrintRecipeCard
        recipeUrl={`https://bbqexperience.com/it/ricette/${recipe.slug}`}
        label="Stampa Ricetta"
      />

      {/* Sezione ingredienti — isola interattiva Svelte */}
      {recipe.ingredients && recipe.ingredients.length > 0 && (
        <section class="mb-10" id="ingredients-section">
          <RecipeInteractive
            client:visible
            ingredients={recipe.ingredients || []}
            baseServings={recipe.servings || 4}
            labels={{ servings: "Porzioni", metric: "Metrico", imperial: "Imperiale", ingredients: "Ingredienti" }}
          />
        </section>
      )}

      {/* Sezione istruzioni */}
      {recipe.instructions && recipe.instructions.length > 0 && (
        <section class="mb-6">
          <h2
            class="text-2xl font-bold mb-6 uppercase tracking-wide"
            style="font-family: var(--font-heading); color: var(--color-accent-amber);"
          >
            Istruzioni
          </h2>
          <RecipeInstructions instructions={recipe.instructions} />

          <CookMode
            client:visible
            instructions={(recipe.instructions || []).map((inst) => ({
              step: inst.step,
              text: inst.text,
              imageUrl: inst.image ? getStrapiMediaURL(inst.image) ?? undefined : undefined,
            }))}
            recipeName={recipe.title}
            labels={{ cookMode: "Modalita Cottura", step: "Passo", of: "di", prev: "Precedente", next: "Successivo", finish: "Fine", exit: "Esci" }}
          />
        </section>
      )}
    </div>

    <!-- Condivisione social -->
    <div style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border-subtle);">
      <SocialShareBar url={pageUrl} title={recipe.title} locale="it" translations={translations} />
    </div>

    <RecipeJsonLd recipe={recipe} locale="it" />
    <BreadcrumbJsonLd items={breadcrumbItems} />
  </article>

  <Footer slot="footer" locale="it" translations={translations} />
</BaseLayout>
