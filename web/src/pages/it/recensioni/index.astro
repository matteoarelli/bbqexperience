---
/**
 * Pagina listing recensioni (IT) — griglia di review con filtri multi-facet
 * (marca, categoria, prezzo, punteggio), ordinamento e paginazione.
 * SSR per supportare filtri dinamici via query param.
 * URL filtrati emettono noindex,follow + canonical alla pagina non filtrata.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import ReviewCard from '@components/home/ReviewCard.astro';
import Pagination from '@components/common/Pagination.astro';
import SortControls from '@components/common/SortControls.astro';
import PopularReviews from '@components/content/PopularReviews.astro';
import ContentStats from '@components/content/ContentStats.astro';
import CollectionPageSchema from '@components/common/CollectionPageSchema.astro';
import ReviewFilterBar from '@components/review/ReviewFilterBar.astro';
import ReviewEmptyState from '@components/review/ReviewEmptyState.astro';
import ReviewFilterDrawer from '@components/review/ReviewFilterDrawer.svelte';
import { fetchCollection } from '@lib/strapi';
import type { StrapiReview, StrapiProductCategory, StrapiBrand } from '@lib/types';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';
import {
  parseFilterParams,
  hasActiveFilters,
  buildStrapiFilters,
  computeFacetCounts,
  buildFilterUrl,
  PRICE_BUCKETS,
  PRICE_BUCKET_LABELS,
  SCORE_THRESHOLDS,
} from '@lib/filters';

export const prerender = false;

const locale: Locale = 'it';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

// Parsing filtri dalla URL
const activeFilters = parseFilterParams(Astro.url.searchParams);
const filtersActive = hasActiveFilters(activeFilters);

// Paginazione e ordinamento da query params
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const activeSort = Astro.url.searchParams.get('sort') || 'newest';

// Mappa ordinamento -> campo Strapi
const sortMap: Record<string, string> = {
  newest: 'published_date:desc',
  highestScore: 'score_overall:desc',
  lowestScore: 'score_overall:asc',
};

// Opzioni di ordinamento per il componente SortControls
const sortOptions = [
  { value: 'newest', label: t('sort.newest') },
  { value: 'highestScore', label: t('sort.highestScore') },
  { value: 'lowestScore', label: t('sort.lowestScore') },
];

const reviewRoute = localizedRoutes.reviews[locale];
const basePath = `/${locale}/${reviewRoute}/`;

let reviews: (StrapiReview & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
let totalCount = 0;
let totalPages = 1;
let fetchError = false;

// Conteggi facet e dati filtri
let facetCounts = { brands: {} as Record<string, number>, categories: {} as Record<string, number>, priceBuckets: {} as Record<string, number>, scoreThresholds: {} as Record<string, number> };
let brandsWithProducts: Array<{ slug: string; name: string; count: number }> = [];
let categoriesWithProducts: Array<{ slug: string; name: string; count: number }> = [];

try {
  // Fetch TUTTE le review (campi minimi) per conteggi facet
  const allReviewsResponse = await fetchCollection<StrapiReview>('reviews', {
    locale,
    populate: ['product', 'product.brand_relation', 'product.product_category'],
    pageSize: 100,
  });
  facetCounts = computeFacetCounts(allReviewsResponse.data);

  // Fetch review filtrate per la pagina corrente
  const strapiFilters = buildStrapiFilters(activeFilters);
  const response = await fetchCollection<StrapiReview>('reviews', {
    locale,
    populate: ['product', 'product.brand_relation', 'product.product_category', 'gallery'],
    filters: strapiFilters,
    sort: sortMap[activeSort] || sortMap.newest,
    pageSize: 12,
    page: currentPage,
  });
  reviews = response.data;
  totalCount = response.meta.pagination.total;
  totalPages = response.meta.pagination.pageCount;

  // Fetch brand e categorie per le label dei filtri (localizzate)
  const brandsResponse = await fetchCollection<StrapiBrand>('brands', { locale, pageSize: 100 });
  brandsWithProducts = brandsResponse.data
    .filter((b) => (facetCounts.brands[b.slug] || 0) > 0)
    .map((b) => ({ slug: b.slug, name: b.name, count: facetCounts.brands[b.slug] }))
    .sort((a, b) => b.count - a.count);

  const categoriesResponse = await fetchCollection<StrapiProductCategory>('product-categories', { locale, pageSize: 100 });
  categoriesWithProducts = categoriesResponse.data
    .filter((c) => (facetCounts.categories[c.slug] || 0) > 0)
    .map((c) => ({ slug: c.slug, name: c.name, count: facetCounts.categories[c.slug] }))
    .sort((a, b) => b.count - a.count);
} catch {
  fetchError = true;
}

// Pre-compute URL per ogni opzione filtro (passati al drawer come props)
const brandsWithUrls = brandsWithProducts.map((b) => ({
  ...b,
  url: buildFilterUrl(basePath, { ...activeFilters, brand: b.slug }),
}));
const categoriesWithUrls = categoriesWithProducts.map((c) => ({
  ...c,
  url: buildFilterUrl(basePath, { ...activeFilters, category: c.slug }),
}));

// Dati per il drawer mobile — bucket prezzo con URL
const priceBucketOptions = Object.entries(PRICE_BUCKETS)
  .filter(([key]) => (facetCounts.priceBuckets[key] || 0) > 0)
  .map(([key]) => ({
    key,
    label: PRICE_BUCKET_LABELS[key][locale],
    count: facetCounts.priceBuckets[key],
    url: buildFilterUrl(basePath, { ...activeFilters, price: key }),
  }));

const scoreOptions = SCORE_THRESHOLDS.map((st) => ({
  value: st.value,
  label: st.label,
  count: facetCounts.scoreThresholds[st.value] || 0,
  url: buildFilterUrl(basePath, { ...activeFilters, score: st.value }),
}));

const clearUrl = buildFilterUrl(basePath, {});

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.reviews') },
];
---

<BaseLayout
  title={`${t('content.reviews')} - ${t('site.name')}`}
  description={t('site.description')}
  locale={locale}
  canonicalPath={`/${reviewRoute}/`}
  canonicalQuery={!filtersActive && currentPage > 1 ? `page=${currentPage}` : ''}
  noindex={filtersActive}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={basePath} />

  <section class="container-bbq py-12">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <CollectionPageSchema
      title={`${t('content.reviews')} - ${t('site.name')}`}
      description={t('site.description')}
      url={`https://bbq-experience.com${basePath}`}
      itemCount={totalCount}
    />

    <h1 class="page-title">{t('content.allReviews')}</h1>

    {/* Barra filtri desktop */}
    <ReviewFilterBar
      activeFilters={activeFilters}
      facetCounts={facetCounts}
      brands={brandsWithProducts}
      categories={categoriesWithProducts}
      basePath={basePath}
      locale={locale}
      translations={translations}
    />

    {/* Drawer filtri mobile */}
    <ReviewFilterDrawer
      client:visible
      brands={brandsWithUrls}
      categories={categoriesWithUrls}
      priceBuckets={priceBucketOptions}
      scoreThresholds={scoreOptions}
      activeFilters={activeFilters}
      basePath={basePath}
      clearUrl={clearUrl}
      applyLabel={t('filters.applyFilters')}
      clearLabel={t('filters.clearFilters')}
      closeLabel={t('filters.closeFilters')}
      brandLabel={t('filters.brand')}
      categoryLabel={t('filters.category')}
      priceLabel={t('filters.price')}
      scoreLabel={t('filters.score')}
      openLabel={t('filters.openFilters')}
      resultsLabel={t('filters.resultsCount')}
    />

    {/* Conteggio risultati filtrati */}
    {filtersActive && !fetchError && (
      <p class="result-count">
        {totalCount} {t('filters.resultsCount')}
      </p>
    )}

    {/* Barra statistiche */}
    {!fetchError && totalCount > 0 && (
      <ContentStats
        items={reviews.map((r) => ({ score: r.score_overall }))}
        type="reviews"
        totalCount={totalCount}
        locale={locale}
        translations={translations}
      />
    )}

    {/* Controlli ordinamento */}
    <SortControls
      currentSort={activeSort}
      options={sortOptions}
      baseUrl={Astro.url.href}
    />

    {/* Conteggio risultati generici */}
    {!filtersActive && !fetchError && totalCount > 0 && (
      <p class="result-count">
        {t('common.showing')} {reviews.length} {t('common.of')} {totalCount} {t('common.results')}
      </p>
    )}

    <div class="listing-layout">
      <div class="listing-main">
        {fetchError ? (
          <div class="empty-state" data-animate>
            <p class="empty-text">{t('common.contentUnavailable')}</p>
          </div>
        ) : reviews.length > 0 ? (
          <div class="review-grid" data-animate>
            {reviews.map((review) => (
              <ReviewCard
                review={review}
                locale={locale}
                reviewsRoute={reviewRoute}
                readMoreLabel={t('common.readMore')}
              />
            ))}
          </div>
        ) : (
          <ReviewEmptyState basePath={basePath} locale={locale} translations={translations} />
        )}

        {/* Paginazione */}
        {!fetchError && totalPages > 1 && (
          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl={Astro.url.href}
            translations={translations}
          />
        )}
      </div>

      <aside class="listing-sidebar">
        <PopularReviews locale={locale} translations={translations} />
      </aside>
    </div>
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .result-count {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-6);
  }

  .review-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .review-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .review-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .listing-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .listing-main {
    flex: 1;
    min-width: 0;
  }

  .listing-sidebar {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .listing-layout {
      flex-direction: row;
    }

    .listing-sidebar {
      width: 300px;
      flex-shrink: 0;
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-24) 0;
  }

  .empty-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
