---
/**
 * Redirect 301 dalle vecchie route /it/recensioni/categoria/[category] al nuovo sistema
 * filtri query-param /it/recensioni/?category=[category].
 * Preserva il valore SEO dei link indicizzati da Google.
 */
export const prerender = false;

const { category } = Astro.params;
return Astro.redirect(`/it/recensioni/?category=${category}`, 301);
---
