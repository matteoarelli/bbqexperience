---
// Pagina Chi Siamo — storia del brand BBQ Experience (IT)
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import OrganizationJsonLd from '@components/common/OrganizationJsonLd.astro';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = true;

const locale: Locale = 'it';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);
---

<BaseLayout
  title={`${t('nav.about')} - ${t('site.name')}`}
  description="Siamo pitmaster stanchi di leggere recensioni false. 20 anni di fumo, test reali, nessun soldo dagli sponsor."
  locale={locale}
  canonicalPath={`/${localizedRoutes.about[locale]}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${localizedRoutes.about[locale]}/`} />

  <OrganizationJsonLd
    locale={locale}
    pageType="AboutPage"
    pageUrl={`https://bbq-experience.com/${locale}/${localizedRoutes.about[locale]}/`}
    pageName={`${t('nav.about')} — ${t('site.name')}`}
    description="Siamo pitmaster stanchi di leggere recensioni false. 20 anni di fumo, test reali, nessun soldo dagli sponsor."
  />

  <!-- Hero -->
  <section class="about-hero">
    <div class="container-bbq">
      <h1 class="about-hero__title">Chi e <span class="fire-text">BBQ Experience</span></h1>
      <p class="about-hero__subtitle">Non siamo un'azienda media. Siamo pitmaster stanchi di leggere recensioni false.</p>
    </div>
  </section>

  <!-- Mission -->
  <section class="about-section">
    <div class="container-bbq">
      <div class="about-grid">
        <div>
          <h2 class="section-title">Perche Lo Facciamo</h2>
          <p class="section-text">
            20 anni passati accanto al fuoco. Brisket bruciati, costine rovinate e abbastanza polvere di carbone
            nei polmoni da bastare una vita. Abbiamo creato BBQ Experience perche ogni recensione che leggevamo
            online era scritta da qualcuno che non aveva mai tenuto in mano una pinza. I soldi degli sponsor
            non influenzano i nostri voti. Punto.
          </p>
          <p class="section-text">
            Ogni prodotto viene distrutto prima che gli diamo un voto. Ci cuciniamo sopra, lo maltrattiamo,
            lo lasciamo sotto la pioggia e lo spingiamo oltre i suoi limiti. Se sopravvive, si guadagna il nostro
            rispetto. Se no, vi diciamo esattamente perche. Oltre 74K persone si fidano di noi perche non abbiamo
            mai falsificato un singolo voto.
          </p>
        </div>
        <div class="about-image-placeholder">
          <div class="placeholder-inner">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>Immagine Hero</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="about-stats">
    <div class="container-bbq">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-number">74K+</span>
          <span class="stat-label">Persone Che Si Fidano</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">20+</span>
          <span class="stat-label">Anni alla Griglia</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">100+</span>
          <span class="stat-label">Prodotti Distrutti</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">0</span>
          <span class="stat-label">Voti Sponsorizzati</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="about-section">
    <div class="container-bbq">
      <h2 class="section-title">Le Persone Dietro il Fumo</h2>
      <p class="section-text">
        Non siamo influencer. Non siamo content creator. Siamo quelli che si svegliano alle 4 di mattina per
        mettere un brisket sul fuoco, che discutono di essenze di legno a cena e che hanno speso piu soldi in
        termometri che la maggior parte della gente in vacanze. Questo non e un lavoro — e un'ossessione.
      </p>
      <p class="section-text">
        Le nostre recensioni vengono da settimane di uso reale — non da un pomeriggio di unboxing. Le nostre
        ricette falliscono dieci volte prima di finire sul sito. E quando diciamo che un prodotto e buono,
        intendiamo che lo compreremmo con i nostri soldi. E l'unico standard che conta.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="container-bbq" style="text-align: center;">
      <h2 class="section-title">Vieni a Parlare di BBQ</h2>
      <p class="section-text" style="max-width: 600px; margin: 0 auto var(--space-6);">
        Oltre 74K pitmaster ci seguono gia. Condividiamo cosa stiamo testando, cosa stiamo cucinando e cosa
        dovresti evitare. Niente fuffa, solo fuoco.
      </p>
      <a href="https://instagram.com/bbqexperience" target="_blank" rel="noopener noreferrer" class="cta-button">
        Segui @bbqexperience
      </a>
    </div>
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .about-hero {
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .about-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .about-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .about-section { padding: var(--space-16) 0; }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 768px) {
    .about-grid { grid-template-columns: 1fr 1fr; }
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-accent-fire);
    margin-bottom: var(--space-4);
  }

  .section-text {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .about-image-placeholder {
    aspect-ratio: 4/3;
    background-color: var(--color-bg-secondary);
    border: 2px dashed var(--color-border-subtle);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .about-stats {
    padding: var(--space-16) 0;
    background-color: var(--color-bg-secondary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .stat-card {
    text-align: center;
    padding: var(--space-6);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .stat-number {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-accent-fire);
  }

  .stat-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }

  .about-cta {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .cta-button {
    display: inline-block;
    padding: var(--space-3) var(--space-8);
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast);
  }

  .cta-button:hover { background-color: var(--color-accent-ember); }
</style>
