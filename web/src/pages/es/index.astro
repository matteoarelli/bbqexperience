---
// Homepage espanola — BBQ Experience
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import FeaturedHero from '@components/content/FeaturedHero.astro';
import InstagramFeed from '@components/social/InstagramFeed.astro';
import FollowCTA from '@components/social/FollowCTA.astro';
import SectionHeader from '@components/home/SectionHeader.astro';
import ReviewCard from '@components/home/ReviewCard.astro';
import RecipeCard from '@components/home/RecipeCard.astro';
import AboutSection from '@components/home/AboutSection.astro';
import CategoryLinks from '@components/home/CategoryLinks.astro';
import PlaceholderCard from '@components/home/PlaceholderCard.astro';
import ErrorFallback from '@components/common/ErrorFallback.astro';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';
import WebSiteJsonLd from '@components/common/WebSiteJsonLd.astro';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import { fetchCollection } from '@lib/strapi';
import { getStrapiMediaURL } from '@lib/media';
import type { Locale } from '@lib/i18n';
import type { StrapiReview, StrapiRecipe, StrapiTutorial, StrapiBlogPost } from '@lib/types';

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

// Route localizzate
const reviewsRoute = localizedRoutes.reviews[locale];
const recipesRoute = localizedRoutes.recipes[locale];
const tutorialsRoute = localizedRoutes.tutorials[locale];
const blogRoute = localizedRoutes.blog[locale];

// Fetch contenuti dal CMS — ogni sezione wrappata in try/catch
let latestReviews: (StrapiReview & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
try {
  const res = await fetchCollection<StrapiReview>('reviews', {
    locale, pageSize: 3, sort: 'published_date:desc', populate: ['gallery', 'product', 'product.images', 'product.brand_relation'],
  });
  latestReviews = res.data;
} catch { /* Strapi non disponibile */ }

let latestRecipes: (StrapiRecipe & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
try {
  const res = await fetchCollection<StrapiRecipe>('recipes', {
    locale, pageSize: 3, sort: 'published_date:desc', populate: 'cover_image',
  });
  latestRecipes = res.data;
} catch { /* Strapi non disponibile */ }

let latestTutorials: (StrapiTutorial & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
try {
  const res = await fetchCollection<StrapiTutorial>('tutorials', {
    locale, pageSize: 3, sort: 'published_date:desc', populate: 'cover_image',
  });
  latestTutorials = res.data;
} catch { /* Strapi non disponibile */ }

let latestPosts: (StrapiBlogPost & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
try {
  const res = await fetchCollection<StrapiBlogPost>('blog-posts', {
    locale, pageSize: 3, sort: 'published_date:desc',
  });
  latestPosts = res.data;
} catch { /* Strapi non disponibile */ }
---

<BaseLayout
  title={`${t('site.name')} - ${t('site.tagline')}`}
  description={t('site.description')}
  locale={locale}
  canonicalPath="/"
  ogImage="/api/og-image?title=BBQ+Experience"
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/`} />
  <WebSiteJsonLd locale={locale} />

  {/* 1. FeaturedHero */}
  <FeaturedHero locale={locale} translations={translations} />

  {/* 1b. Enlaces de Categoria */}
  <CategoryLinks locale={locale} translations={translations} />

  {/* 2. Ultimas Resenas */}
  <section class="homepage-section" data-animate="fade-up">
    <div class="container-bbq">
      <SectionHeader
        title={t('home.latestReviews')}
        viewAllText={t('home.viewAll')}
        viewAllHref={`/${locale}/${reviewsRoute}/`}
      />
      <div class="card-grid" data-animate-stagger>
        {latestReviews.length > 0 ? (
          latestReviews.map((review) => (
            <ReviewCard review={review} locale={locale} reviewsRoute={reviewsRoute} readMoreLabel={t('common.readMore')} />
          ))
        ) : (
          <ErrorFallback translations={translations} section="reviews" />
        )}
      </div>
    </div>
  </section>

  {/* 3. Ultimas Recetas */}
  <section class="homepage-section" data-animate="fade-up">
    <div class="container-bbq">
      <SectionHeader
        title={t('home.latestRecipes')}
        viewAllText={t('home.viewAll')}
        viewAllHref={`/${locale}/${recipesRoute}/`}
      />
      <div class="card-grid" data-animate-stagger>
        {latestRecipes.length > 0 ? (
          latestRecipes.map((recipe) => (
            <RecipeCard recipe={recipe} locale={locale} recipesRoute={recipesRoute} translations={translations} />
          ))
        ) : (
          <ErrorFallback translations={translations} section="recipes" />
        )}
      </div>
    </div>
  </section>

  {/* 4. Tutoriales Destacados */}
  <section class="homepage-section" data-animate="fade-up">
    <div class="container-bbq">
      <SectionHeader
        title={t('home.tutorialHighlights')}
        viewAllText={t('home.viewAll')}
        viewAllHref={`/${locale}/${tutorialsRoute}/`}
      />
      <div class="card-grid" data-animate-stagger>
        {latestTutorials.length > 0 ? (
          latestTutorials.map((tutorial) => {
            const imgUrl = getStrapiMediaURL(tutorial.cover_image);
            return (
              <a href={`/${locale}/${tutorialsRoute}/${tutorial.slug}/`} class="tutorial-card" data-animate>
                <div class="tutorial-card__image-wrapper">
                  {imgUrl ? (
                    <img src={imgUrl} alt={tutorial.cover_image?.alternativeText || tutorial.title} class="tutorial-card__image" loading="lazy" decoding="async" />
                  ) : (
                    <div class="tutorial-card__placeholder"></div>
                  )}
                  <div class="tutorial-card__overlay"></div>
                </div>
                <div class="tutorial-card__content">
                  <h3 class="tutorial-card__title">{tutorial.title}</h3>
                  {tutorial.reading_time && (
                    <span class="tutorial-card__time">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                      {t('content.minRead').replace('{time}', String(tutorial.reading_time))}
                    </span>
                  )}
                </div>
              </a>
            );
          })
        ) : (
          <ErrorFallback translations={translations} section="tutorials" />
        )}
      </div>
    </div>
  </section>

  {/* 5. Quien es BBQ Experience */}
  <section class="homepage-section" data-animate="fade-up">
    <AboutSection translations={translations} locale={locale} />
  </section>

  {/* 5b. Newsletter Signup */}
  <section class="homepage-section" data-animate="fade-up">
    <div class="container-bbq">
      <NewsletterSignup translations={translations} />
    </div>
  </section>

  {/* 6. Ultimos Articulos */}
  <section class="homepage-section" data-animate="fade-up">
    <div class="container-bbq">
      <SectionHeader
        title={t('home.latestPosts')}
        viewAllText={t('home.viewAll')}
        viewAllHref={`/${locale}/${blogRoute}/`}
      />
      {latestPosts.length > 0 ? (
        <div class="posts-list">
          {latestPosts.map((post) => {
            const date = post.published_date ? new Date(post.published_date).toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' }) : '';
            return (
              <a href={`/${locale}/${blogRoute}/${post.slug}/`} class="post-item" data-animate>
                {date && <time class="post-item__date">{date}</time>}
                <span class="post-item__title">{post.title}</span>
              </a>
            );
          })}
        </div>
      ) : (
        <ErrorFallback translations={translations} section="blog" />
      )}
    </div>
  </section>

  {/* 7. Instagram Feed */}
  <section class="homepage-section" data-animate="fade-up">
    <div class="container-bbq">
      <InstagramFeed locale={locale} translations={translations} maxPosts={6} />
    </div>
  </section>

  {/* 8. Follow CTA */}
  <FollowCTA locale={locale} translations={translations} />

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .homepage-section {
    padding: var(--space-16) 0;
  }

  .homepage-section:nth-child(even) {
    background-color: var(--color-bg-secondary);
  }

  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tutorial-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .tutorial-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-fire);
  }

  .tutorial-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-bg-tertiary);
  }

  .tutorial-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .tutorial-card:hover .tutorial-card__image {
    transform: scale(1.05);
  }

  .tutorial-card__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-bg-tertiary);
  }

  .tutorial-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(transparent, var(--color-bg-secondary));
    pointer-events: none;
  }

  .tutorial-card__content {
    padding: var(--space-4);
    flex: 1;
  }

  .tutorial-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.2;
  }

  .tutorial-card__time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-subtle);
    text-decoration: none;
    color: inherit;
    transition: background var(--transition-fast);
  }

  .post-item:first-child {
    border-top: 1px solid var(--color-border-subtle);
  }

  .post-item:hover {
    background: rgba(249, 115, 22, 0.05);
  }

  .post-item__date {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-text-muted);
    min-width: 100px;
    flex-shrink: 0;
  }

  .post-item__title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .post-item:hover .post-item__title {
    color: var(--color-accent-fire);
  }
</style>
