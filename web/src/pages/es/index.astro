---
// Homepage espanola — BBQ Experience
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Hero from '@components/common/Hero.astro';
import { loadTranslations, getTranslation } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);
---

<BaseLayout
  title={`${t('site.name')} - ${t('site.tagline')}`}
  description={t('site.description')}
  locale={locale}
  canonicalPath="/"
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/`} />

  <Hero
    title={t('hero.title')}
    subtitle={t('hero.subtitle')}
    ctaText={t('hero.cta')}
    ctaHref={`/${locale}/resenas/`}
    locale={locale}
  />

  <!-- Sezione placeholder para contenidos futuros -->
  <section class="container-bbq py-24" data-animate>
    <h2 class="text-center" style="font-family: var(--font-heading); font-size: var(--text-3xl);">
      {t('common.loading')}
    </h2>
    <p class="text-center mt-4" style="color: var(--color-text-muted);">
      Las secciones de contenido se agregaran en fases futuras.
    </p>
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>
