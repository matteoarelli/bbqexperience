---
/**
 * Pagina listing tutorial (ES) — griglia di tutoriales con filtro categoria
 * SSR para soportar filtro categoria dinamico via query param.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import ArticleCard from '@components/content/ArticleCard.astro';
import { fetchCollection } from '@lib/strapi';
import type { StrapiTutorial } from '@lib/types';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = false;

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

// Categorie disponibili per i tutorial
const categories = ['technique', 'equipment', 'knowledge', 'safety'] as const;
const activeCategory = Astro.url.searchParams.get('category') || null;

// Recupera i tutorial con filtro categoria opzionale
const fetchOptions: Parameters<typeof fetchCollection>[1] = {
  locale,
  populate: 'cover_image',
  sort: 'published_date:desc',
  pageSize: 25,
};

if (activeCategory && categories.includes(activeCategory as typeof categories[number])) {
  fetchOptions.filters = { category: { $eq: activeCategory } };
}

const response = await fetchCollection<StrapiTutorial>('tutorials', fetchOptions);
const tutorials = response.data;
const tutorialRoute = localizedRoutes.tutorials[locale];

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.tutorials') },
];
---

<BaseLayout
  title={`${t('content.tutorials')} - ${t('site.name')}`}
  description={t('site.description')}
  locale={locale}
  canonicalPath={`/${locale}/${tutorialRoute}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${tutorialRoute}/`} />

  <section class="container-bbq py-12">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <h1 class="page-title">{t('content.allTutorials')}</h1>

    <div class="category-filter">
      <a
        href={`/${locale}/${tutorialRoute}/`}
        class:list={['filter-btn', { 'filter-btn--active': !activeCategory }]}
      >
        {t('content.allCategories')}
      </a>
      {categories.map((cat) => (
        <a
          href={`/${locale}/${tutorialRoute}/?category=${cat}`}
          class:list={['filter-btn', { 'filter-btn--active': activeCategory === cat }]}
        >
          {t(`content.${cat}`)}
        </a>
      ))}
    </div>

    {tutorials.length > 0 ? (
      <div class="tutorial-grid" data-animate>
        {tutorials.map((tutorial) => (
          <ArticleCard
            title={tutorial.title}
            excerpt={tutorial.excerpt}
            slug={tutorial.slug}
            href={`/${locale}/${tutorialRoute}/${tutorial.slug}/`}
            coverImage={tutorial.cover_image}
            category={tutorial.category}
            readingTime={tutorial.reading_time}
            publishedDate={tutorial.published_date}
            locale={locale}
            translations={translations}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('content.noArticles')}</p>
      </div>
    )}
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .filter-btn {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    background-color: transparent;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-secondary);
  }

  .filter-btn--active {
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    border-color: var(--color-accent-fire);
  }

  .filter-btn--active:hover {
    background-color: var(--color-accent-ember);
    border-color: var(--color-accent-ember);
    color: var(--color-text-inverse);
  }

  .tutorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .tutorial-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tutorial-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-24) 0;
  }

  .empty-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
