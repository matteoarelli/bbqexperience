---
// Politica de Privacidad — BBQ Experience (ES)
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);
---

<BaseLayout
  title={`Politica de Privacidad - ${t('site.name')}`}
  description="Politica de Privacidad de BBQ Experience — como gestionamos tus datos y protegemos tu privacidad."
  locale={locale}
  canonicalPath={`/${locale}/${localizedRoutes.privacy[locale]}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${localizedRoutes.privacy[locale]}/`} />

  <section class="legal-page container-bbq py-16">
    <h1 class="legal-title">Politica de Privacidad</h1>
    <p class="legal-updated">Ultima actualizacion: 1 de abril de 2026</p>

    <div class="legal-content">
      <h2>1. Introduccion</h2>
      <p>
        BBQ Experience ("nosotros", "nuestro") opera el sitio web bbq-experience.com. Esta Politica de Privacidad
        explica como recopilamos, usamos y protegemos tus datos personales cuando visitas nuestro sitio web,
        en cumplimiento con el Reglamento General de Proteccion de Datos (RGPD) y otras leyes aplicables de
        proteccion de datos.
      </p>

      <h2>2. Responsable del Tratamiento</h2>
      <p>
        El responsable del tratamiento de datos para este sitio web es BBQ Experience. Para cualquier consulta
        relacionada con la privacidad, contactanos en: <strong>privacy@bbq-experience.com</strong>
      </p>

      <h2>3. Datos que Recopilamos</h2>
      <p>
        Como sitio web de solo contenido, no requerimos cuentas de usuario ni registro. Los datos que podemos
        recopilar incluyen:
      </p>
      <ul>
        <li><strong>Datos tecnicos:</strong> direccion IP, tipo de navegador, sistema operativo, URLs de referencia y paginas visitadas, recopilados automaticamente a traves de los registros del servidor.</li>
        <li><strong>Datos analiticos:</strong> estadisticas de uso anonimizadas para comprender como los visitantes interactuan con nuestro contenido.</li>
        <li><strong>Cookies:</strong> usamos cookies minimas unicamente para la funcionalidad de vista previa de contenido (solo con fines editoriales) y para el funcionamiento basico del sitio. No se utilizan cookies publicitarias ni de rastreo.</li>
      </ul>

      <h2>4. Como Usamos tus Datos</h2>
      <p>Usamos los datos recopilados exclusivamente para:</p>
      <ul>
        <li>Operar y mantener el sitio web</li>
        <li>Analizar el uso del sitio para mejorar nuestro contenido y la experiencia del usuario</li>
        <li>Garantizar la seguridad y el correcto funcionamiento del sitio web</li>
      </ul>

      <h2>5. Base Legal del Tratamiento</h2>
      <p>
        Procesamos tus datos basandonos en nuestro interes legitimo en operar y mejorar nuestro sitio web
        (Articulo 6(1)(f) RGPD). Para los analisis, nos basamos en tu consentimiento cuando lo requiera
        la ley aplicable.
      </p>

      <h2>6. Comparticion de Datos</h2>
      <p>
        No vendemos, intercambiamos ni alquilamos tus datos personales a terceros. Podemos compartir datos
        anonimizados y agregados con proveedores de analisis para ayudarnos a comprender los patrones de
        uso del sitio.
      </p>

      <h2>7. Retencion de Datos</h2>
      <p>
        Los registros del servidor se conservan por un maximo de 90 dias. Los datos analiticos se almacenan
        en forma anonimizada y se conservan hasta 26 meses.
      </p>

      <h2>8. Tus Derechos</h2>
      <p>Bajo el RGPD, tienes derecho a:</p>
      <ul>
        <li>Acceder a tus datos personales</li>
        <li>Rectificar datos inexactos</li>
        <li>Solicitar la eliminacion de tus datos</li>
        <li>Restringir el tratamiento de tus datos</li>
        <li>Portabilidad de datos</li>
        <li>Oponerte al tratamiento</li>
        <li>Presentar una queja ante una autoridad de control</li>
      </ul>
      <p>Para ejercer estos derechos, contactanos en <strong>privacy@bbq-experience.com</strong>.</p>

      <h2>9. Cookies</h2>
      <p>
        Este sitio web utiliza solo cookies esenciales necesarias para el funcionamiento del sitio. Una cookie
        de vista previa puede establecerse temporalmente con fines de revision editorial de contenido. No se
        utilizan cookies publicitarias de terceros. Puedes gestionar las cookies a traves de la configuracion
        de tu navegador.
      </p>

      <h2>10. Enlaces a Sitios Externos</h2>
      <p>
        Nuestro sitio web puede contener enlaces a sitios externos (ej. Instagram, sitios web de fabricantes).
        No somos responsables de las practicas de privacidad de estos sitios externos.
      </p>

      <h2>11. Cambios en esta Politica</h2>
      <p>
        Podemos actualizar esta Politica de Privacidad de vez en cuando. Cualquier cambio sera publicado
        en esta pagina con una fecha de revision actualizada.
      </p>

      <h2>12. Contactanos</h2>
      <p>
        Si tienes alguna pregunta sobre esta Politica de Privacidad, contactanos en:
        <strong>privacy@bbq-experience.com</strong>
      </p>
    </div>
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .legal-page { max-width: 800px; margin: 0 auto; }

  .legal-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .legal-updated {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-8);
  }

  .legal-content h2 {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-accent-fire);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .legal-content p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .legal-content ul {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .legal-content li { margin-bottom: var(--space-2); }
</style>
