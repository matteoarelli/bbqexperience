---
// Pagina Sobre Nosotros — historia del brand BBQ Experience (ES)
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = true;

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);
---

<BaseLayout
  title={`${t('nav.about')} - ${t('site.name')}`}
  description="Somos pitmasters hartos de leer resenas falsas. 20 anos de humo, pruebas reales, sin dinero de patrocinadores."
  locale={locale}
  canonicalPath={`/${localizedRoutes.about[locale]}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${localizedRoutes.about[locale]}/`} />

  <!-- Hero -->
  <section class="about-hero">
    <div class="container-bbq">
      <h1 class="about-hero__title">Sobre <span class="fire-text">BBQ Experience</span></h1>
      <p class="about-hero__subtitle">No somos una empresa de medios. Somos pitmasters hartos de leer resenas falsas.</p>
    </div>
  </section>

  <!-- Mission -->
  <section class="about-section">
    <div class="container-bbq">
      <div class="about-grid">
        <div>
          <h2 class="section-title">Por Que Lo Hacemos</h2>
          <p class="section-text">
            20 anos parados junto al fuego. Briskets quemados, costillas arruinadas y suficiente polvo de carbon
            en los pulmones para toda la vida. Creamos BBQ Experience porque cada resena que leiamos online estaba
            escrita por alguien que nunca habia sostenido unas pinzas. El dinero de los patrocinadores no influye
            en nuestras puntuaciones. Punto.
          </p>
          <p class="section-text">
            Cada producto se destruye antes de que le demos una puntuacion. Cocinamos con el, lo maltratamos,
            lo dejamos bajo la lluvia y lo llevamos mas alla de sus limites. Si sobrevive, se gana nuestro
            respeto. Si no, te decimos exactamente por que. Mas de 74K personas confian en nosotros porque
            nunca hemos falsificado una sola puntuacion.
          </p>
        </div>
        <div class="about-image-placeholder">
          <div class="placeholder-inner">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>Imagen Hero</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="about-stats">
    <div class="container-bbq">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-number">74K+</span>
          <span class="stat-label">Personas Que Confian</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">20+</span>
          <span class="stat-label">Anos en la Parrilla</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">100+</span>
          <span class="stat-label">Productos Destruidos</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">0</span>
          <span class="stat-label">Puntuaciones Patrocinadas</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="about-section">
    <div class="container-bbq">
      <h2 class="section-title">La Gente Detras del Humo</h2>
      <p class="section-text">
        No somos influencers. No somos creadores de contenido. Somos los que se levantan a las 4 de la manana
        para poner un brisket, los que discuten sobre especies de madera en la cena y los que han gastado mas
        dinero en termometros que la mayoria de la gente en vacaciones. Esto no es un trabajo — es una obsesion.
      </p>
      <p class="section-text">
        Nuestras resenas vienen de semanas de uso real — no de una tarde de unboxing. Nuestras recetas fallan
        diez veces antes de llegar al sitio. Y cuando decimos que un producto es bueno, queremos decir que lo
        comprariamos con nuestro propio dinero. Es el unico estandar que importa.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="container-bbq" style="text-align: center;">
      <h2 class="section-title">Ven a Hablar de BBQ</h2>
      <p class="section-text" style="max-width: 600px; margin: 0 auto var(--space-6);">
        Mas de 74K pitmasters ya nos siguen. Compartimos lo que estamos probando, lo que estamos cocinando y lo
        que deberias evitar. Sin relleno, solo fuego.
      </p>
      <a href="https://instagram.com/bbqexperience" target="_blank" rel="noopener noreferrer" class="cta-button">
        Seguir @bbqexperience
      </a>
    </div>
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .about-hero {
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .about-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .about-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .about-section { padding: var(--space-16) 0; }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 768px) {
    .about-grid { grid-template-columns: 1fr 1fr; }
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-accent-fire);
    margin-bottom: var(--space-4);
  }

  .section-text {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .about-image-placeholder {
    aspect-ratio: 4/3;
    background-color: var(--color-bg-secondary);
    border: 2px dashed var(--color-border-subtle);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .about-stats {
    padding: var(--space-16) 0;
    background-color: var(--color-bg-secondary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .stat-card {
    text-align: center;
    padding: var(--space-6);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .stat-number {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-accent-fire);
  }

  .stat-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }

  .about-cta {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .cta-button {
    display: inline-block;
    padding: var(--space-3) var(--space-8);
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast);
  }

  .cta-button:hover { background-color: var(--color-accent-ember); }
</style>
