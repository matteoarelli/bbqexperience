---
/**
 * Pagina landing per difficolta ricette (ES) — filtra recetas per livello di difficolta.
 * SSR para soportar paginacion y ordenamiento dinamicos via query param.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import RecipeCard from '@components/home/RecipeCard.astro';
import Pagination from '@components/common/Pagination.astro';
import SortControls from '@components/common/SortControls.astro';
import ContentStats from '@components/content/ContentStats.astro';
import { fetchCollection } from '@lib/strapi';
import type { StrapiRecipe } from '@lib/types';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = false;

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

// Livelli validi
const validLevels = ['easy', 'medium', 'hard', 'expert'] as const;
type ValidLevel = typeof validLevels[number];

const { level } = Astro.params;

// Validazione livello — 404 se non valido
if (!level || !validLevels.includes(level as ValidLevel)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const levelKey = level as ValidLevel;

// Paginazione e ordinamento da query params
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const activeSort = Astro.url.searchParams.get('sort') || 'newest';

// Mappa ordinamento -> campo Strapi
const sortMap: Record<string, string> = {
  newest: 'published_date:desc',
  quickest: 'total_time:asc',
  easiest: 'difficulty:asc',
};

const sortOptions = [
  { value: 'newest', label: t('sort.newest') },
  { value: 'quickest', label: t('sort.quickest') },
  { value: 'easiest', label: t('sort.easiest') },
];

// Recupera le ricette filtrate per difficolta
const fetchOptions: Parameters<typeof fetchCollection>[1] = {
  locale,
  populate: 'cover_image',
  sort: sortMap[activeSort] || sortMap.newest,
  pageSize: 12,
  page: currentPage,
  filters: { difficulty: { $eq: levelKey } },
};

let recipes: (StrapiRecipe & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
let totalCount = 0;
let totalPages = 1;
let fetchError = false;
try {
  const response = await fetchCollection<StrapiRecipe>('recipes', fetchOptions);
  recipes = response.data;
  totalCount = response.meta.pagination.total;
  totalPages = response.meta.pagination.pageCount;
} catch {
  fetchError = true;
}

const recipeRoute = localizedRoutes.recipes[locale];
const levelDisplayName = t(`content.${levelKey}`);
const pageTitle = t('content.difficultyPageTitle').replace('{level}', levelDisplayName);

// Statistiche per ContentStats
const statsItems = recipes.map((r) => ({
  difficulty: r.difficulty,
}));

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.recipes'), href: `/${locale}/${recipeRoute}/` },
  { label: levelDisplayName },
];
---

<BaseLayout
  title={`${pageTitle} | ${t('site.name')}`}
  description={`${pageTitle} — ${t('site.description')}`}
  locale={locale}
  canonicalPath={`/${locale}/${recipeRoute}/dificultad/${levelKey}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${recipeRoute}/dificultad/${levelKey}/`} />

  <section class="container-bbq py-12">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <h1 class="page-title">{pageTitle}</h1>

    {/* Barra statistiche */}
    {!fetchError && totalCount > 0 && (
      <ContentStats
        items={statsItems}
        type="recipes"
        totalCount={totalCount}
        locale={locale}
        translations={translations}
      />
    )}

    {/* Controlli ordinamento */}
    <SortControls
      currentSort={activeSort}
      options={sortOptions}
      baseUrl={Astro.url.href}
    />

    {/* Conteggio risultati */}
    {!fetchError && totalCount > 0 && (
      <p class="result-count">
        {t('common.showing')} {recipes.length} {t('common.of')} {totalCount} {t('common.results')}
      </p>
    )}

    {fetchError ? (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('common.contentUnavailable')}</p>
      </div>
    ) : recipes.length > 0 ? (
      <div class="recipe-grid" data-animate>
        {recipes.map((recipe) => (
          <RecipeCard
            recipe={recipe}
            locale={locale}
            recipesRoute={recipeRoute}
            translations={translations}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('content.noArticles')}</p>
      </div>
    )}

    {/* Paginazione */}
    {!fetchError && totalPages > 1 && (
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={Astro.url.href}
        translations={translations}
      />
    )}
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .result-count {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-6);
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .recipe-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .recipe-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-24) 0;
  }

  .empty-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
