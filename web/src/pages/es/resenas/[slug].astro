---
/**
 * Pagina recensione (ES) — Esperienza completa con scoring, editorial, specs, verdict
 * SSR per supportare la modalita anteprima con contenuti draft
 */
import { fetchBySlug } from '@lib/strapi';
import type { StrapiReview } from '@lib/types';
import { getStrapiMediaURL, getStrapiMediaAlt } from '@lib/media';
import { getContentStatus } from '@lib/preview';
import { loadTranslations, getTranslation } from '@lib/i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import AnimatedScoreCard from '@components/review/AnimatedScoreCard.svelte';
import SpecsTable from '@components/review/SpecsTable.astro';
import ProsConsCard from '@components/review/ProsConsCard.astro';
import VerdictCard from '@components/review/VerdictCard.astro';
import PhotoGallery from '@components/review/PhotoGallery.astro';
import ReviewJsonLd from '@components/review/ReviewJsonLd.astro';
import SocialShareBar from '@components/social/SocialShareBar.astro';
import BreadcrumbJsonLd from '@components/common/BreadcrumbJsonLd.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import LastUpdated from '@components/content/LastUpdated.astro';

export const prerender = false;

const locale = 'es';
const { slug } = Astro.params;
const status = getContentStatus(Astro.cookies);
const t = await loadTranslations(locale);

const review = await fetchBySlug<StrapiReview>('reviews', slug!, {
  locale,
  populate: '*',
  status,
});

if (!review) {
  return Astro.redirect(`/${locale}/`);
}

const coverImage = getStrapiMediaURL(review.gallery?.[0]);
const coverImageAlt = getStrapiMediaAlt(review.gallery?.[0]) || review.title;
const productImage = review.product?.images?.[0] ? getStrapiMediaURL(review.product.images[0]) : coverImage;
const siteUrl = import.meta.env.SITE || 'https://bbqexperience.com';
const pageUrl = new URL(Astro.url.pathname, Astro.site || 'https://bbqexperience.com').href;

// Breadcrumbs
const breadcrumbItems = [
  { label: getTranslation(t, 'content.home'), href: `/${locale}/` },
  { label: getTranslation(t, 'nav.reviews'), href: `/${locale}/resenas/` },
  { label: review.title },
];
---

<BaseLayout
  title={review.seo_title || review.title}
  description={review.seo_description || review.excerpt || ''}
  locale={locale}
  canonicalPath={`/${locale}/resenas/${review.slug}/`}
  ogImage={coverImage || ''}
>
  {Astro.locals.isPreview && (
    <div class="bg-amber-500 text-black text-center py-2 px-4 font-bold text-sm">
      MODO VISTA PREVIA — Este contenido no esta publicado
      <a href="/api/preview?action=exit" class="underline ml-4">Salir de vista previa</a>
    </div>
  )}

  <Header slot="header" locale={locale} translations={t} currentPath={Astro.url.pathname} />

  <article class="max-w-4xl mx-auto px-[var(--container-padding)] py-[var(--space-12)]">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <!-- Titolo e metadati -->
    <h1
      class="text-[var(--text-4xl)] uppercase tracking-tight mb-[var(--space-4)]"
      style="font-family: var(--font-heading); color: var(--color-text-primary);"
      data-animate
    >
      {review.title}
    </h1>

    <div class="flex flex-wrap gap-3 mb-[var(--space-4)]" style="color: var(--color-text-muted); font-size: var(--text-sm);">
      {review.published_date && (
        <span>{getTranslation(t, 'review.publishedOn')} {new Date(review.published_date).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      )}
      {review.product?.brand && (
        <span>| {review.product.brand}</span>
      )}
      {review.product?.category && (
        <span>| {review.product.category}</span>
      )}
    </div>

    {review.updatedAt && (
      <LastUpdated date={review.updatedAt} locale={locale} translations={t} />
    )}

    {review.excerpt && (
      <p
        class="text-[var(--text-lg)] mb-[var(--space-8)]"
        style="color: var(--color-text-secondary);"
        data-animate
      >
        {review.excerpt}
      </p>
    )}

    {coverImage && (
      <img
        src={coverImage}
        alt={coverImageAlt}
        class="w-full rounded-[var(--radius-lg)] mb-[var(--space-12)]"
        data-animate
      />
    )}

    <!-- Galleria foto -->
    {review.gallery && review.gallery.length > 1 && (
      <div class="mb-[var(--space-12)]">
        <PhotoGallery images={review.gallery} title={getTranslation(t, 'review.gallery')} />
      </div>
    )}

    <!-- Punteggi -->
    <div class="mb-[var(--space-12)]">
      <AnimatedScoreCard
        client:visible
        overall={review.score_overall}
        buildQuality={review.score_build_quality}
        performance={review.score_performance}
        value={review.score_value}
        easeOfUse={review.score_ease_of_use}
        labels={{
          overall: getTranslation(t, 'review.overallScore'),
          buildQuality: getTranslation(t, 'review.buildQuality'),
          performance: getTranslation(t, 'review.performance'),
          value: getTranslation(t, 'review.value'),
          easeOfUse: getTranslation(t, 'review.easeOfUse'),
        }}
      />
    </div>

    <!-- Contenuto editoriale -->
    {review.editorial_content && (
      <div
        class="prose prose-invert prose-lg max-w-none mb-[var(--space-12)]"
        set:html={review.editorial_content}
        data-animate
      />
    )}

    <!-- Specifiche tecniche -->
    <div class="mb-[var(--space-12)]">
      <SpecsTable
        specifications={review.product?.specifications || null}
        title={getTranslation(t, 'review.specs')}
      />
    </div>

    <!-- Pro e Contro -->
    <div class="mb-[var(--space-12)]">
      <ProsConsCard
        pros={review.pros}
        cons={review.cons}
        translations={t}
      />
    </div>

    <!-- Verdetto finale -->
    <div class="mb-[var(--space-12)]">
      <VerdictCard
        overall={review.score_overall}
        verdict={review.verdict}
        pros={review.pros}
        cons={review.cons}
        productName={review.product?.name || review.title}
        productImage={productImage}
        productImageAlt={coverImageAlt}
        translations={t}
      />
    </div>

    <!-- Pulsante affiliato -->
    {review.product?.affiliate_url && (
      <div class="mb-[var(--space-12)] text-center">
        <a
          href={review.product.affiliate_url}
          target="_blank"
          rel="noopener noreferrer nofollow sponsored"
          class="affiliate-btn"
        >
          {getTranslation(t, 'review.checkPrice')}
        </a>
        <p class="affiliate-disclaimer">{getTranslation(t, 'review.affiliateDisclaimer')}</p>
      </div>
    )}

    <!-- Condivisione social -->
    <div style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border-subtle);">
      <SocialShareBar url={pageUrl} title={review.title} locale={locale} translations={t} />
    </div>
  </article>

  <Footer slot="footer" locale={locale} translations={t} />

  <ReviewJsonLd
    review={review}
    productImageUrl={productImage}
    locale={locale}
    siteUrl={siteUrl}
  />
  <BreadcrumbJsonLd items={breadcrumbItems} />
</BaseLayout>

<style>
  .affiliate-btn {
    display: inline-block;
    background-color: var(--color-accent-fire);
    color: white;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: background-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
    box-shadow: 0 4px 14px rgba(249, 115, 22, 0.4);
  }
  .affiliate-btn:hover {
    background-color: var(--color-accent-amber);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(249, 115, 22, 0.5);
  }
  .affiliate-disclaimer {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    margin-top: var(--space-2);
  }
</style>

<script>
  import { initScrollAnimations } from '@lib/animations';
  document.addEventListener('DOMContentLoaded', initScrollAnimations);
</script>
