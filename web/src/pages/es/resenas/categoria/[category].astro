---
/**
 * Redirect 301 dalle vecchie route /es/resenas/categoria/[category] al nuovo sistema
 * filtri query-param /es/resenas/?category=[category].
 * Preserva il valore SEO dei link indicizzati da Google.
 */
export const prerender = false;

const { category } = Astro.params;
return Astro.redirect(`/es/resenas/?category=${category}`, 301);
---
