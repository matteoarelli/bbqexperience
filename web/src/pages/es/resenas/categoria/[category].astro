---
/**
 * Pagina landing per categoria recensioni (ES) — filtra resenas per tipo prodotto.
 * SSR para soportar paginacion y ordenamiento dinamicos via query param.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import ReviewCard from '@components/home/ReviewCard.astro';
import Pagination from '@components/common/Pagination.astro';
import SortControls from '@components/common/SortControls.astro';
import PopularReviews from '@components/content/PopularReviews.astro';
import ContentStats from '@components/content/ContentStats.astro';
import { fetchCollection } from '@lib/strapi';
import type { StrapiReview } from '@lib/types';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = false;

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

// Categorie valide
const validCategories = ['grill', 'smoker', 'accessory', 'fuel', 'thermometer'] as const;
type ValidCategory = typeof validCategories[number];

const { category } = Astro.params;

// Validazione categoria — 404 se non valida
if (!category || !validCategories.includes(category as ValidCategory)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const categoryKey = category as ValidCategory;

// Paginazione e ordinamento da query params
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const activeSort = Astro.url.searchParams.get('sort') || 'newest';

// Mappa ordinamento -> campo Strapi
const sortMap: Record<string, string> = {
  newest: 'published_date:desc',
  highestScore: 'score_overall:desc',
  lowestScore: 'score_overall:asc',
};

const sortOptions = [
  { value: 'newest', label: t('sort.newest') },
  { value: 'highestScore', label: t('sort.highestScore') },
  { value: 'lowestScore', label: t('sort.lowestScore') },
];

// Recupera le recensioni filtrate per categoria
const fetchOptions: Parameters<typeof fetchCollection>[1] = {
  locale,
  populate: 'gallery,product',
  sort: sortMap[activeSort] || sortMap.newest,
  pageSize: 12,
  page: currentPage,
  filters: { product: { category: { $eq: categoryKey } } },
};

let reviews: (StrapiReview & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
let totalCount = 0;
let totalPages = 1;
let fetchError = false;
try {
  const response = await fetchCollection<StrapiReview>('reviews', fetchOptions);
  reviews = response.data;
  totalCount = response.meta.pagination.total;
  totalPages = response.meta.pagination.pageCount;
} catch {
  fetchError = true;
}

const reviewRoute = localizedRoutes.reviews[locale];
const categoryDisplayName = t(`content.${categoryKey}`);
const pageTitle = t('content.categoryPageTitle').replace('{category}', categoryDisplayName);

// Statistiche per ContentStats
const statsItems = reviews.map((r) => ({
  score: r.score_overall,
}));

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.reviews'), href: `/${locale}/${reviewRoute}/` },
  { label: categoryDisplayName },
];
---

<BaseLayout
  title={`${pageTitle} | ${t('site.name')}`}
  description={`${pageTitle} — ${t('site.description')}`}
  locale={locale}
  canonicalPath={`/${reviewRoute}/categoria/${categoryKey}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${reviewRoute}/categoria/${categoryKey}/`} />

  <section class="container-bbq py-12">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <h1 class="page-title">{pageTitle}</h1>

    {/* Barra statistiche */}
    {!fetchError && totalCount > 0 && (
      <ContentStats
        items={statsItems}
        type="reviews"
        totalCount={totalCount}
        locale={locale}
        translations={translations}
      />
    )}

    {/* Controlli ordinamento */}
    <SortControls
      currentSort={activeSort}
      options={sortOptions}
      baseUrl={Astro.url.href}
    />

    {/* Conteggio risultati */}
    {!fetchError && totalCount > 0 && (
      <p class="result-count">
        {t('common.showing')} {reviews.length} {t('common.of')} {totalCount} {t('common.results')}
      </p>
    )}

    <div class="listing-layout">
      <div class="listing-main">
        {fetchError ? (
          <div class="empty-state" data-animate>
            <p class="empty-text">{t('common.contentUnavailable')}</p>
          </div>
        ) : reviews.length > 0 ? (
          <div class="review-grid" data-animate>
            {reviews.map((review) => (
              <ReviewCard
                review={review}
                locale={locale}
                reviewsRoute={reviewRoute}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state" data-animate>
            <p class="empty-text">{t('content.noArticles')}</p>
          </div>
        )}

        {/* Paginazione */}
        {!fetchError && totalPages > 1 && (
          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl={Astro.url.href}
            translations={translations}
          />
        )}
      </div>

      <aside class="listing-sidebar">
        <PopularReviews locale={locale} translations={translations} />
      </aside>
    </div>
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .result-count {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-6);
  }

  .review-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .review-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .review-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .listing-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .listing-main {
    flex: 1;
    min-width: 0;
  }

  .listing-sidebar {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .listing-layout {
      flex-direction: row;
    }

    .listing-sidebar {
      width: 300px;
      flex-shrink: 0;
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-24) 0;
  }

  .empty-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
