---
/**
 * Pagina listing blog (ES) — griglia di articulos blog con filtro categoria y post destacados
 * SSR para soportar filtro categoria dinamico via query param.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import ArticleCard from '@components/content/ArticleCard.astro';
import { fetchCollection } from '@lib/strapi';
import type { StrapiBlogPost } from '@lib/types';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = false;

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

// Categorie disponibili per il blog
const categories = ['news', 'events', 'trends', 'tips', 'culture'] as const;
const activeCategory = Astro.url.searchParams.get('category') || null;

// Recupera i blog post con filtro categoria opzionale
const fetchOptions: Parameters<typeof fetchCollection>[1] = {
  locale,
  populate: 'cover_image',
  sort: 'published_date:desc',
  pageSize: 25,
};

if (activeCategory && categories.includes(activeCategory as typeof categories[number])) {
  fetchOptions.filters = { category: { $eq: activeCategory } };
}

let posts: (StrapiBlogPost & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
let fetchError = false;
try {
  const response = await fetchCollection<StrapiBlogPost>('blog-posts', fetchOptions);
  posts = response.data;
} catch {
  fetchError = true;
}
const blogRoute = localizedRoutes.blog[locale];

// Separa post in evidenza dai normali (solo se non c'e filtro attivo)
const featuredPosts = activeCategory ? [] : posts.filter((p) => p.featured);
const regularPosts = activeCategory ? posts : posts.filter((p) => !p.featured);

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.blog') },
];
---

<BaseLayout
  title={`${t('content.blog')} - ${t('site.name')}`}
  description={t('site.description')}
  locale={locale}
  canonicalPath={`/${locale}/${blogRoute}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${blogRoute}/`} />

  <section class="container-bbq py-12">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <h1 class="page-title">{t('content.allPosts')}</h1>

    <div class="category-filter">
      <a
        href={`/${locale}/${blogRoute}/`}
        class:list={['filter-btn', { 'filter-btn--active': !activeCategory }]}
      >
        {t('content.allCategories')}
      </a>
      {categories.map((cat) => (
        <a
          href={`/${locale}/${blogRoute}/?category=${cat}`}
          class:list={['filter-btn', { 'filter-btn--active': activeCategory === cat }]}
        >
          {t(`content.${cat}`)}
        </a>
      ))}
    </div>

    {fetchError ? (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('common.contentUnavailable')}</p>
      </div>
    ) : (
    <Fragment>
    {featuredPosts.length > 0 && (
      <div class="featured-section" data-animate>
        <div class="featured-grid">
          {featuredPosts.map((post) => (
            <ArticleCard
              title={post.title}
              excerpt={post.excerpt}
              slug={post.slug}
              href={`/${locale}/${blogRoute}/${post.slug}/`}
              coverImage={post.cover_image}
              category={post.category}
              readingTime={post.reading_time}
              publishedDate={post.published_date}
              locale={locale}
              translations={translations}
            />
          ))}
        </div>
      </div>
    )}

    {regularPosts.length > 0 ? (
      <div class="blog-grid" data-animate>
        {regularPosts.map((post) => (
          <ArticleCard
            title={post.title}
            excerpt={post.excerpt}
            slug={post.slug}
            href={`/${locale}/${blogRoute}/${post.slug}/`}
            coverImage={post.cover_image}
            category={post.category}
            readingTime={post.reading_time}
            publishedDate={post.published_date}
            locale={locale}
            translations={translations}
          />
        ))}
      </div>
    ) : featuredPosts.length === 0 && (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('content.noArticles')}</p>
      </div>
    )}
    </Fragment>
    )}
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .filter-btn {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    background-color: transparent;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-secondary);
  }

  .filter-btn--active {
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    border-color: var(--color-accent-fire);
  }

  .filter-btn--active:hover {
    background-color: var(--color-accent-ember);
    border-color: var(--color-accent-ember);
    color: var(--color-text-inverse);
  }

  .featured-section {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .featured-grid :global(:first-child) {
      grid-column: 1 / -1;
    }
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-24) 0;
  }

  .empty-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
