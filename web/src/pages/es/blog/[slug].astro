---
/**
 * Pagina dettaglio blog post (ES) — articulo completo con breadcrumbs y metadata
 * SSR para soportar modo preview con contenido draft.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import ContentLayout from '@components/content/ContentLayout.astro';
import ArticleSchema from '@components/content/ArticleSchema.astro';
import RelatedContent from '@components/content/RelatedContent.astro';
import SocialShareBar from '@components/social/SocialShareBar.astro';
import BookmarkButton from '@components/common/BookmarkButton.svelte';
import AuthorCard from '@components/content/AuthorCard.astro';
import BreadcrumbJsonLd from '@components/common/BreadcrumbJsonLd.astro';
import PopularReviews from '@components/content/PopularReviews.astro';
import { fetchBySlug } from '@lib/strapi';
import type { StrapiBlogPost } from '@lib/types';
import { getContentStatus } from '@lib/preview';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';
import { getStrapiMediaURL } from '@lib/media';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';

export const prerender = false;

const locale: Locale = 'es';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

const { slug } = Astro.params;
const status = getContentStatus(Astro.cookies);

const post = await fetchBySlug<StrapiBlogPost>('blog-posts', slug!, {
  locale,
  populate: 'cover_image',
  status,
});

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const blogRoute = localizedRoutes.blog[locale];
const seoTitle = post.seo_title || post.title;
const seoDescription = post.seo_description || post.excerpt || '';
const canonicalUrl = `https://bbq-experience.com/${locale}/${blogRoute}/${post.slug}/`;
// LCP preload: versione trasformata via Cloudflare (width 1280 combacia con cover in ContentLayout).
// Threat T-10.1-09 mitigato (no double-fetch).
const coverImageUrl = getStrapiMediaURL(post.cover_image, { width: 1280, quality: 75 });
// og:image e JSON-LD: URL raw Strapi per scrapers social + bot Google.
// Threat T-10.1-06 (social scrapers non seguono /cdn-cgi/image/ in modo affidabile).
const ogImageRawUrl = getStrapiMediaURL(post.cover_image, { raw: true });
const coverImageRawUrl = getStrapiMediaURL(post.cover_image, { raw: true });
const pageUrl = new URL(Astro.url.pathname, Astro.site || 'https://bbq-experience.com').href;

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.blog'), href: `/${locale}/${blogRoute}/` },
  { label: post.title },
];
---

<BaseLayout
  title={`${seoTitle} - ${t('site.name')}`}
  description={seoDescription}
  locale={locale}
  canonicalPath={`/${blogRoute}/${post.slug}/`}
  type="article"
  publishedTime={post.published_date || ''}
  modifiedTime={post.updatedAt || ''}
  ogImage={ogImageRawUrl || ''}
  preloadImage={coverImageUrl || ''}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${blogRoute}/${post.slug}/`} />

  <ArticleSchema
    title={seoTitle}
    description={seoDescription}
    url={canonicalUrl}
    datePublished={post.published_date}
    dateModified={post.updatedAt}
    imageUrl={coverImageRawUrl}
    locale={locale}
  />

  {Astro.locals.isPreview && (
    <div class="preview-banner">
      MODO PREVIEW — Este contenido no esta publicado
      <a href="/api/preview?action=exit" class="preview-exit">Salir del preview</a>
    </div>
  )}

  <div data-pagefind-body>
    <ContentLayout
      title={post.title}
      content={post.content}
      coverImage={post.cover_image}
      readingTime={post.reading_time}
      publishedDate={post.published_date}
      updatedAt={post.updatedAt}
      category={post.category}
      locale={locale}
      translations={translations}
    >
      <Breadcrumbs slot="breadcrumbs" items={breadcrumbItems} locale={locale} />

      <RelatedContent slot="related" locale={locale} translations={translations} currentSlug={post.slug} currentType="blog-post" />
    </ContentLayout>
  </div>

  <div class="max-w-4xl mx-auto px-[var(--container-padding)]">
    <AuthorCard locale={locale} translations={translations} />
  </div>

  <div class="max-w-4xl mx-auto px-[var(--container-padding)]" style="margin-top: var(--space-8);">
    <PopularReviews locale={locale} translations={translations} />
  </div>

  <div class="max-w-4xl mx-auto px-[var(--container-padding)]" style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border-subtle);">
    <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
      <SocialShareBar url={pageUrl} title={post.title} locale={locale} translations={translations} />
      <BookmarkButton client:load slug={post.slug} title={post.title} contentType="blog" locale={locale} labelSave={getTranslation(translations, 'bookmarks.save')} labelRemove={getTranslation(translations, 'bookmarks.remove')} />
    </div>
  </div>

  <BreadcrumbJsonLd items={breadcrumbItems} />

  <div class="max-w-4xl mx-auto px-[var(--container-padding)]" style="margin-top: var(--space-8);">
    <NewsletterSignup translations={translations} source="inline" />
  </div>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .preview-banner {
    background-color: #f59e0b;
    color: #000;
    text-align: center;
    padding: var(--space-2) var(--space-4);
    font-weight: 700;
    font-size: var(--text-sm);
  }

  .preview-exit {
    color: #000;
    text-decoration: underline;
    margin-left: var(--space-4);
  }
</style>
