---
// Rileva la lingua preferita dal browser e redirect alla locale corretta
export const prerender = false;

const acceptLang = Astro.request.headers.get('accept-language') || '';
let locale = 'en';
if (acceptLang.startsWith('it') || acceptLang.includes('it-')) locale = 'it';
else if (acceptLang.startsWith('es') || acceptLang.includes('es-')) locale = 'es';
return Astro.redirect(`/${locale}/`, 302);
