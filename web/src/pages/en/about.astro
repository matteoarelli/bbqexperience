---
// Pagina About — storia del brand BBQ Experience (EN)
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import OrganizationJsonLd from '@components/common/OrganizationJsonLd.astro';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = true;

const locale: Locale = 'en';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);
---

<BaseLayout
  title={`${t('nav.about')} - ${t('site.name')}`}
  description="We're pitmasters who got tired of reading fake reviews. 20 years of smoke, real tests, no sponsor money."
  locale={locale}
  canonicalPath={`/${localizedRoutes.about[locale]}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${localizedRoutes.about[locale]}/`} />

  <OrganizationJsonLd
    locale={locale}
    pageType="AboutPage"
    pageUrl={`https://bbq-experience.com/${locale}/${localizedRoutes.about[locale]}/`}
    pageName={`${t('nav.about')} — ${t('site.name')}`}
    description="We're pitmasters who got tired of reading fake reviews. 20 years of smoke, real tests, no sponsor money."
  />

  <!-- Hero -->
  <section class="about-hero">
    <div class="container-bbq">
      <h1 class="about-hero__title">About <span class="fire-text">BBQ Experience</span></h1>
      <p class="about-hero__subtitle">We're not a media company. We're pitmasters who got tired of reading fake reviews.</p>
    </div>
  </section>

  <!-- Mission -->
  <section class="about-section">
    <div class="container-bbq">
      <div class="about-grid">
        <div>
          <h2 class="section-title">Why We Do This</h2>
          <p class="section-text">
            20 years of standing next to fire. Burned briskets, ruined ribs, and enough charcoal dust in our lungs
            to last a lifetime. We started BBQ Experience because every review we read online was written by
            someone who'd never held a pair of tongs. No sponsor money influences our scores. Period.
          </p>
          <p class="section-text">
            Every product gets destroyed before we rate it. We cook on it, abuse it, leave it in the rain, and push
            it past its limits. If it survives, it earns our respect. If it doesn't, we tell you exactly why.
            74K+ people trust us because we've never faked a single score.
          </p>
        </div>
        <div class="about-image-placeholder">
          <div class="placeholder-inner">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>Hero Image</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="about-stats">
    <div class="container-bbq">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-number">74K+</span>
          <span class="stat-label">People Who Trust Us</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">20+</span>
          <span class="stat-label">Years at the Grill</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">100+</span>
          <span class="stat-label">Products Destroyed</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">0</span>
          <span class="stat-label">Sponsored Scores</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Founder -->
  <section class="about-section">
    <div class="container-bbq">
      <h2 class="section-title">The People Behind the Smoke</h2>
      <p class="section-text">
        We're not influencers. We're not content creators. We're the people who wake up at 4 AM to put a
        brisket on, who argue about wood species at dinner, and who've spent more money on thermometers than
        most people spend on vacations. This isn't a job — it's an obsession.
      </p>
      <p class="section-text">
        Our reviews come from weeks of real use — not a single afternoon unboxing. Our recipes fail ten times
        before they make it to the site. And when we say a product is good, we mean we'd buy it with our own money.
        That's the only standard that matters.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="about-cta">
    <div class="container-bbq" style="text-align: center;">
      <h2 class="section-title">Come Talk BBQ</h2>
      <p class="section-text" style="max-width: 600px; margin: 0 auto var(--space-6);">
        74K+ pitmasters already follow us. We share what we're testing, what we're cooking, and what we think
        you should avoid. No fluff, just fire.
      </p>
      <a href="https://instagram.com/bbqexperience" target="_blank" rel="noopener noreferrer" class="cta-button">
        Follow @bbqexperience
      </a>
    </div>
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .about-hero {
    padding: var(--space-24) 0 var(--space-16);
    text-align: center;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .about-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .about-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .about-section {
    padding: var(--space-16) 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 768px) {
    .about-grid { grid-template-columns: 1fr 1fr; }
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-accent-fire);
    margin-bottom: var(--space-4);
  }

  .section-text {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .about-image-placeholder {
    aspect-ratio: 4/3;
    background-color: var(--color-bg-secondary);
    border: 2px dashed var(--color-border-subtle);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .about-stats {
    padding: var(--space-16) 0;
    background-color: var(--color-bg-secondary);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .stat-card {
    text-align: center;
    padding: var(--space-6);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .stat-number {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    color: var(--color-accent-fire);
  }

  .stat-label {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }

  .about-cta {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .cta-button {
    display: inline-block;
    padding: var(--space-3) var(--space-8);
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: background-color var(--transition-fast);
  }

  .cta-button:hover {
    background-color: var(--color-accent-ember);
  }
</style>
