---
// Pagina Contact — BBQ Experience (EN)
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = true;

const locale: Locale = 'en';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);
---

<BaseLayout
  title={`${t('nav.contact')} - ${t('site.name')}`}
  description="Got something to say? We read everything. Don't pitch us products — we'll find them ourselves."
  locale={locale}
  canonicalPath={`/${localizedRoutes.contact[locale]}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${localizedRoutes.contact[locale]}/`} />

  <section class="contact-page container-bbq py-16">
    <h1 class="contact-title">Got Something to <span class="text-fire">Say?</span></h1>
    <p class="contact-subtitle">
      We read everything. Don't pitch us products — we'll find them ourselves. Want to talk BBQ? That's different. Fire away.
    </p>

    <div class="contact-grid">
      <!-- Canali di contatto -->
      <div class="contact-channels">
        <div class="contact-card">
          <div class="contact-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
          <h3 class="contact-card__title">Instagram</h3>
          <p class="contact-card__text">Fastest way to reach us. DMs open. No PR agencies, please.</p>
          <a href="https://instagram.com/bbqexperience" target="_blank" rel="noopener noreferrer" class="contact-card__link">
            @bbqexperience
          </a>
        </div>

        <div class="contact-card">
          <div class="contact-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h3 class="contact-card__title">Email</h3>
          <p class="contact-card__text">For serious inquiries only. We don't do paid reviews.</p>
          <a href="mailto:info@bbq-experience.com" class="contact-card__link">
            info@bbq-experience.com
          </a>
        </div>
      </div>

      <!-- Form placeholder -->
      <div class="contact-form-placeholder">
        <h3 class="form-title">Send Us a Message</h3>
        <form class="contact-form" onsubmit="return false;">
          <div class="form-group">
            <label for="name" class="form-label">Name</label>
            <input type="text" id="name" class="form-input" placeholder="Your name" disabled />
          </div>
          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" class="form-input" placeholder="your@email.com" disabled />
          </div>
          <div class="form-group">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" class="form-input form-textarea" placeholder="Your message..." disabled></textarea>
          </div>
          <button type="submit" class="form-button" disabled>
            Coming Soon
          </button>
          <p class="form-note">Contact form coming soon. In the meantime, reach us via Instagram or email.</p>
        </form>
      </div>
    </div>
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .contact-page { max-width: 900px; margin: 0 auto; }

  .contact-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .text-fire { color: var(--color-accent-fire); }

  .contact-subtitle {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    margin-bottom: var(--space-12);
    max-width: 500px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  @media (min-width: 768px) {
    .contact-grid { grid-template-columns: 1fr 1fr; }
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-card {
    padding: var(--space-6);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .contact-card__icon {
    color: var(--color-accent-fire);
    margin-bottom: var(--space-3);
  }

  .contact-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .contact-card__text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  .contact-card__link {
    color: var(--color-accent-fire);
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast);
  }

  .contact-card__link:hover { color: var(--color-accent-ember); }

  .contact-form-placeholder {
    padding: var(--space-6);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .form-title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .form-group { margin-bottom: var(--space-4); }

  .form-label {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .form-input {
    width: 100%;
    padding: var(--space-3);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    opacity: 0.5;
  }

  .form-textarea {
    min-height: 120px;
    resize: vertical;
  }

  .form-button {
    width: 100%;
    padding: var(--space-3);
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    cursor: not-allowed;
  }

  .form-note {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-align: center;
    margin-top: var(--space-3);
  }
</style>
