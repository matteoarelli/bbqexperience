---
/**
 * Pagina recensione (EN) — Esperienza completa con scoring, editorial, specs, verdict
 * SSR per supportare la modalita anteprima con contenuti draft
 */
import { fetchBySlug } from '@lib/strapi';
import type { StrapiReview } from '@lib/types';
import { getStrapiMediaURL, getStrapiMediaAlt, buildStrapiSrcset } from '@lib/media';
import { getContentStatus } from '@lib/preview';
import { loadTranslations, getTranslation } from '@lib/i18n';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import AnimatedScoreCard from '@components/review/AnimatedScoreCard.svelte';
import SpecsTable from '@components/review/SpecsTable.astro';
import ProsConsCard from '@components/review/ProsConsCard.astro';
import VerdictCard from '@components/review/VerdictCard.astro';
import PhotoGallery from '@components/review/PhotoGallery.astro';
import ReviewJsonLd from '@components/review/ReviewJsonLd.astro';
import SocialShareBar from '@components/social/SocialShareBar.astro';
import BookmarkButton from '@components/common/BookmarkButton.svelte';
import AuthorCard from '@components/content/AuthorCard.astro';
import BreadcrumbJsonLd from '@components/common/BreadcrumbJsonLd.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import LastUpdated from '@components/content/LastUpdated.astro';
import TopPickBadge from '@components/review/TopPickBadge.astro';
import PrevNextNav from '@components/content/PrevNextNav.astro';
import WhereToBuy from '@components/review/WhereToBuy.astro';
import { localizedRoutes } from '@lib/i18n';
import { renderMarkdown } from '@lib/markdown';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';

export const prerender = false;

const locale = 'en';
const { slug } = Astro.params;
const status = getContentStatus(Astro.cookies);
const t = await loadTranslations(locale);

const review = await fetchBySlug<StrapiReview>('reviews', slug!, {
  locale,
  populate: '*',
  status,
});

if (!review) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Calcolo tempo di lettura dal contenuto editoriale
const wordCount = review.editorial_content ? review.editorial_content.replace(/<[^>]+>/g, '').split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Cover review: width 1280 per LCP desktop-first, srcset copre mobile -> retina.
// productImage resta raw (usato da VerdictCard e Review JSON-LD a dimensione originale).
const coverImage = getStrapiMediaURL(review.gallery?.[0], { width: 1280, quality: 75 });
const coverImageSrcset = buildStrapiSrcset(review.gallery?.[0], [640, 960, 1280, 1600]);
const coverImageAlt = getStrapiMediaAlt(review.gallery?.[0]) || review.title;
const productImage = review.product?.images?.[0] ? getStrapiMediaURL(review.product.images[0]) : coverImage;
const siteUrl = import.meta.env.SITE || 'https://bbq-experience.com';
const pageUrl = new URL(Astro.url.pathname, Astro.site || 'https://bbq-experience.com').href;

// Breadcrumbs
const breadcrumbItems = [
  { label: getTranslation(t, 'content.home'), href: `/${locale}/` },
  { label: getTranslation(t, 'nav.reviews'), href: `/${locale}/reviews/` },
  { label: review.title },
];
---

<BaseLayout
  title={review.seo_title || review.title}
  description={review.seo_description || review.excerpt || ''}
  locale={locale}
  canonicalPath={`/reviews/${review.slug}/`}
  type="article"
  publishedTime={review.published_date || ''}
  modifiedTime={review.updatedAt || ''}
  ogImage={`/api/og-image?title=${encodeURIComponent(review.title)}&score=${review.score_overall}&verdict=${encodeURIComponent(review.verdict || '')}&locale=${locale}`}
  preloadImage={coverImage || ''}
>
  {Astro.locals.isPreview && (
    <div class="bg-amber-500 text-black text-center py-2 px-4 font-bold text-sm">
      PREVIEW MODE — This content is not published
      <a href="/api/preview?action=exit" class="underline ml-4">Exit Preview</a>
    </div>
  )}

  <Header slot="header" locale={locale} translations={t} currentPath={Astro.url.pathname} />

  <article class="max-w-4xl mx-auto px-[var(--container-padding)] py-[var(--space-12)]">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <!-- Titolo e metadati -->
    <div class="flex items-start gap-3 mb-[var(--space-4)]">
      <h1
        class="text-[var(--text-4xl)] uppercase tracking-tight"
        style="font-family: var(--font-heading); color: var(--color-text-primary); margin: 0;"
      >
        {review.title}
      </h1>
      <TopPickBadge score={review.score_overall} label={getTranslation(t, 'review.topPick')} />
    </div>

    <div class="flex flex-wrap gap-3 mb-[var(--space-4)]" style="color: var(--color-text-muted); font-size: var(--text-sm);">
      {review.published_date && (
        <span>{getTranslation(t, 'review.publishedOn')} {new Date(review.published_date).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      )}
      {review.product?.brand_relation?.name && (
        <span>| {review.product.brand_relation.name}</span>
      )}
      {review.product?.category && (
        <span>| {review.product.category}</span>
      )}
      {readingTime && (
        <span>| {getTranslation(t, 'content.minRead').replace('{time}', String(readingTime))}</span>
      )}
    </div>

    {review.updatedAt && (
      <LastUpdated date={review.updatedAt} locale={locale} translations={t} />
    )}

    {review.excerpt && (
      <p
        class="text-[var(--text-lg)] mb-[var(--space-8)]"
        style="color: var(--color-text-secondary);"

      >
        {review.excerpt}
      </p>
    )}

    {coverImage && (
      // LCP hint: cover review è l'immagine principale above-the-fold
      <img
        src={coverImage}
        srcset={coverImageSrcset}
        sizes="(max-width: 768px) 100vw, 1280px"
        alt={coverImageAlt}
        class="w-full rounded-[var(--radius-lg)] mb-[var(--space-12)]"
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    )}

    <!-- Galleria foto -->
    {review.gallery && review.gallery.length > 1 && (
      <div class="mb-[var(--space-12)]">
        <PhotoGallery images={review.gallery} title={getTranslation(t, 'review.gallery')} />
      </div>
    )}

    <!-- Punteggi -->
    <div class="mb-[var(--space-12)]">
      <AnimatedScoreCard
        client:visible
        overall={review.score_overall}
        buildQuality={review.score_build_quality}
        performance={review.score_performance}
        value={review.score_value}
        easeOfUse={review.score_ease_of_use}
        labels={{
          overall: getTranslation(t, 'review.overallScore'),
          buildQuality: getTranslation(t, 'review.buildQuality'),
          performance: getTranslation(t, 'review.performance'),
          value: getTranslation(t, 'review.value'),
          easeOfUse: getTranslation(t, 'review.easeOfUse'),
        }}
      />
    </div>

    <!-- Contenuto editoriale -->
    {review.editorial_content && (
      <div
        class="prose prose-invert prose-lg max-w-none mb-[var(--space-12)]"
        set:html={renderMarkdown(review.editorial_content)}

      />
    )}

    <!-- Specifiche tecniche -->
    <div class="mb-[var(--space-12)]">
      <SpecsTable
        specifications={review.product?.specifications || null}
        title={getTranslation(t, 'review.specs')}
      />
    </div>

    <!-- Pro e Contro -->
    <div class="mb-[var(--space-12)]">
      <ProsConsCard
        pros={review.pros}
        cons={review.cons}
        translations={t}
      />
    </div>

    <!-- Verdetto finale -->
    <div class="mb-[var(--space-12)]">
      <VerdictCard
        overall={review.score_overall}
        verdict={review.verdict}
        pros={review.pros}
        cons={review.cons}
        productName={review.product?.name || review.title}
        productImage={productImage}
        productImageAlt={coverImageAlt}
        translations={t}
      />
    </div>

    <!-- Dove comprare -->
    <WhereToBuy
      productName={review.product?.name || review.title}
      affiliateUrl={review.product?.affiliate_url || null}
      affiliateLinks={review.product?.affiliate_links || null}
      translations={t}
    />

    <!-- Card autore -->
    <AuthorCard locale={locale} translations={t} />

    <!-- CTA confronta prodotto -->
    <div class="compare-cta">
      <a href={`/${locale}/${localizedRoutes.compare[locale]}/?ids=${review.product?.documentId || ''}`} class="compare-cta__link">
        {getTranslation(t, 'content.compareProduct')} &rarr;
      </a>
    </div>

    <!-- Condivisione social e bookmark -->
    <div style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border-subtle); display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
      <SocialShareBar url={pageUrl} title={review.title} locale={locale} translations={t} />
      <BookmarkButton client:load slug={review.slug} title={review.title} contentType="review" locale={locale} labelSave={getTranslation(t, 'bookmarks.save')} labelRemove={getTranslation(t, 'bookmarks.remove')} />
    </div>

    <!-- Navigazione precedente/successivo -->
    <PrevNextNav contentType="reviews" currentSlug={review.slug} locale={locale} translations={t} />
  </article>

  <div class="max-w-4xl mx-auto px-[var(--container-padding)]" style="margin-top: var(--space-8);">
    <NewsletterSignup translations={t} source="inline" />
  </div>

  <Footer slot="footer" locale={locale} translations={t} />

  <ReviewJsonLd
    review={review}
    productImageUrl={productImage}
    locale={locale}
    siteUrl={siteUrl}
  />
  <BreadcrumbJsonLd items={breadcrumbItems} />
</BaseLayout>

<style>
  .compare-cta {
    margin-bottom: var(--space-8);
    text-align: center;
  }
  .compare-cta__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent-fire);
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--color-accent-fire);
    border-radius: var(--radius-lg);
    transition: background-color var(--transition-base), color var(--transition-base);
  }
  .compare-cta__link:hover {
    background-color: var(--color-accent-fire);
    color: white;
  }
</style>

<script>
  import { initScrollAnimations } from '@lib/animations';
  document.addEventListener('DOMContentLoaded', initScrollAnimations);
</script>
