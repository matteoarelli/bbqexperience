---
/**
 * Redirect 301 dalle vecchie route /en/reviews/category/[category] al nuovo sistema
 * filtri query-param /en/reviews/?category=[category].
 * Preserva il valore SEO dei link indicizzati da Google.
 */
export const prerender = false;

const { category } = Astro.params;
return Astro.redirect(`/en/reviews/?category=${category}`, 301);
---
