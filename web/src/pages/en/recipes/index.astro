---
/**
 * Pagina listing ricette (EN) — griglia di ricette con filtro difficolta, ordinamento e paginazione.
 * SSR per supportare filtro difficolta, sort e paginazione dinamici via query param.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import Breadcrumbs from '@components/content/Breadcrumbs.astro';
import ArticleCard from '@components/content/ArticleCard.astro';
import Pagination from '@components/common/Pagination.astro';
import SortControls from '@components/common/SortControls.astro';
import { fetchCollection } from '@lib/strapi';
import type { StrapiRecipe } from '@lib/types';
import { loadTranslations, getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

export const prerender = false;

const locale: Locale = 'en';
const translations = await loadTranslations(locale);
const t = (key: string) => getTranslation(translations, key);

// Difficolta disponibili per il filtro
const difficulties = ['easy', 'medium', 'hard', 'expert'] as const;
const activeDifficulty = Astro.url.searchParams.get('difficulty') || null;

// Paginazione e ordinamento da query params
const currentPage = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10));
const activeSort = Astro.url.searchParams.get('sort') || 'newest';

// Mappa ordinamento -> campo Strapi
const sortMap: Record<string, string> = {
  newest: 'published_date:desc',
  quickest: 'total_time:asc',
  easiest: 'difficulty:asc',
};

// Opzioni di ordinamento per il componente SortControls
const sortOptions = [
  { value: 'newest', label: t('sort.newest') },
  { value: 'quickest', label: t('sort.quickest') },
  { value: 'easiest', label: t('sort.easiest') },
];

// Recupera le ricette con filtro difficolta opzionale
const fetchOptions: Parameters<typeof fetchCollection>[1] = {
  locale,
  populate: 'cover_image',
  sort: sortMap[activeSort] || sortMap.newest,
  pageSize: 12,
  page: currentPage,
};

if (activeDifficulty && difficulties.includes(activeDifficulty as typeof difficulties[number])) {
  fetchOptions.filters = { difficulty: { $eq: activeDifficulty } };
}

let recipes: (StrapiRecipe & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
let totalCount = 0;
let totalPages = 1;
let fetchError = false;
try {
  const response = await fetchCollection<StrapiRecipe>('recipes', fetchOptions);
  recipes = response.data;
  totalCount = response.meta.pagination.total;
  totalPages = response.meta.pagination.pageCount;
} catch {
  fetchError = true;
}
const recipeRoute = localizedRoutes.recipes[locale];

// Breadcrumbs
const breadcrumbItems = [
  { label: t('content.home'), href: `/${locale}/` },
  { label: t('content.recipes') },
];
---

<BaseLayout
  title={`${t('content.recipes')} - ${t('site.name')}`}
  description={t('site.description')}
  locale={locale}
  canonicalPath={`/${locale}/${recipeRoute}/`}
>
  <Header slot="header" locale={locale} translations={translations} currentPath={`/${locale}/${recipeRoute}/`} />

  <section class="container-bbq py-12">
    <Breadcrumbs items={breadcrumbItems} locale={locale} />

    <h1 class="page-title">{t('content.allRecipes')}</h1>

    {/* Barra filtro difficolta */}
    <div class="category-filter">
      <a
        href={`/${locale}/${recipeRoute}/`}
        class:list={['filter-btn', { 'filter-btn--active': !activeDifficulty }]}
      >
        {t('content.allCategories')}
      </a>
      {difficulties.map((diff) => (
        <a
          href={`/${locale}/${recipeRoute}/?difficulty=${diff}`}
          class:list={['filter-btn', { 'filter-btn--active': activeDifficulty === diff }]}
        >
          {t(`content.${diff}`)}
        </a>
      ))}
    </div>

    {/* Controlli ordinamento */}
    <SortControls
      currentSort={activeSort}
      options={sortOptions}
      baseUrl={Astro.url.href}
    />

    {/* Conteggio risultati */}
    {!fetchError && totalCount > 0 && (
      <p class="result-count">
        {t('common.showing')} {recipes.length} {t('common.of')} {totalCount} {t('common.results')}
      </p>
    )}

    {fetchError ? (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('common.contentUnavailable')}</p>
      </div>
    ) : recipes.length > 0 ? (
      <div class="recipe-grid" data-animate>
        {recipes.map((recipe) => (
          <ArticleCard
            title={recipe.title}
            excerpt={recipe.excerpt}
            slug={recipe.slug}
            href={`/${locale}/${recipeRoute}/${recipe.slug}/`}
            coverImage={recipe.cover_image}
            category={recipe.difficulty}
            readingTime={recipe.total_time}
            publishedDate={recipe.published_date}
            locale={locale}
            translations={translations}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state" data-animate>
        <p class="empty-text">{t('content.noArticles')}</p>
      </div>
    )}

    {/* Paginazione */}
    {!fetchError && totalPages > 1 && (
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={Astro.url.href}
        translations={translations}
      />
    )}
  </section>

  <Footer slot="footer" locale={locale} translations={translations} />
</BaseLayout>

<style>
  .page-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: var(--space-6);
  }

  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .filter-btn {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    background-color: transparent;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-secondary);
  }

  .filter-btn--active {
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    border-color: var(--color-accent-fire);
  }

  .filter-btn--active:hover {
    background-color: var(--color-accent-ember);
    border-color: var(--color-accent-ember);
    color: var(--color-text-inverse);
  }

  .result-count {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-6);
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .recipe-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .recipe-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-24) 0;
  }

  .empty-text {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }
</style>
