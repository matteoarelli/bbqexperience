---
// Homepage inglese — BBQ Experience
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslation, loadTranslations } from '@lib/i18n';
import type { Locale } from '@lib/i18n';

const locale: Locale = 'en';
const t = await loadTranslations(locale);
---

<BaseLayout
  title={`${getTranslation(t, 'site.name')} - ${getTranslation(t, 'site.tagline')}`}
  description="The most complete BBQ review destination online."
  locale="en"
  canonicalPath="/"
>
  <section class="min-h-screen flex items-center justify-center bg-gradient-dark">
    <div class="container-bbq text-center">
      <h1 class="text-gradient-fire" style={`font-size: var(--text-5xl); font-family: var(--font-heading);`}>
        {getTranslation(t, 'hero.title')}
      </h1>
      <p style={`font-size: var(--text-lg); color: var(--color-text-secondary); margin-top: var(--space-6);`}>
        {getTranslation(t, 'hero.subtitle')}
      </p>
    </div>
  </section>
</BaseLayout>
