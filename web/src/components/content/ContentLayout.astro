---
/**
 * ContentLayout — layout per articoli long-form (tutorial e blog post)
 * Cover image full-width, colonna prose centrata, metadata, slot per breadcrumbs e contenuti correlati.
 */
import type { Locale } from '@lib/i18n';
import type { StrapiMedia } from '@lib/types';
import { getStrapiMediaURL } from '@lib/media';
import { getTranslation } from '@lib/i18n';

interface Props {
  title: string;
  content: string | null;
  coverImage: StrapiMedia | null;
  readingTime: number | null;
  publishedDate: string | null;
  category: string | null;
  locale: Locale;
  translations: Record<string, any>;
}

const {
  title,
  content,
  coverImage,
  readingTime,
  publishedDate,
  category,
  locale,
  translations,
} = Astro.props;

const imageUrl = getStrapiMediaURL(coverImage);
const imageAlt = coverImage?.alternativeText || title;

// Formatta data pubblicazione
const formattedDate = publishedDate
  ? new Date(publishedDate).toLocaleDateString(locale, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

// Testo tempo di lettura
const readingTimeText = readingTime
  ? getTranslation(translations, 'content.minRead').replace('{time}', String(readingTime))
  : null;

// Testo categoria tradotto
const categoryText = category
  ? getTranslation(translations, `content.${category}`)
  : null;

/**
 * Aggiunge id agli h2 nel contenuto HTML per navigazione sezione.
 * Converte il testo dell'heading in un slug URL-friendly.
 */
function addHeadingIds(html: string): string {
  return html.replace(/<h2([^>]*)>(.*?)<\/h2>/gi, (_match, attrs, text) => {
    const plainText = text.replace(/<[^>]+>/g, '');
    const id = plainText
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/\s+/g, '-');
    return `<h2${attrs} id="${id}">${text}</h2>`;
  });
}

const processedContent = content ? addHeadingIds(content) : null;
---

<article class="content-layout">
  <!-- Slot breadcrumbs -->
  <div class="container-bbq">
    <div class="content-breadcrumbs">
      <slot name="breadcrumbs" />
    </div>
  </div>

  <!-- Cover image full-width -->
  {imageUrl && (
    <div class="content-cover">
      <img
        src={imageUrl}
        alt={imageAlt}
        class="content-cover-image"
        loading="eager"
        decoding="async"
      />
      <div class="content-cover-overlay"></div>
    </div>
  )}

  <!-- Colonna prose centrata -->
  <div class="container-bbq">
    <div class="content-prose">
      <!-- Titolo -->
      <h1 class="content-title">{title}</h1>

      <!-- Slot per badge extra (es. difficulty) -->
      <slot name="badges" />

      <!-- Metadata row -->
      <div class="content-meta">
        {categoryText && (
          <span class="content-meta-badge">{categoryText}</span>
        )}
        {readingTimeText && (
          <span class="content-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {readingTimeText}
          </span>
        )}
        {formattedDate && (
          <span class="content-meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            {formattedDate}
          </span>
        )}
      </div>

      <!-- Contenuto articolo (rich text da CMS) -->
      {processedContent && (
        <div class="content-body" set:html={processedContent} />
      )}

      <!-- Slot per contenuti correlati -->
      <slot name="related" />
    </div>
  </div>
</article>

<style>
  .content-layout {
    padding-bottom: var(--space-24);
  }

  .content-breadcrumbs {
    padding-top: var(--space-6);
  }

  .content-cover {
    position: relative;
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    margin-bottom: var(--space-8);
  }

  .content-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: 480px;
  }

  .content-cover-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(transparent, var(--color-bg-primary));
    pointer-events: none;
  }

  .content-prose {
    max-width: 65ch;
    margin-inline: auto;
    padding-top: var(--space-4);
  }

  .content-title {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4) 0;
    line-height: 1.1;
  }

  .content-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .content-meta-badge {
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .content-meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* Stili prose per rich text dal CMS */
  .content-body {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .content-body :global(h2) {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .content-body :global(h3) {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .content-body :global(p) {
    margin-bottom: var(--space-4);
  }

  .content-body :global(ul),
  .content-body :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }

  .content-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .content-body :global(blockquote) {
    border-left: 4px solid var(--color-accent-fire);
    padding-left: var(--space-4);
    margin: var(--space-6) 0;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .content-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--color-bg-tertiary);
    padding: 0.1em 0.4em;
    border-radius: var(--radius-sm);
  }

  .content-body :global(pre) {
    background-color: var(--color-bg-tertiary);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  .content-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .content-body :global(img) {
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
  }

  .content-body :global(a) {
    color: var(--color-accent-fire);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .content-body :global(a:hover) {
    color: var(--color-accent-amber);
  }

  .content-body :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }
</style>
