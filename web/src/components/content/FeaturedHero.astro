---
/**
 * FeaturedHero — sezione hero homepage con contenuti in evidenza dal CMS
 * Mostra blog post con featured=true. Fallback alla Hero statica se nessun contenuto in evidenza.
 */
import type { Locale } from '@lib/i18n';
import { getTranslation, localizedRoutes } from '@lib/i18n';
import { fetchCollection } from '@lib/strapi';
import type { StrapiBlogPost } from '@lib/types';
import { getStrapiMediaURL } from '@lib/media';
import Hero from '@components/common/Hero.astro';

interface Props {
  locale: Locale;
  translations: Record<string, any>;
}

const { locale, translations } = Astro.props;
const t = (key: string) => getTranslation(translations, key);

// Recupera blog post in evidenza
let featuredPosts: (StrapiBlogPost & { id: number; documentId: string; createdAt: string; updatedAt: string; publishedAt: string | null; locale: string })[] = [];
try {
  const response = await fetchCollection<StrapiBlogPost>('blog-posts', {
    locale,
    filters: { featured: { $eq: true } },
    populate: 'cover_image',
    sort: 'published_date:desc',
    pageSize: 3,
  });
  featuredPosts = response.data;
} catch {
  // Fallback silenzioso se Strapi non disponibile
}

const blogRoute = localizedRoutes.blog[locale];
const hasFeatured = featuredPosts.length > 0;

// Post principale (primo) e secondari
const mainPost = hasFeatured ? featuredPosts[0] : null;
const secondaryPosts = hasFeatured ? featuredPosts.slice(1) : [];

const mainImageUrl = mainPost ? getStrapiMediaURL(mainPost.cover_image) : null;
---

{hasFeatured ? (
  <div class="featured-hero">
    {/* Titolo compatto BBQ Experience */}
    <div class="featured-hero__header">
      <div class="container-bbq text-center">
        <h1 class="featured-hero__title">
          <span class="text-gradient-fire">BBQ</span>
          <span class="featured-hero__title-rest">EXPERIENCE</span>
        </h1>
      </div>
    </div>

    {/* Post principale in evidenza */}
    {mainPost && (
      <a href={`/${locale}/${blogRoute}/${mainPost.slug}/`} class="featured-main">
        <div class="featured-main__image-wrapper">
          {mainImageUrl ? (
            <img
              src={mainImageUrl}
              alt={mainPost.cover_image?.alternativeText || mainPost.title}
              class="featured-main__image"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="featured-main__placeholder"></div>
          )}
          <div class="featured-main__overlay"></div>
        </div>
        <div class="featured-main__content">
          <span class="featured-main__label">{t('content.featuredContent')}</span>
          <h2 class="featured-main__title">{mainPost.title}</h2>
          {mainPost.excerpt && (
            <p class="featured-main__excerpt">{mainPost.excerpt}</p>
          )}
          <span class="featured-main__cta">{t('common.readMore')}</span>
        </div>
      </a>
    )}

    {/* Post secondari in evidenza */}
    {secondaryPosts.length > 0 && (
      <div class="container-bbq">
        <div class="featured-secondary">
          {secondaryPosts.map((post) => {
            const imgUrl = getStrapiMediaURL(post.cover_image);
            return (
              <a href={`/${locale}/${blogRoute}/${post.slug}/`} class="featured-card">
                <div class="featured-card__image-wrapper">
                  {imgUrl ? (
                    <img
                      src={imgUrl}
                      alt={post.cover_image?.alternativeText || post.title}
                      class="featured-card__image"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="featured-card__placeholder"></div>
                  )}
                  <div class="featured-card__overlay"></div>
                </div>
                <div class="featured-card__content">
                  <h3 class="featured-card__title">{post.title}</h3>
                  {post.excerpt && (
                    <p class="featured-card__excerpt">{post.excerpt}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>
) : (
  <Hero
    title={t('hero.title')}
    subtitle={t('hero.subtitle')}
    ctaText={t('hero.cta')}
    ctaHref={`/${locale}/${localizedRoutes.reviews[locale]}/`}
    locale={locale}
  />
)}

<style>
  .featured-hero {
    position: relative;
  }

  .featured-hero__header {
    padding: var(--space-12) 0 var(--space-6);
    background: linear-gradient(180deg, #0D0D0D 0%, transparent 100%);
  }

  .featured-hero__title {
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .featured-hero__title-rest {
    color: var(--color-text-primary);
    margin-left: var(--space-2);
  }

  /* Post principale in evidenza — full width con overlay */
  .featured-main {
    display: block;
    position: relative;
    width: 100%;
    max-height: 500px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .featured-main__image-wrapper {
    position: relative;
    width: 100%;
    height: 400px;
  }

  @media (min-width: 768px) {
    .featured-main__image-wrapper {
      height: 500px;
    }
  }

  .featured-main__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .featured-main:hover .featured-main__image {
    transform: scale(1.03);
  }

  .featured-main__placeholder {
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at 50% 0%, rgba(249,115,22,0.15) 0%, transparent 60%), linear-gradient(180deg, #1A1A1A 0%, #0D0D0D 100%);
  }

  .featured-main__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 30%, rgba(13, 13, 13, 0.95) 100%);
    pointer-events: none;
  }

  .featured-main__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-8);
    z-index: 2;
  }

  @media (min-width: 768px) {
    .featured-main__content {
      max-width: 60%;
      padding: var(--space-12);
    }
  }

  .featured-main__label {
    display: inline-block;
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
  }

  .featured-main__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3) 0;
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .featured-main__title {
      font-size: var(--text-3xl);
    }
  }

  .featured-main__excerpt {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0 0 var(--space-4) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-main__cta {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent-fire);
    transition: color var(--transition-fast);
  }

  .featured-main:hover .featured-main__cta {
    color: var(--color-accent-amber);
  }

  /* Post secondari */
  .featured-secondary {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding: var(--space-6) 0 var(--space-12);
  }

  @media (min-width: 768px) {
    .featured-secondary {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-fire);
  }

  .featured-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-tertiary);
  }

  .featured-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .featured-card:hover .featured-card__image {
    transform: scale(1.05);
  }

  .featured-card__placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-bg-tertiary);
  }

  .featured-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(transparent, var(--color-bg-secondary));
    pointer-events: none;
  }

  .featured-card__content {
    padding: var(--space-4);
  }

  .featured-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.2;
  }

  .featured-card__excerpt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
