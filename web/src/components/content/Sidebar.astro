---
/**
 * Sidebar — wrapper sticky per contenuti laterali nelle pagine di dettaglio.
 * Sticky su desktop (lg:), flusso normale su mobile.
 */
---

<aside class="sidebar">
  <div class="sidebar__inner">
    <slot />
  </div>
</aside>

<style>
  .sidebar {
    width: 100%;
  }

  .sidebar__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Desktop: sidebar sticky con larghezza fissa */
  @media (min-width: 1024px) {
    .sidebar {
      width: 280px;
      flex-shrink: 0;
    }

    .sidebar__inner {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }
</style>
