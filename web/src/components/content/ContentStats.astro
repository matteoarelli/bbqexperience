---
/**
 * ContentStats — barra statistiche compatta per listing pages.
 * Mostra conteggio totale e statistiche specifiche per tipo (punteggio medio per reviews, breakdown difficolta per recipes).
 */
import type { Locale } from '@lib/i18n';
import { getTranslation } from '@lib/i18n';

interface StatsItem {
  score?: number;
  difficulty?: string | null;
}

interface Props {
  items: StatsItem[];
  type: 'reviews' | 'recipes' | 'tutorials' | 'blog';
  totalCount: number;
  locale: Locale;
  translations: Record<string, any>;
}

const { items, type, totalCount, locale, translations } = Astro.props;
const t = (key: string) => getTranslation(translations, key);

// Calcola punteggio medio per le reviews
let avgScore: string | null = null;
if (type === 'reviews' && items.length > 0) {
  const scores = items.filter((i) => typeof i.score === 'number').map((i) => i.score!);
  if (scores.length > 0) {
    avgScore = (scores.reduce((a, b) => a + b, 0) / scores.length).toFixed(1);
  }
}

// Calcola breakdown difficolta per le ricette
let difficultyBreakdown: { label: string; count: number }[] = [];
if (type === 'recipes' && items.length > 0) {
  const counts: Record<string, number> = {};
  for (const item of items) {
    if (item.difficulty) {
      counts[item.difficulty] = (counts[item.difficulty] || 0) + 1;
    }
  }
  difficultyBreakdown = Object.entries(counts).map(([key, count]) => ({
    label: t(`content.${key}`),
    count,
  }));
}
---

<div class="stats-bar">
  {/* Conteggio totale */}
  <div class="stats-item">
    <span class="stats-value">{totalCount}</span>
    <span class="stats-label">{t('content.totalItems')}</span>
  </div>

  {/* Punteggio medio (solo reviews) */}
  {type === 'reviews' && avgScore && (
    <div class="stats-item">
      <span class="stats-value">{avgScore}</span>
      <span class="stats-label">{t('content.avgScore')}</span>
    </div>
  )}

  {/* Breakdown difficolta (solo recipes) */}
  {type === 'recipes' && difficultyBreakdown.length > 0 && (
    <div class="stats-item stats-item--breakdown">
      <span class="stats-label">{t('content.difficultyBreakdown')}</span>
      <div class="stats-breakdown">
        {difficultyBreakdown.map((d) => (
          <span class="stats-breakdown-item">
            <span class="stats-breakdown-count">{d.count}</span>
            {d.label}
          </span>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .stats-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-6);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
  }

  .stats-item {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .stats-item--breakdown {
    flex-direction: column;
    gap: var(--space-1);
  }

  .stats-value {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-accent-fire);
    line-height: 1;
  }

  .stats-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .stats-breakdown {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .stats-breakdown-item {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .stats-breakdown-count {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-accent-fire);
  }
</style>
