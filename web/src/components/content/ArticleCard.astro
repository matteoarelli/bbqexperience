---
/**
 * ArticleCard — card per listing di tutorial e articoli blog
 * Immagine di copertina, badge categoria, titolo, excerpt, tempo di lettura e data.
 */
import type { Locale } from '@lib/i18n';
import type { StrapiMedia } from '@lib/types';
import { getStrapiMediaURL } from '@lib/media';
import { getTranslation } from '@lib/i18n';
import ImageWithPlaceholder from '@components/common/ImageWithPlaceholder.astro';

interface Props {
  title: string;
  excerpt: string | null;
  slug: string;
  href: string;
  coverImage: StrapiMedia | null;
  category: string | null;
  readingTime: number | null;
  publishedDate: string | null;
  locale: Locale;
  translations: Record<string, any>;
}

const {
  title,
  excerpt,
  href,
  coverImage,
  category,
  readingTime,
  publishedDate,
  locale,
  translations,
} = Astro.props;

const imageUrl = getStrapiMediaURL(coverImage);
const imageAlt = coverImage?.alternativeText || title;

// Formatta la data pubblicazione
const formattedDate = publishedDate
  ? new Date(publishedDate).toLocaleDateString(locale, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : null;

// Testo tempo di lettura
const readingTimeText = readingTime
  ? getTranslation(translations, 'content.minRead').replace('{time}', String(readingTime))
  : null;

// Testo categoria tradotto
const categoryText = category
  ? getTranslation(translations, `content.${category}`)
  : null;
---

<a href={href} class="article-card card-hover" data-animate>
  <!-- Immagine di copertina -->
  <div class="card-image-wrapper">
    {imageUrl ? (
      <ImageWithPlaceholder
        src={imageUrl}
        alt={imageAlt}
        class="card-image"
        width="640"
        height="360"
      />
    ) : (
      <div class="card-image-placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
      </div>
    )}
    <div class="card-image-overlay"></div>
    {categoryText && (
      <span class="card-badge">{categoryText}</span>
    )}
  </div>

  <!-- Contenuto card -->
  <div class="card-body">
    <h3 class="card-title">{title}</h3>

    {excerpt && (
      <p class="card-excerpt">{excerpt}</p>
    )}

    <!-- Metadata: tempo di lettura + data -->
    <div class="card-meta">
      {readingTimeText && (
        <span class="card-meta-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {readingTimeText}
        </span>
      )}
      {formattedDate && (
        <span class="card-meta-item">
          {formattedDate}
        </span>
      )}
      <span class="card-read-more">Leggi &rarr;</span>
    </div>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .article-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-fire);
  }

  .card-image-wrapper {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background-color: var(--color-bg-tertiary);
  }

  .card-image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(transparent, rgba(26, 26, 26, 0.8));
    pointer-events: none;
    z-index: 1;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .article-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }

  .card-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-4);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.15;
  }

  .card-excerpt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0 0 var(--space-4) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }

  .card-meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
</style>
