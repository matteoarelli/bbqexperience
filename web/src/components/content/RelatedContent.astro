---
/**
 * RelatedContent — sezione contenuti correlati cross-tipo
 * Mostra articoli da tutorial, recensioni e ricette per scoperta contenuti.
 * Esclude l'articolo corrente per evitare auto-referenza.
 */
import type { Locale } from '@lib/i18n';
import { getTranslation, localizedRoutes } from '@lib/i18n';
import { fetchCollection } from '@lib/strapi';
import type { StrapiTutorial, StrapiReview, StrapiRecipe } from '@lib/types';
import ArticleCard from '@components/content/ArticleCard.astro';
import ContentBadge from '@components/common/ContentBadge.astro';
import { getStrapiMediaURL } from '@lib/media';

/**
 * Hash semplice basato sulla stringa — genera un seed deterministico
 * per lo shuffle, così il risultato è stabile per ogni articolo.
 */
function hashString(str: string): number {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = ((hash << 5) - hash) + char;
    hash |= 0; // Converti a intero 32-bit
  }
  return Math.abs(hash);
}

/**
 * PRNG deterministico (Linear Congruential Generator) —
 * produce valori pseudo-casuali ripetibili dato lo stesso seed.
 */
function seededRandom(seed: number): () => number {
  let state = seed;
  return () => {
    state = (state * 1664525 + 1013904223) & 0x7fffffff;
    return state / 0x7fffffff;
  };
}

interface Props {
  locale: Locale;
  translations: Record<string, any>;
  currentSlug: string;
  currentType: 'tutorial' | 'blog-post';
}

const { locale, translations, currentSlug, currentType } = Astro.props;
const t = (key: string) => getTranslation(translations, key);

// Risultato vuoto di default per gestire errori singoli
const emptyResult = { data: [], meta: { pagination: { total: 0, pageCount: 0, page: 1, pageSize: 0 } } };

// Recupera contenuti recenti da diversi tipi — ogni fetch wrappato in try/catch
// per evitare che un errore su un tipo blocchi l'intero componente
let tutorialsRes: Awaited<ReturnType<typeof fetchCollection<StrapiTutorial>>>;
let reviewsRes: Awaited<ReturnType<typeof fetchCollection<StrapiReview>>>;
let recipesRes: Awaited<ReturnType<typeof fetchCollection<StrapiRecipe>>>;

try {
  tutorialsRes = await fetchCollection<StrapiTutorial>('tutorials', {
    locale,
    pageSize: 4,
    sort: 'published_date:desc',
    populate: 'cover_image',
  });
} catch {
  tutorialsRes = emptyResult as typeof tutorialsRes;
}

try {
  reviewsRes = await fetchCollection<StrapiReview>('reviews', {
    locale,
    pageSize: 3,
    sort: 'published_date:desc',
    populate: 'gallery',
  });
} catch {
  reviewsRes = emptyResult as typeof reviewsRes;
}

try {
  recipesRes = await fetchCollection<StrapiRecipe>('recipes', {
    locale,
    pageSize: 3,
    sort: 'published_date:desc',
    populate: 'cover_image',
  });
} catch {
  recipesRes = emptyResult as typeof recipesRes;
}

// Struttura unificata per i contenuti correlati
interface RelatedItem {
  title: string;
  excerpt: string | null;
  slug: string;
  href: string;
  coverImage: any;
  category: string | null;
  readingTime: number | null;
  publishedDate: string | null;
  contentType: string;
  badgeType: 'review' | 'recipe' | 'tutorial' | 'blog';
}

const tutorialRoute = localizedRoutes.tutorials[locale];
const reviewRoute = localizedRoutes.reviews[locale];
const recipeRoute = localizedRoutes.recipes[locale];

// Combina i risultati escludendo l'articolo corrente
const allItems: RelatedItem[] = [];

for (const tutorial of tutorialsRes.data) {
  if (currentType === 'tutorial' && tutorial.slug === currentSlug) continue;
  allItems.push({
    title: tutorial.title,
    excerpt: tutorial.excerpt,
    slug: tutorial.slug,
    href: `/${locale}/${tutorialRoute}/${tutorial.slug}/`,
    coverImage: tutorial.cover_image,
    category: tutorial.category,
    readingTime: tutorial.reading_time,
    publishedDate: tutorial.published_date,
    contentType: t('content.tutorials'),
    badgeType: 'tutorial',
  });
}

for (const review of reviewsRes.data) {
  allItems.push({
    title: review.title,
    excerpt: review.excerpt,
    slug: review.slug,
    href: `/${locale}/${reviewRoute}/${review.slug}/`,
    coverImage: review.gallery?.[0] || null,
    category: null,
    readingTime: null,
    publishedDate: review.published_date,
    contentType: t('nav.reviews'),
    badgeType: 'review',
  });
}

for (const recipe of recipesRes.data) {
  allItems.push({
    title: recipe.title,
    excerpt: recipe.excerpt,
    slug: recipe.slug,
    href: `/${locale}/${recipeRoute}/${recipe.slug}/`,
    coverImage: recipe.cover_image,
    category: recipe.technique,
    readingTime: null,
    publishedDate: recipe.published_date,
    contentType: t('nav.recipes'),
    badgeType: 'recipe',
  });
}

// Shuffle deterministico basato sullo slug dell'articolo corrente
const seed = hashString(currentSlug);
const rng = seededRandom(seed);
const shuffled = allItems.sort(() => rng() - 0.5).slice(0, 6);
---

{shuffled.length > 0 && (
  <section class="related-content">
    <div class="related-header">
      <h2 class="related-title">{t('content.relatedContent')}</h2>
    </div>

    <div class="related-grid">
      {shuffled.map((item) => (
        <div class="related-item">
          <div class="related-type-badge-wrapper">
            <ContentBadge type={item.badgeType} locale={locale} translations={translations} />
          </div>
          <ArticleCard
            title={item.title}
            excerpt={item.excerpt}
            slug={item.slug}
            href={item.href}
            coverImage={item.coverImage}
            category={item.category}
            readingTime={item.readingTime}
            publishedDate={item.publishedDate}
            locale={locale}
            translations={translations}
          />
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .related-content {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border-subtle);
  }

  .related-header {
    margin-bottom: var(--space-8);
  }

  .related-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0;
  }

  .related-grid {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-4);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.1) transparent;
  }

  .related-grid::-webkit-scrollbar {
    height: 4px;
  }

  .related-grid::-webkit-scrollbar-track {
    background: transparent;
  }

  .related-grid::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
  }

  .related-item {
    flex: 0 0 280px;
    scroll-snap-align: start;
    position: relative;
  }

  .related-type-badge-wrapper {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 10;
  }

  @media (min-width: 1024px) {
    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
      scroll-snap-type: none;
    }

    .related-item {
      flex: auto;
    }
  }
</style>
