---
/**
 * Componente immagine ottimizzata — wrapper per Astro Image con lazy loading e formati moderni
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  quality?: number;
}

const {
  src,
  alt,
  width,
  height,
  widths = [320, 640, 960, 1280, 1920],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  loading = 'lazy',
  class: className = '',
  quality = 80,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  loading={loading}
  decoding="async"
  class={className}
  quality={quality}
  format="webp"
/>
