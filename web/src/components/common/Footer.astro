---
// Footer del sito — sezioni, social, copyright, newsletter compatta
import { getTranslation, localizedRoutes } from '@lib/i18n';
import type { Locale } from '@lib/i18n';
import NewsletterSignup from '@components/common/NewsletterSignup.astro';

interface Props {
  locale: Locale;
  translations: Record<string, any>;
}

const { locale, translations } = Astro.props;

const currentYear = new Date().getFullYear();

// Link di navigazione per il footer
const sectionLinks = ['reviews', 'recipes', 'tutorials', 'blog'] as const;
---

<footer class="site-footer">
  <!-- Linea gradiente fuoco in cima al footer -->
  <div class="footer-fire-divider" aria-hidden="true"></div>

  <div class="container-bbq" style="padding-top: var(--space-16);">
    <!-- Newsletter — sezione full-width sopra la griglia footer -->
    <div class="footer-newsletter">
      <h4 class="footer-heading">{getTranslation(translations, 'newsletter.title')}</h4>
      <NewsletterSignup translations={translations} compact />
    </div>

    <!-- Griglia principale: 1 col mobile, 4 col desktop -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

      <!-- Colonna 1: Logo + descrizione -->
      <div>
        <a href={`/${locale}/`} class="inline-flex items-center gap-0 mb-4" style="text-decoration: none;">
          <span class="fire-text" style="font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 900; text-transform: uppercase;">BBQ</span>
          <span style="font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 900; text-transform: uppercase; color: var(--color-text-primary);">EXP</span>
        </a>
        <p class="footer-text mt-4">
          {getTranslation(translations, 'footer.about')}
        </p>
      </div>

      <!-- Colonna 2: Sezioni -->
      <div>
        <h4 class="footer-heading">{getTranslation(translations, 'footer.sections')}</h4>
        <ul class="space-y-3">
          {sectionLinks.map((key) => (
            <li>
              <a
                href={`/${locale}/${localizedRoutes[key][locale]}/`}
                class="footer-link"
              >
                {getTranslation(translations, `nav.${key}`)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Colonna 3: Connect / Social -->
      <div>
        <h4 class="footer-heading">{getTranslation(translations, 'footer.connect')}</h4>
        <ul class="space-y-3">
          <li>
            <a
              href="https://instagram.com/bbqexperience"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link inline-flex items-center gap-2"
            >
              <!-- Icona Instagram (SVG inline) -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              Instagram <span class="footer__social-count">74K</span>
            </a>
          </li>
          <li>
            <a
              href="https://youtube.com/@bbqexperience"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link inline-flex items-center gap-2"
            >
              <!-- Icona YouTube (SVG inline) -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.13C5.12 19.56 12 19.56 12 19.56s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43z"></path>
                <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
              </svg>
              YouTube
            </a>
          </li>
          <li>
            <a
              href="https://tiktok.com/@bbqexperience"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-link inline-flex items-center gap-2"
            >
              <!-- Icona TikTok (SVG inline) -->
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
              </svg>
              TikTok
            </a>
          </li>
        </ul>
      </div>

      <!-- Colonna 4: Legal + link utili -->
      <div>
        <h4 class="footer-heading">{getTranslation(translations, 'footer.legal')}</h4>
        <ul class="space-y-3">
          <li><a href={`/${locale}/${localizedRoutes.about[locale]}/`} class="footer-link">{getTranslation(translations, 'nav.about')}</a></li>
          <li><a href={`/${locale}/${localizedRoutes.contact[locale]}/`} class="footer-link">{getTranslation(translations, 'nav.contact')}</a></li>
          <li><a href={`/${locale}/${localizedRoutes.privacy[locale]}/`} class="footer-link">Privacy Policy</a></li>
          <li><a href={`/${locale}/${localizedRoutes.terms[locale]}/`} class="footer-link">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <!-- Back to top -->
    <div class="footer-back-to-top">
      <a href="#" class="footer-back-to-top__link" aria-label="Torna in cima">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
      </a>
    </div>

    <!-- Barra inferiore -->
    <div class="border-t mt-8 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4" style="border-color: var(--color-border-subtle);">
      <p class="footer-text text-center sm:text-left">
        &copy; {currentYear} BBQ Experience. {getTranslation(translations, 'common.copyright')}
      </p>
      <p style="color: var(--color-accent-fire); font-family: var(--font-heading); font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.05em;">
        Made with fire
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-primary);
    padding-bottom: var(--space-8);
    position: relative;
  }

  /* Linea gradiente fuoco in cima al footer */
  .footer-fire-divider {
    height: 3px;
    background: linear-gradient(90deg,
      transparent 0%,
      var(--color-accent-ember) 15%,
      var(--color-accent-fire) 35%,
      var(--color-accent-amber) 50%,
      var(--color-accent-fire) 65%,
      var(--color-accent-ember) 85%,
      transparent 100%
    );
  }

  .footer-newsletter {
    max-width: 480px;
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-fire);
    margin-bottom: var(--space-6);
  }

  .footer-link {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-fast), padding-left var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-text-primary);
    padding-left: 4px;
  }

  .footer-text {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* Back to top */
  /* Badge conteggio follower social */
  .footer__social-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-fire);
    background: rgba(249, 115, 22, 0.1);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    margin-left: var(--space-1);
  }

  .footer-back-to-top {
    text-align: center;
    margin-top: var(--space-12);
  }

  .footer-back-to-top__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    border: 2px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .footer-back-to-top__link:hover {
    border-color: var(--color-accent-fire);
    color: var(--color-accent-fire);
    transform: translateY(-3px);
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.2);
  }
</style>
