---
// Bottone hamburger del menu mobile.
// Il pannello vero (backdrop + slide-in) e' renderizzato da MobileMenuPanel
// a livello body in BaseLayout, per evitare che il backdrop-filter
// dell'header crei un containing block che intrappola position:fixed.
---

<button
  id="mobile-menu-toggle"
  class="lg:hidden mobile-toggle"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="mobile-menu-panel"
>
  <span class="hamburger-bar"></span>
  <span class="hamburger-bar"></span>
  <span class="hamburger-bar"></span>
</button>

<style>
  .mobile-toggle {
    position: relative;
    z-index: 60;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
    border-radius: var(--radius-md);
  }

  .mobile-toggle:focus-visible {
    outline: 2px solid var(--color-accent-fire);
    outline-offset: 2px;
  }

  .hamburger-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text-primary);
    border-radius: 2px;
    transition: transform 240ms ease, opacity 200ms ease, background-color 200ms ease;
  }

  .hamburger-bar + .hamburger-bar {
    margin-top: 6px;
  }

  .menu-open .hamburger-bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-open .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .menu-open .hamburger-bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>
