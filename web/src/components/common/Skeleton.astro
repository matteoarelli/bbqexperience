---
/**
 * Skeleton — componente placeholder di caricamento con effetto shimmer CSS-only.
 * Varianti: card, text, circle. Compatibile con dark theme.
 */
interface Props {
  variant?: 'card' | 'text' | 'circle';
  width?: string;
  height?: string;
  class?: string;
}

const {
  variant = 'text',
  width,
  height,
  class: className = '',
} = Astro.props;

// Dimensioni predefinite per variante
const defaults: Record<string, { w: string; h: string }> = {
  card: { w: '100%', h: '280px' },
  text: { w: '100%', h: '1em' },
  circle: { w: '48px', h: '48px' },
};

const w = width || defaults[variant].w;
const h = height || defaults[variant].h;
---

<div
  class:list={['skeleton', `skeleton--${variant}`, className]}
  style={`--skeleton-w: ${w}; --skeleton-h: ${h};`}
  aria-hidden="true"
/>

<style>
  .skeleton {
    width: var(--skeleton-w);
    height: var(--skeleton-h);
    background: var(--skeleton-base, #2a2a2a);
    background-image: linear-gradient(
      90deg,
      var(--skeleton-base, #2a2a2a) 0%,
      var(--skeleton-highlight, #3a3a3a) 50%,
      var(--skeleton-base, #2a2a2a) 100%
    );
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.5s ease-in-out infinite;
    border-radius: var(--radius-sm);
  }

  .skeleton--card {
    border-radius: var(--radius-md, 8px);
  }

  .skeleton--circle {
    border-radius: 50%;
  }

  .skeleton--text + .skeleton--text {
    margin-top: 0.5em;
  }

  :root[data-theme='light'] .skeleton {
    --skeleton-base: #e0e0e0;
    --skeleton-highlight: #f0f0f0;
  }

  @keyframes skeleton-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
</style>
