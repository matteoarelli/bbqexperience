---
/**
 * Componente SEO Head — genera meta tags per hreflang, canonical, Open Graph e Twitter Card
 */
interface Props {
  title: string;
  description: string;
  locale?: string;
  canonicalPath?: string;
  canonicalQuery?: string;
  ogImage?: string;
  type?: string;
  publishedTime?: string;
  modifiedTime?: string;
  articleAuthor?: string;
}

const {
  title,
  description,
  locale = 'en',
  canonicalPath = '',
  canonicalQuery = '',
  ogImage = '/og-default.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  articleAuthor = 'BBQ Experience',
} = Astro.props;

const siteUrl = 'https://bbq-experience.com';
const locales = ['en', 'it', 'es'];

// Mappa locale breve -> formato OG con underscore
const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  it: 'it_IT',
  es: 'es_ES',
};

// Assicura che ogImage sia un URL assoluto
const absoluteOgImage = ogImage
  ? ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`
  : '';

// Tronca la descrizione a 160 caratteri per evitare troncamento nei risultati Google
const safeDescription = description && description.length > 160
  ? description.slice(0, 157) + '...'
  : description;

// URL canonico per la locale corrente (con query params opzionali per paginazione)
const canonicalUrl = `${siteUrl}/${locale}${canonicalPath}${canonicalQuery ? `?${canonicalQuery}` : ''}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0D0D0D" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#FAFAF9" media="(prefers-color-scheme: light)" />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow" />

<title>{title}</title>
<meta name="description" content={safeDescription} />

<!-- RSS Feed -->
<link rel="alternate" type="application/rss+xml" title="BBQ Experience RSS" href={`/${locale}/rss.xml`} />

<!-- Canonical -->
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang per tutte le lingue supportate -->
{locales.map((lang) => (
  <link rel="alternate" hreflang={lang} href={`${siteUrl}/${lang}${canonicalPath}${canonicalQuery ? `?${canonicalQuery}` : ''}`} />
))}
<link rel="alternate" hreflang="x-default" href={`${siteUrl}/en${canonicalPath}${canonicalQuery ? `?${canonicalQuery}` : ''}`} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={safeDescription} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="BBQ Experience" />
<meta property="og:locale" content={ogLocaleMap[locale] || locale} />
{locales.filter((l) => l !== locale).map((altLocale) => (
  <meta property="og:locale:alternate" content={ogLocaleMap[altLocale] || altLocale} />
))}
{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

<!-- Article meta (solo per pagine di tipo article) -->
{type === 'article' && articleAuthor && <meta property="article:author" content={articleAuthor} />}
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={safeDescription} />
{absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
