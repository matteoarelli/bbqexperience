---
/**
 * NewsletterSignup — Componente iscrizione newsletter
 * Versione "full" (con titolo e sottotitolo) o "compact" (solo input + bottone).
 * Per ora salva in localStorage; integrare backend in futuro.
 *
 * Props:
 *   - translations: oggetto traduzioni i18n
 *   - compact: se true, mostra solo input + bottone (per il footer)
 */
import { getTranslation } from '@lib/i18n';

interface Props {
  translations: Record<string, any>;
  compact?: boolean;
  source?: 'inline' | 'landing' | 'footer' | 'exit-intent';
}

const { translations, compact = false, source = 'inline' } = Astro.props;

const title = getTranslation(translations, 'newsletter.title');
const subtitle = getTranslation(translations, 'newsletter.subtitle');
const placeholder = getTranslation(translations, 'newsletter.placeholder');
const submitText = getTranslation(translations, 'newsletter.submit');
const successText = getTranslation(translations, 'newsletter.success');
const confirmText = getTranslation(translations, 'newsletter.confirmMessage');
const errorGeneric = getTranslation(translations, 'newsletter.errorGeneric');
const errorRateLimit = getTranslation(translations, 'newsletter.errorRateLimit');
const errorInvalidEmail = getTranslation(translations, 'newsletter.errorInvalidEmail');
---

<div
  class:list={['newsletter', { 'newsletter--compact': compact }]}
  data-newsletter
  data-newsletter-source={source}
  data-error-generic={errorGeneric}
  data-error-ratelimit={errorRateLimit}
  data-error-email={errorInvalidEmail}
>
  {!compact && (
    <div class="newsletter__header">
      <h2 class="newsletter__title">{title}</h2>
      <p class="newsletter__subtitle">{subtitle}</p>
    </div>
  )}

  <form class="newsletter__form" data-newsletter-form>
    <div class="newsletter__input-group">
      <input
        type="email"
        required
        placeholder={placeholder}
        class="newsletter__input"
        data-newsletter-email
        autocomplete="email"
      />
      <button type="submit" class="newsletter__submit">{submitText}</button>
    </div>
    <!-- Honeypot: campo invisibile anti-bot -->
    <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="newsletter__honeypot" />
  </form>

  <p class="newsletter__success" data-newsletter-success style="display: none;">
    {successText}
  </p>

  <p class="newsletter__confirm" data-newsletter-confirm style="display: none;">
    {confirmText}
  </p>

  <p class="newsletter__error" data-newsletter-error style="display: none;"></p>
</div>

<script>
  // Gestione submit newsletter — POST al backend con DOI + honeypot
  document.querySelectorAll('[data-newsletter]').forEach((container) => {
    const form = container.querySelector('[data-newsletter-form]') as HTMLFormElement | null;
    const success = container.querySelector('[data-newsletter-success]') as HTMLElement | null;
    const confirm = container.querySelector('[data-newsletter-confirm]') as HTMLElement | null;
    const errorEl = container.querySelector('[data-newsletter-error]') as HTMLElement | null;
    const emailInput = container.querySelector('[data-newsletter-email]') as HTMLInputElement | null;
    if (!form || !success || !confirm || !errorEl || !emailInput) return;

    const source = (container as HTMLElement).getAttribute('data-newsletter-source') || 'inline';
    const errorGenericText = (container as HTMLElement).getAttribute('data-error-generic') || 'Something went wrong.';
    const errorRateLimitText = (container as HTMLElement).getAttribute('data-error-ratelimit') || 'Too many attempts.';
    const errorEmailText = (container as HTMLElement).getAttribute('data-error-email') || 'Invalid email.';

    // Se gia' iscritto, mostra subito il messaggio di successo
    if (localStorage.getItem('bbq-newsletter-subscribed')) {
      form.style.display = 'none';
      success.style.display = 'block';
      return;
    }

    function showError(msg: string) {
      errorEl!.textContent = msg;
      errorEl!.style.display = 'block';
    }

    function hideError() {
      errorEl!.style.display = 'none';
      errorEl!.textContent = '';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideError();
      const email = emailInput.value.trim();
      if (!email) return;

      // Validazione email lato client
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError(errorEmailText);
        return;
      }

      // Leggi honeypot
      const honeypotInput = form.querySelector('[name="website"]') as HTMLInputElement | null;
      const honeypotValue = honeypotInput?.value || '';

      try {
        const locale = document.documentElement.lang || 'en';
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, locale, source, website: honeypotValue }),
        });

        if (res.ok) {
          // DOI: mostra messaggio di conferma (controlla inbox)
          localStorage.setItem('bbq-newsletter-subscribed', email);
          form.style.display = 'none';
          confirm.style.display = 'block';
          // Track newsletter signup in Umami
          if (typeof umami !== 'undefined') umami.track('newsletter-signup', { source });
          return;
        }

        if (res.status === 429) {
          showError(errorRateLimitText);
          return;
        }

        showError(errorGenericText);
      } catch (err) {
        console.error('Errore invio newsletter:', err);
        showError(errorGenericText);
      }
    });
  });
</script>

<style>
  .newsletter {
    background-color: var(--color-bg-secondary);
    border: 2px solid transparent;
    border-image: linear-gradient(135deg, var(--color-accent-fire), var(--color-accent-ember, #ea580c), var(--color-accent-fire)) 1;
    border-radius: 0;
    padding: var(--space-10) var(--space-8);
    text-align: center;
  }

  .newsletter--compact {
    background: transparent;
    border: none;
    border-image: none;
    padding: 0;
    text-align: left;
  }

  .newsletter__header {
    margin-bottom: var(--space-6);
  }

  .newsletter__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
  }

  .newsletter__subtitle {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    margin: 0;
    line-height: 1.5;
  }

  .newsletter__input-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 480px;
    margin: 0 auto;
  }

  .newsletter--compact .newsletter__input-group {
    margin: 0;
    max-width: none;
  }

  @media (min-width: 640px) {
    .newsletter__input-group {
      flex-direction: row;
    }
  }

  .newsletter__input {
    flex: 1;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md, 6px);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .newsletter__input::placeholder {
    color: var(--color-text-muted);
  }

  .newsletter__input:focus {
    border-color: var(--color-accent-fire);
  }

  .newsletter__submit {
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse, #fff);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: var(--space-3) var(--space-6);
    border: none;
    border-radius: var(--radius-md, 6px);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .newsletter__submit:hover {
    background-color: var(--color-accent-ember, #ea580c);
    transform: scale(1.02);
  }

  .newsletter__success {
    color: var(--color-accent-fire);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    margin: 0;
  }

  .newsletter__honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  .newsletter__confirm {
    color: var(--color-accent-fire);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    margin: 0;
  }

  .newsletter__error {
    color: var(--color-negative, #ef4444);
    font-size: var(--text-sm);
    margin: var(--space-2) 0 0;
  }
</style>
