---
/**
 * BreadcrumbJsonLd — Genera markup Schema.org JSON-LD per BreadcrumbList
 * Necessario per i rich snippet breadcrumb nei risultati di ricerca Google.
 * Segue le linee guida Google: l'ultimo elemento (pagina corrente) non ha URL.
 */
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  siteUrl?: string;
}

const { items, siteUrl = 'https://bbq-experience.com' } = Astro.props;

// Non renderizzare se meno di 2 elementi (breadcrumb non significativo)
const shouldRender = items.length >= 2;

// Costruisci l'oggetto JSON-LD BreadcrumbList
const jsonLd = shouldRender ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => {
    const listItem: Record<string, unknown> = {
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
    };
    // Aggiungi URL solo se l'elemento ha href (l'ultimo elemento e la pagina corrente, senza URL per Google)
    if (item.href) {
      // Guard: se l'href è già un URL assoluto, non anteporre siteUrl
      listItem.item = item.href.startsWith('http') ? item.href : `${siteUrl}${item.href}`;
    }
    return listItem;
  }),
} : null;
---

{shouldRender && jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
