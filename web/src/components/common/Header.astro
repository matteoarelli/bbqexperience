---
// Header del sito — logo, navigazione desktop, language switcher, menu mobile
import Nav from '@components/common/Nav.astro';
import LanguageSwitcher from '@components/common/LanguageSwitcher.astro';
import MobileMenu from '@components/common/MobileMenu.astro';
import SearchDialog from '@components/content/SearchDialog.svelte';
import type { Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  translations: Record<string, any>;
  currentPath: string;
}

const { locale, translations, currentPath } = Astro.props;
---

<header class="sticky top-0 z-30 backdrop-blur-md" style="background-color: rgba(13, 13, 13, 0.8); border-bottom: 1px solid var(--color-border-subtle);">
  <div class="container-bbq flex justify-between items-center h-16 lg:h-20">
    <!-- Logo -->
    <a href={`/${locale}/`} class="flex items-center gap-0 no-underline" style="text-decoration: none;">
      <span style="font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 900; text-transform: uppercase; color: var(--color-accent-fire);">BBQ</span>
      <span style="font-family: var(--font-heading); font-size: var(--text-2xl); font-weight: 900; text-transform: uppercase; color: var(--color-text-primary);">EXP</span>
    </a>

    <!-- Navigazione desktop (centro) -->
    <Nav locale={locale} translations={translations} />

    <!-- Destra: search + language switcher (desktop) + hamburger (mobile) -->
    <div class="flex items-center gap-4">
      <SearchDialog
        locale={locale}
        translations={{
          searchPlaceholder: translations?.content?.searchPlaceholder || 'Search',
          noArticles: translations?.content?.noArticles || 'No results found.',
        }}
        client:idle
      />
      <div class="hidden lg:block">
        <LanguageSwitcher currentLocale={locale} currentPath={currentPath} />
      </div>
      <MobileMenu locale={locale} translations={translations} currentPath={currentPath} />
    </div>
  </div>
</header>
