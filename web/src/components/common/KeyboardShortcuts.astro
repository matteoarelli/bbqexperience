---
/**
 * KeyboardShortcuts — scorciatoie da tastiera globali
 * /  o Ctrl+K: apre la ricerca
 * H: vai alla homepage
 * ?: mostra il modale con le scorciatoie
 */
---

<!-- Modale scorciatoie (nascosto di default) -->
<div id="shortcuts-modal" class="shortcuts-modal" aria-hidden="true" role="dialog" aria-label="Keyboard shortcuts">
  <div class="shortcuts-modal__backdrop"></div>
  <div class="shortcuts-modal__content">
    <div class="shortcuts-modal__header">
      <h3 class="shortcuts-modal__title">Keyboard Shortcuts</h3>
      <button class="shortcuts-modal__close" aria-label="Close">&times;</button>
    </div>
    <ul class="shortcuts-modal__list">
      <li>
        <kbd>/</kbd> <span>or</span> <kbd>Ctrl+K</kbd>
        <span class="shortcuts-modal__desc">Open search</span>
      </li>
      <li>
        <kbd>H</kbd>
        <span class="shortcuts-modal__desc">Go to homepage</span>
      </li>
      <li>
        <kbd>?</kbd>
        <span class="shortcuts-modal__desc">Show shortcuts</span>
      </li>
      <li>
        <kbd>Esc</kbd>
        <span class="shortcuts-modal__desc">Close dialog</span>
      </li>
    </ul>
  </div>
</div>

<style>
  .shortcuts-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .shortcuts-modal[aria-hidden="false"] {
    display: flex;
  }

  .shortcuts-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .shortcuts-modal__content {
    position: relative;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    max-width: 380px;
    width: 90%;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .shortcuts-modal__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .shortcuts-modal__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0;
  }

  .shortcuts-modal__close {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }

  .shortcuts-modal__close:hover {
    color: var(--color-text-primary);
  }

  .shortcuts-modal__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .shortcuts-modal__list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .shortcuts-modal__list kbd {
    display: inline-block;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-primary);
    min-width: 28px;
    text-align: center;
  }

  .shortcuts-modal__list span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .shortcuts-modal__desc {
    margin-left: auto;
    color: var(--color-text-secondary) !important;
    font-size: var(--text-sm) !important;
  }
</style>

<script is:inline>
  (function () {
    const modal = document.getElementById('shortcuts-modal');
    if (!modal) return;

    const closeBtn = modal.querySelector('.shortcuts-modal__close');
    const backdrop = modal.querySelector('.shortcuts-modal__backdrop');

    function openModal() {
      modal.setAttribute('aria-hidden', 'false');
    }
    function closeModal() {
      modal.setAttribute('aria-hidden', 'true');
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (backdrop) backdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', function (e) {
      // Non attivare se un input/textarea ha il focus
      var tag = document.activeElement ? document.activeElement.tagName : '';
      var isEditable = tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' ||
        (document.activeElement && document.activeElement.isContentEditable);

      // Esc chiude sempre il modale
      if (e.key === 'Escape') {
        closeModal();
        // Chiude anche eventuali dialog di ricerca
        return;
      }

      if (isEditable) return;

      // Ctrl+K: apre la ricerca
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        var searchBtn = document.querySelector('[data-search-trigger]') ||
          document.querySelector('button[aria-label*="earch"], button[aria-label*="erca"], button[aria-label*="uscar"]');
        if (searchBtn) searchBtn.click();
        return;
      }

      // / apre la ricerca
      if (e.key === '/') {
        e.preventDefault();
        var searchBtn2 = document.querySelector('[data-search-trigger]') ||
          document.querySelector('button[aria-label*="earch"], button[aria-label*="erca"], button[aria-label*="uscar"]');
        if (searchBtn2) searchBtn2.click();
        return;
      }

      // H: vai alla homepage
      if (e.key === 'h' || e.key === 'H') {
        var lang = document.documentElement.lang || 'en';
        window.location.href = '/' + lang + '/';
        return;
      }

      // ?: mostra il modale scorciatoie
      if (e.key === '?') {
        e.preventDefault();
        if (modal.getAttribute('aria-hidden') === 'false') {
          closeModal();
        } else {
          openModal();
        }
      }
    });
  })();
</script>
