---
/**
 * TopPickBadge — badge dorato "Top Pick" per prodotti con punteggio >= 9.0
 * Non renderizza nulla se il punteggio e inferiore a 9
 */
interface Props {
  score: number;
  label?: string;
}

const { score, label = 'Top Pick' } = Astro.props;
const show = score >= 9;
---

{show && (
  <span class="top-pick-badge" title={label}>
    <svg class="top-pick-badge__star" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
    <span class="top-pick-badge__text">{label}</span>
  </span>
)}

<style>
  .top-pick-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #1a1a1a;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
    white-space: nowrap;
    line-height: 1.4;
  }

  .top-pick-badge__star {
    flex-shrink: 0;
  }
</style>
