---
/**
 * ReviewJsonLd — Genera markup Schema.org JSON-LD per Product + Review + AggregateRating
 * Necessario per i rich snippet nei risultati di ricerca Google
 */
import type { StrapiReview, StrapiEntity } from '@lib/types';
import type { Locale } from '@lib/i18n';
import { localizedRoutes } from '@lib/i18n';

interface Props {
  review: StrapiReview & StrapiEntity;
  productImageUrl: string | null;
  locale: Locale;
  siteUrl: string;
}

const { review, productImageUrl, locale, siteUrl } = Astro.props;

// Null guard su score_overall (default 0 se undefined)
const ratingValue = review.score_overall ?? 0;

// Costruisci l'oggetto JSON-LD seguendo le specifiche Schema.org
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: review.product?.name || review.title,
  description: review.excerpt || '',
  url: `${siteUrl}/${locale}/${localizedRoutes.reviews[locale]}/${review.slug}`,
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: ratingValue,
      bestRating: 10,
      worstRating: 0,
    },
    author: {
      '@type': 'Organization',
      name: 'BBQ Experience',
    },
    reviewBody: review.verdict || '',
    datePublished: review.published_date || review.publishedAt || undefined,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: ratingValue,
    bestRating: 10,
    worstRating: 0,
    ratingCount: 1,
    reviewCount: 1,
  },
};

// Aggiungi brand solo se disponibile
if (review.product?.brand) {
  jsonLd.brand = {
    '@type': 'Brand',
    name: review.product.brand,
  };
}

// Aggiungi immagine solo se disponibile
if (productImageUrl) {
  jsonLd.image = productImageUrl;
}

// Aggiungi categoria solo se disponibile
if (review.product?.category) {
  jsonLd.category = review.product.category;
}

// Aggiungi offers con affiliate links
const affiliateLinks = review.product?.affiliate_links;
if (affiliateLinks && affiliateLinks.length > 0) {
  jsonLd.offers = affiliateLinks.map((link: any) => ({
    '@type': 'Offer',
    url: link.url,
    seller: {
      '@type': 'Organization',
      name: link.retailer,
    },
    availability: 'https://schema.org/InStock',
  }));
} else if (review.product?.affiliate_url) {
  jsonLd.offers = {
    '@type': 'Offer',
    url: review.product.affiliate_url,
    availability: 'https://schema.org/InStock',
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(JSON.parse(JSON.stringify(jsonLd)))} />
