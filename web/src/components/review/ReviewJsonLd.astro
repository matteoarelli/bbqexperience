---
/**
 * ReviewJsonLd — Genera markup Schema.org JSON-LD per Product + Review + AggregateRating
 * Necessario per i rich snippet nei risultati di ricerca Google
 */
import type { StrapiReview, StrapiEntity } from '@lib/types';

interface Props {
  review: StrapiReview & StrapiEntity;
  productImageUrl: string | null;
  locale: string;
  siteUrl: string;
}

const { review, productImageUrl, locale, siteUrl } = Astro.props;

// Costruisci l'oggetto JSON-LD seguendo le specifiche Schema.org
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: review.product?.name || review.title,
  description: review.excerpt || '',
  review: {
    '@type': 'Review',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: review.score_overall,
      bestRating: 10,
      worstRating: 0,
    },
    author: {
      '@type': 'Person',
      name: 'BBQ Experience',
    },
    reviewBody: review.verdict || '',
    datePublished: review.published_date || review.publishedAt || '',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: review.score_overall,
    bestRating: 10,
    worstRating: 0,
    ratingCount: 1,
    reviewCount: 1,
  },
};

// Aggiungi brand solo se disponibile
if (review.product?.brand) {
  jsonLd.brand = {
    '@type': 'Brand',
    name: review.product.brand,
  };
}

// Aggiungi immagine solo se disponibile
if (productImageUrl) {
  jsonLd.image = productImageUrl;
}

// Aggiungi categoria solo se disponibile
if (review.product?.category) {
  jsonLd.category = review.product.category;
}
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
