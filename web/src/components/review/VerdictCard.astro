---
/**
 * VerdictCard — Card riassuntiva con verdetto finale della recensione
 * Mostra immagine prodotto, punteggio badge, testo verdetto e top 2 pro/contro
 */
import { getTranslation } from '@lib/i18n';

interface Props {
  overall: number;
  verdict: string | null;
  pros: string[] | null;
  cons: string[] | null;
  productName: string;
  productImage: string | null;
  productImageAlt: string;
  translations: Record<string, any>;
}

const { overall, verdict, pros, cons, productName, productImage, productImageAlt, translations } = Astro.props;

// Solo i primi 2 pro e contro per la versione compatta
const topPros = pros?.slice(0, 2) ?? [];
const topCons = cons?.slice(0, 2) ?? [];

// Iniziale del nome prodotto per il placeholder
const initial = productName.charAt(0).toUpperCase();
---

<section
  class="bg-[var(--color-bg-elevated)] rounded-[var(--radius-xl)] p-6 md:p-8 border"
  style="border-color: var(--color-border-accent); box-shadow: var(--shadow-glow-fire);"
  data-animate
>
  <!-- Titolo sezione -->
  <h2
    class="text-2xl uppercase tracking-wider mb-6"
    style="font-family: var(--font-heading); color: var(--color-text-primary);"
  >
    {getTranslation(translations, 'review.verdictCard')}
  </h2>

  <div class="flex flex-col md:flex-row gap-6">
    <!-- Immagine prodotto (sinistra) -->
    <div class="md:w-1/3 shrink-0">
      {productImage ? (
        <img
          src={productImage}
          alt={productImageAlt}
          class="w-full aspect-square object-cover rounded-[var(--radius-lg)]"
        />
      ) : (
        <div
          class="w-full aspect-square rounded-[var(--radius-lg)] flex items-center justify-center"
          style="background-color: var(--color-bg-tertiary);"
        >
          <span
            class="text-6xl font-bold"
            style="font-family: var(--font-heading); color: var(--color-text-muted);"
          >
            {initial}
          </span>
        </div>
      )}
    </div>

    <!-- Contenuto verdetto (destra) -->
    <div class="md:w-2/3 flex flex-col">
      <!-- Nome prodotto -->
      <h3
        class="text-xl uppercase tracking-wider"
        style="font-family: var(--font-heading); color: var(--color-text-primary);"
      >
        {productName}
      </h3>

      <!-- Badge punteggio -->
      <div class="mt-2">
        <span
          class="inline-block font-bold rounded-[var(--radius-md)] px-3 py-1 text-lg"
          style="background-color: var(--color-accent-fire); color: var(--color-text-inverse);"
        >
          {overall}/10
        </span>
      </div>

      <!-- Testo verdetto -->
      {verdict && (
        <p
          class="italic text-lg mt-3"
          style="color: var(--color-text-secondary);"
        >
          {verdict}
        </p>
      )}

      <!-- Pro/Contro compatti -->
      {(topPros.length > 0 || topCons.length > 0) && (
        <div class="mt-4 space-y-2">
          {topPros.map((pro) => (
            <div class="flex items-center gap-2 text-sm" style="color: var(--color-text-secondary);">
              <span class="w-2 h-2 rounded-full bg-green-500 shrink-0" />
              <span>{pro}</span>
            </div>
          ))}
          {topCons.map((con) => (
            <div class="flex items-center gap-2 text-sm" style="color: var(--color-text-secondary);">
              <span class="w-2 h-2 rounded-full bg-red-500 shrink-0" />
              <span>{con}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
