---
/**
 * Galleria foto con lightbox full-screen — BBQ Experience
 * Griglia thumbnail responsive + overlay lightbox con navigazione tastiera
 */
import type { StrapiMedia } from '@lib/types';
import { getStrapiMediaURL, getStrapiImageFormats, getStrapiMediaAlt } from '@lib/media';

interface Props {
  images: StrapiMedia[] | null;
  title: string;
}

const { images, title } = Astro.props;

// Non renderizzare se non ci sono immagini
if (!images || images.length === 0) {
  return;
}

// Prepara dati per ogni immagine
const galleryImages = images.map((image, index) => {
  const formats = getStrapiImageFormats(image);
  const thumbnailSrc = formats.medium || formats.small || getStrapiMediaURL(image) || '';
  const fullSrc = getStrapiMediaURL(image) || '';
  const alt = getStrapiMediaAlt(image) || `Photo ${index + 1}`;
  return { thumbnailSrc, fullSrc, alt };
});
---

<section class="photo-gallery">
  <h2
    class="text-2xl uppercase tracking-wider mb-[var(--space-6)]"
    style="font-family: var(--font-heading); color: var(--color-text-primary);"
  >
    {title}
  </h2>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-[var(--space-3)]">
    {galleryImages.map((img, index) => (
      <button
        type="button"
        class="group cursor-pointer overflow-hidden rounded-[var(--radius-md)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent-fire)]"
        data-gallery-index={index}
        data-gallery-full={img.fullSrc}
        aria-label={`${img.alt} - open lightbox`}
      >
        <img
          src={img.thumbnailSrc}
          alt={img.alt}
          class="aspect-square object-cover w-full transition-transform duration-[var(--transition-base)] group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-[var(--transition-base)] ring-2 ring-inset ring-[var(--color-accent-fire)] rounded-[var(--radius-md)] pointer-events-none" />
      </button>
    ))}
  </div>
</section>

<!-- Lightbox overlay (nascosto di default) -->
<div id="gallery-lightbox" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Image gallery">
  <div id="lightbox-backdrop" class="flex items-center justify-center h-full w-full p-4 md:p-8">
    <!-- Immagine principale -->
    <img
      id="lightbox-image"
      class="max-h-[85vh] max-w-[90vw] object-contain rounded-[var(--radius-lg)]"
      src=""
      alt=""
    />
  </div>

  <!-- Pulsante chiudi -->
  <button
    id="lightbox-close"
    type="button"
    class="absolute top-4 right-4 w-10 h-10 rounded-full bg-[var(--color-bg-elevated)] flex items-center justify-center transition-colors duration-[var(--transition-fast)] hover:bg-[var(--color-accent-fire)] cursor-pointer focus:outline-2 focus:outline-offset-2 focus:outline-[var(--color-accent-fire)]"
    aria-label="Close lightbox"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Pulsante precedente -->
  <button
    id="lightbox-prev"
    type="button"
    class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-[var(--color-bg-elevated)] flex items-center justify-center transition-colors duration-[var(--transition-fast)] hover:bg-[var(--color-accent-fire)] cursor-pointer focus:outline-2 focus:outline-offset-2 focus:outline-[var(--color-accent-fire)]"
    aria-label="Previous image"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <!-- Pulsante successivo -->
  <button
    id="lightbox-next"
    type="button"
    class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-[var(--color-bg-elevated)] flex items-center justify-center transition-colors duration-[var(--transition-fast)] hover:bg-[var(--color-accent-fire)] cursor-pointer focus:outline-2 focus:outline-offset-2 focus:outline-[var(--color-accent-fire)]"
    aria-label="Next image"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Contatore immagini -->
  <div
    id="lightbox-counter"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-sm"
    style="color: var(--color-text-muted);"
  ></div>

  <!-- Didascalia -->
  <div
    id="lightbox-caption"
    class="absolute bottom-12 left-1/2 -translate-x-1/2 text-sm text-center max-w-lg"
    style="color: var(--color-text-secondary);"
  ></div>
</div>

<style>
  .photo-gallery button {
    position: relative;
  }
</style>

<script>
  // Logica lightbox galleria foto
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement;
  const counter = document.getElementById('lightbox-counter');
  const caption = document.getElementById('lightbox-caption');
  const buttons = document.querySelectorAll('[data-gallery-index]');
  let currentIndex = 0;
  let triggerElement: HTMLElement | null = null;
  const images: { src: string; alt: string }[] = [];

  // Popola array immagini dai data attributes
  buttons.forEach((btn) => {
    images.push({
      src: btn.getAttribute('data-gallery-full') || '',
      alt: (btn.querySelector('img') as HTMLImageElement)?.alt || '',
    });
  });

  function showImage(index: number) {
    currentIndex = (index + images.length) % images.length;
    lightboxImg.src = images[currentIndex].src;
    lightboxImg.alt = images[currentIndex].alt;
    if (counter) counter.textContent = `${currentIndex + 1} / ${images.length}`;
    if (caption) caption.textContent = images[currentIndex].alt;
  }

  function openLightbox(index: number) {
    triggerElement = document.activeElement as HTMLElement;
    showImage(index);
    lightbox?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    document.querySelector<HTMLElement>('#lightbox-close')?.focus();
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    document.body.style.overflow = '';
    triggerElement?.focus();
    triggerElement = null;
  }

  // Event listeners
  buttons.forEach((btn, i) => btn.addEventListener('click', () => openLightbox(i)));
  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => showImage(currentIndex - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => showImage(currentIndex + 1));

  // Chiudi con click sullo sfondo (non sull'immagine)
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox || (e.target as HTMLElement).id === 'lightbox-backdrop') closeLightbox();
  });

  // Navigazione tastiera
  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (e.key === 'ArrowRight') showImage(currentIndex + 1);
  });
</script>
