---
/**
 * Card anteprima recensione — immagine prodotto, punteggio, titolo, excerpt
 */
import type { StrapiReview, StrapiEntity } from '@lib/types';
import { getStrapiMediaURL } from '@lib/media';

interface Props {
  review: StrapiReview & StrapiEntity;
  locale: string;
  reviewsRoute: string;
}

const { review, locale, reviewsRoute } = Astro.props;

// Immagine: primo elemento galleria o immagine prodotto
const imageUrl = getStrapiMediaURL(review.gallery?.[0] ?? review.product?.images?.[0] ?? null);
const score = review.score_overall;
---

<a href={`/${locale}/${reviewsRoute}/${review.slug}/`} class="review-card" data-animate>
  <div class="review-card__image-wrapper">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={review.title}
        class="review-card__image"
        width="640"
        height="400"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="review-card__placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
      </div>
    )}
    {/* Badge punteggio */}
    <div class="review-card__score">
      <span class="review-card__score-value">{score.toFixed(1)}</span>
    </div>
  </div>
  <div class="review-card__content">
    <h3 class="review-card__title">{review.title}</h3>
    {review.excerpt && (
      <p class="review-card__excerpt">{review.excerpt}</p>
    )}
    {review.product?.brand && (
      <span class="review-card__brand">{review.product.brand}</span>
    )}
  </div>
</a>

<style>
  .review-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .review-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-fire);
  }

  .review-card__image-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: var(--color-bg-tertiary);
  }

  .review-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .review-card:hover .review-card__image {
    transform: scale(1.05);
  }

  .review-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-tertiary);
  }

  .review-card__score {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background-color: var(--color-accent-fire);
    color: white;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 900;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(249, 115, 22, 0.4);
  }

  .review-card__content {
    padding: var(--space-4);
    flex: 1;
  }

  .review-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.2;
  }

  .review-card__excerpt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0 0 var(--space-3) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .review-card__brand {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background: var(--color-bg-tertiary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }
</style>
