---
/**
 * Sezione "Chi e BBQ Experience?" — storia del brand con accento fuoco
 * Include contatori animati per le statistiche principali.
 */
import { getTranslation } from '@lib/i18n';
import AnimatedCounter from '@components/common/AnimatedCounter.svelte';

interface Props {
  translations: Record<string, any>;
  locale?: string;
}

const { translations, locale = 'en' } = Astro.props;
const t = (key: string) => getTranslation(translations, key);

// Etichette statistiche per lingua
const statsLabels: Record<string, { followers: string; posts: string; products: string; recipes: string }> = {
  en: { followers: 'People Who Trust Us', posts: 'Years at the Grill', products: 'Products Destroyed', recipes: 'Sponsored Scores' },
  it: { followers: 'Persone Che Si Fidano', posts: 'Anni alla Griglia', products: 'Prodotti Distrutti', recipes: 'Voti Sponsorizzati' },
  es: { followers: 'Personas Que Confian', posts: 'Anos en la Parrilla', products: 'Productos Destruidos', recipes: 'Puntuaciones Patrocinadas' },
};

const labels = statsLabels[locale] ?? statsLabels.en;
---

<section class="about-section" data-animate>
  <div class="container-bbq">
    <div class="about-card">
      <div class="about-card__icon">
        <svg width="40" height="40" viewBox="0 0 32 32" fill="none">
          <path d="M16 4C16 4 10 12 10 18C10 21.3 12.7 24 16 24C19.3 24 22 21.3 22 18C22 12 16 4 16 4Z" fill="#F97316"/>
          <path d="M16 10C16 10 13 14.5 13 17.5C13 19.4 14.3 21 16 21C17.7 21 19 19.4 19 17.5C19 14.5 16 10 16 10Z" fill="#FBBF24"/>
        </svg>
      </div>
      <h2 class="about-card__title">{t('home.aboutTitle')}</h2>
      <p class="about-card__text">{t('home.aboutText')}</p>

      <!-- Griglia statistiche con contatori animati -->
      <div class="about-stats">
        <div class="stat-item">
          <span class="stat-number">
            <AnimatedCounter target={74} suffix="K+" duration={1500} client:visible />
          </span>
          <span class="stat-label">{labels.followers}</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">
            <AnimatedCounter target={20} suffix="+" duration={1200} client:visible />
          </span>
          <span class="stat-label">{labels.posts}</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">
            <AnimatedCounter target={100} suffix="+" duration={1500} client:visible />
          </span>
          <span class="stat-label">{labels.products}</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">
            <AnimatedCounter target={0} suffix="" duration={800} client:visible />
          </span>
          <span class="stat-label">{labels.recipes}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: var(--space-16) 0;
  }

  .about-card {
    background-color: var(--color-bg-secondary);
    border: 2px solid var(--color-accent-fire);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-8);
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    position: relative;
    overflow: hidden;
  }

  .about-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(249, 115, 22, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .about-card__icon {
    margin-bottom: var(--space-4);
    position: relative;
  }

  .about-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4) 0;
    line-height: 1.1;
    position: relative;
  }

  .about-card__text {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.7;
    margin: 0 0 var(--space-8) 0;
    position: relative;
  }

  /* === Griglia statistiche === */
  .about-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    position: relative;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .about-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-accent-fire);
    line-height: 1;
  }

  .stat-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }
</style>
