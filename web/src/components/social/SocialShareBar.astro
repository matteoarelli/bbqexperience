---
// Barra di condivisione social — copia link, WhatsApp, Instagram, X (Twitter)
import type { Locale } from '@lib/i18n';
import { getTranslation } from '@lib/i18n';

interface Props {
  url: string;
  title: string;
  locale: Locale;
  translations: Record<string, any>;
}

const { url, title, translations } = Astro.props;

// URL di condivisione per ciascun canale
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`;
const twitterUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
const instagramUrl = 'https://instagram.com/bbqexperience';

// Label tradotte
const labelCopyLink = getTranslation(translations, 'social.copyLink');
const labelCopied = getTranslation(translations, 'social.copied');
const labelWhatsApp = getTranslation(translations, 'social.shareWhatsApp');
const labelInstagram = getTranslation(translations, 'social.shareInstagram');
const labelX = getTranslation(translations, 'social.shareX');
---

<div class="share-bar" role="group" aria-label={getTranslation(translations, 'social.share')}>
  {/* Bottone Copia Link */}
  <button
    class="share-bar__btn"
    type="button"
    data-share-copy
    data-url={url}
    data-label-default={labelCopyLink}
    data-label-copied={labelCopied}
  >
    <svg class="share-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
    </svg>
    <span class="share-bar__label">{labelCopyLink}</span>
  </button>

  {/* WhatsApp */}
  <a
    class="share-bar__btn"
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg class="share-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
    </svg>
    <span class="share-bar__label">{labelWhatsApp}</span>
  </a>

  {/* Instagram (link al profilo, IG non ha API di condivisione) */}
  <a
    class="share-bar__btn"
    href={instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg class="share-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
    </svg>
    <span class="share-bar__label">{labelInstagram}</span>
  </a>

  {/* X (Twitter) */}
  <a
    class="share-bar__btn"
    href={twitterUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg class="share-bar__icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
    </svg>
    <span class="share-bar__label">{labelX}</span>
  </a>
</div>

<script>
  // Gestione click "Copia Link" con feedback visivo
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-share-copy]') as HTMLButtonElement | null;
    if (!btn) return;

    const url = btn.dataset.url || window.location.href;
    const labelEl = btn.querySelector('.share-bar__label');
    const defaultLabel = btn.dataset.labelDefault || 'Copy Link';
    const copiedLabel = btn.dataset.labelCopied || 'Copied!';

    navigator.clipboard.writeText(url).then(() => {
      if (labelEl) labelEl.textContent = copiedLabel;
      btn.classList.add('share-bar__btn--copied');

      setTimeout(() => {
        if (labelEl) labelEl.textContent = defaultLabel;
        btn.classList.remove('share-bar__btn--copied');
      }, 2000);
    }).catch(() => {
      // Fallback per browser senza clipboard API
      const textarea = document.createElement('textarea');
      textarea.value = url;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);

      if (labelEl) labelEl.textContent = copiedLabel;
      setTimeout(() => {
        if (labelEl) labelEl.textContent = defaultLabel;
      }, 2000);
    });
  });
</script>

<style>
  .share-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .share-bar__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-family: var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .share-bar__btn:hover {
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border-color: var(--color-border-default);
  }

  .share-bar__btn--copied {
    color: var(--color-accent-fire);
    border-color: var(--color-accent-fire);
  }

  .share-bar__icon {
    flex-shrink: 0;
  }

  /* Mobile: nascondi le label, mostra solo icone */
  @media (max-width: 767px) {
    .share-bar__label {
      display: none;
    }

    .share-bar__btn {
      padding: var(--space-2);
    }
  }
</style>
