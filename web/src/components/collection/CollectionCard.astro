---
/**
 * Card anteprima raccolta ricette — immagine hero, titolo, conteggio ricette, descrizione
 */
import type { StrapiRecipeCollection, StrapiEntity } from '@lib/types';
import { getStrapiMediaURL, buildStrapiSrcset } from '@lib/media';
import { getTranslation } from '@lib/i18n';
import type { Locale } from '@lib/i18n';
import ImageWithPlaceholder from '@components/common/ImageWithPlaceholder.astro';

interface Props {
  collection: StrapiRecipeCollection & StrapiEntity;
  locale: Locale;
  collectionsRoute: string;
  translations: Record<string, any>;
}

const { collection, locale, collectionsRoute, translations } = Astro.props;
const t = (key: string) => getTranslation(translations, key);

const imageUrl = getStrapiMediaURL(collection.hero_image, { width: 640 });
const srcset = buildStrapiSrcset(collection.hero_image, [320, 640, 960]);
const recipeCount = collection.recipes?.length || 0;
const description = collection.description
  ? collection.description.length > 120
    ? collection.description.slice(0, 117) + '...'
    : collection.description
  : null;
---

<a href={`/${locale}/${collectionsRoute}/${collection.slug}/`} class="collection-card card-hover">
  <div class="collection-card__image-wrapper">
    {imageUrl ? (
      <ImageWithPlaceholder
        src={imageUrl}
        srcset={srcset || undefined}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        alt={collection.hero_image?.alternativeText || collection.title}
        class="collection-card__image"
        width="640"
        height="400"
      />
    ) : (
      <div class="collection-card__placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3">
          <rect x="3" y="3" width="7" height="7" rx="1"/>
          <rect x="14" y="3" width="7" height="7" rx="1"/>
          <rect x="3" y="14" width="7" height="7" rx="1"/>
          <rect x="14" y="14" width="7" height="7" rx="1"/>
        </svg>
      </div>
    )}
    <div class="collection-card__overlay"></div>
    {recipeCount > 0 && (
      <span class="collection-card__count-badge">
        {t('collections.recipesCount').replace('{count}', String(recipeCount))}
      </span>
    )}
  </div>
  <div class="collection-card__content">
    <h3 class="collection-card__title">{collection.title}</h3>
    {description && (
      <p class="collection-card__description">{description}</p>
    )}
  </div>
</a>

<style>
  .collection-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), border-color var(--transition-base);
  }

  .collection-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent-fire);
  }

  .collection-card__image-wrapper {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background-color: var(--color-bg-tertiary);
  }

  .collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .collection-card:hover .collection-card__image {
    transform: scale(1.05);
  }

  .collection-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-tertiary);
  }

  .collection-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(transparent, var(--color-bg-secondary));
    pointer-events: none;
  }

  .collection-card__count-badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: var(--color-accent-fire);
    color: #fff;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    z-index: 1;
  }

  .collection-card__content {
    padding: var(--space-4);
    flex: 1;
  }

  .collection-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2) 0;
    line-height: 1.15;
  }

  .collection-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
