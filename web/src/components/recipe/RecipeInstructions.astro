---
/**
 * Istruzioni della ricetta — lista numerata con foto opzionali per ogni passaggio
 */
import type { RecipeInstruction } from '@lib/types';
import { getStrapiMediaURL, getStrapiMediaAlt } from '@lib/media';

interface Props {
  instructions: RecipeInstruction[] | null;
}

const { instructions } = Astro.props;

// Non renderizzare nulla se non ci sono istruzioni
if (!instructions || instructions.length === 0) {
  return;
}

// Ordina per numero di step
const sortedSteps = [...instructions].sort((a, b) => a.step - b.step);
---

<ol class="instructions-list space-y-8 list-none p-0 m-0">
  {sortedSteps.map((instruction) => {
    const stepImageUrl = instruction.image ? getStrapiMediaURL(instruction.image) : null;
    const stepImageAlt = instruction.image ? getStrapiMediaAlt(instruction.image) || `Step ${instruction.step}` : '';

    return (
      <li class="instruction-step">
        {/* Indicatore step con linea connettore */}
        <div class="instruction-step__indicator">
          <div class="instruction-step__number">
            {instruction.step}
          </div>
          <div class="instruction-step__line"></div>
        </div>

        <div class="flex-1 min-w-0">
          {/* Titolo dello step (se presente) */}
          {(instruction as any).title && (
            <h4
              class="font-bold mb-1 uppercase tracking-wide"
              style="font-family: var(--font-heading); color: var(--color-accent-fire); font-size: var(--text-sm);"
            >
              {(instruction as any).title}
            </h4>
          )}
          {/* Testo dell'istruzione */}
          <p
            class="leading-relaxed"
            style="color: var(--color-text-primary); font-family: var(--font-body);"
          >
            {instruction.text || (instruction as any).detail || (instruction as any).description || ''}
          </p>

          {/* Immagine opzionale dello step */}
          {stepImageUrl && (
            <img
              src={stepImageUrl}
              alt={stepImageAlt}
              class="mt-3 w-full max-w-full rounded-lg object-cover"
              loading="lazy"
            />
          )}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .instruction-step {
    display: flex;
    gap: var(--space-4);
  }

  .instruction-step__indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .instruction-step__number {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 900;
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, var(--color-accent-fire), var(--color-accent-ember));
    box-shadow: 0 2px 10px rgba(249, 115, 22, 0.3);
    flex-shrink: 0;
  }

  .instruction-step__line {
    width: 2px;
    flex: 1;
    min-height: 20px;
    background: linear-gradient(180deg, var(--color-accent-fire), transparent);
    margin-top: var(--space-2);
  }

  /* Ultimo step: niente linea */
  .instruction-step:last-child .instruction-step__line {
    display: none;
  }
</style>
