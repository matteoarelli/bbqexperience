---
/**
 * Pulsante "Vai alla Ricetta" — ancora che salta l'intro editoriale
 * Appare fisso in basso a destra su mobile, in alto su desktop
 */
interface Props {
  label: string;
  totalTime?: number | null;
}

const { label, totalTime } = Astro.props;

// Formatta il tempo totale in una stringa leggibile
function formatTime(minutes: number): string {
  if (minutes < 60) return `${minutes} min`;
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return m > 0 ? `${h}h ${m}min` : `${h}h`;
}

const timeLabel = totalTime ? ` - ${formatTime(totalTime)}` : '';
---

<a
  href="#recipe-card"
  id="jump-to-recipe-btn"
  class="hidden fixed bottom-4 right-4 z-40 px-5 py-3 rounded-full shadow-lg
         transition-all duration-300 ease-in-out
         md:bottom-auto md:top-4 md:right-4
         hover:scale-105 active:scale-95"
  style={`
    background-color: var(--color-accent-fire);
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    box-shadow: var(--shadow-glow-fire);
  `}
>
  {label}{timeLabel}
</a>

<script>
  // Mostra/nasconde il pulsante in base alla posizione dello scroll
  const btn = document.getElementById('jump-to-recipe-btn');
  const target = document.getElementById('recipe-card');

  if (btn && target) {
    const observer = new IntersectionObserver(
      (entries) => {
        // Se il recipe-card e visibile, nascondi il pulsante
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            btn.classList.add('hidden');
          } else {
            // Mostra solo se lo scroll e oltre l'inizio della pagina
            if (window.scrollY > 200) {
              btn.classList.remove('hidden');
            } else {
              btn.classList.add('hidden');
            }
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(target);

    // Gestisci anche lo scroll per mostrare/nascondere in base alla posizione
    window.addEventListener('scroll', () => {
      const targetRect = target.getBoundingClientRect();
      if (targetRect.top > window.innerHeight && window.scrollY > 200) {
        btn.classList.remove('hidden');
      } else if (targetRect.top <= window.innerHeight) {
        btn.classList.add('hidden');
      }
    }, { passive: true });
  }
</script>
