---
/**
 * Bottone stampa ricetta con QR code — BBQ Experience
 * Il bottone e visibile a schermo, il QR code appare solo in stampa.
 */
interface Props {
  recipeUrl: string;
  label?: string;
}

const { recipeUrl, label = 'Print Recipe' } = Astro.props;

const encodedUrl = encodeURIComponent(recipeUrl);
const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=${encodedUrl}`;
---

<!-- Bottone stampa (nascosto in print) -->
<button
  type="button"
  class="print-btn no-print"
  onclick="window.print()"
>
  <!-- Icona stampante -->
  <svg class="print-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z" />
  </svg>
  {label}
</button>

<!-- QR code (visibile solo in stampa) -->
<div class="print-only print-qr">
  <img
    src={qrUrl}
    alt="QR code to full recipe"
    width="100"
    height="100"
    loading="lazy"
  />
  <p>Scan for full recipe</p>
  <p style="font-size: 8pt; color: #666 !important;">{recipeUrl}</p>
</div>

<style>
  .print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-default);
    border-radius: 0.375rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 150ms ease;
  }

  .print-btn:hover {
    background-color: var(--color-bg-elevated);
    border-color: var(--color-text-muted);
  }

  .print-btn__icon {
    width: 1.125rem;
    height: 1.125rem;
  }
</style>
