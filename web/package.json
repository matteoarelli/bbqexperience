{
  "name": "bbqexperience-web",
  "private": true,
  "version": "1.0.0",
  "description": "BBQ Experience - Astro 6 frontend",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npx pagefind --site dist/client --output-subdir ../pagefind",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/node": "^10.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/svelte": "^8.0.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/oswald": "^5.2.8",
    "@sentry/node": "^10.47.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.2",
    "better-sqlite3": "^12.8.0",
    "gsap": "^3.14.2",
    "pagefind": "^1.4.0",
    "sharp": "^0.34.5",
    "svelte": "^5.55.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "vitest": "^4.1.2"
  }
}
