{
  "kind": "collectionType",
  "collectionName": "recipes",
  "info": {
    "singularName": "recipe",
    "pluralName": "recipes",
    "displayName": "Recipe",
    "description": "Ricette BBQ con istruzioni passo-passo, tempi di cottura e ingredienti"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "excerpt": {
      "type": "text",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "editorial_intro": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "ingredients": {
      "type": "json",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "instructions": {
      "type": "json",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "prep_time": {
      "type": "integer"
    },
    "cook_time": {
      "type": "integer"
    },
    "total_time": {
      "type": "integer"
    },
    "servings": {
      "type": "integer"
    },
    "difficulty": {
      "type": "enumeration",
      "enum": ["easy", "medium", "hard", "expert"]
    },
    "meat_type": {
      "type": "enumeration",
      "enum": ["beef", "pork", "chicken", "lamb", "fish", "vegetarian", "mixed"]
    },
    "technique": {
      "type": "enumeration",
      "enum": ["grilling", "smoking", "roasting", "braising", "other"]
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "seo_title": {
      "type": "string",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "seo_description": {
      "type": "text",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "published_date": {
      "type": "date"
    }
  }
}
