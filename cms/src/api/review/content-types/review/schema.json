{
  "kind": "collectionType",
  "collectionName": "reviews",
  "info": {
    "singularName": "review",
    "pluralName": "reviews",
    "displayName": "Review",
    "description": "Recensioni approfondite di prodotti BBQ con punteggi per categoria"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "excerpt": {
      "type": "text",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "editorial_content": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "verdict": {
      "type": "text",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "score_overall": {
      "type": "decimal",
      "required": true
    },
    "score_build_quality": {
      "type": "decimal"
    },
    "score_performance": {
      "type": "decimal"
    },
    "score_value": {
      "type": "decimal"
    },
    "score_ease_of_use": {
      "type": "decimal"
    },
    "pros": {
      "type": "json",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "cons": {
      "type": "json",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "seo_title": {
      "type": "string",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "seo_description": {
      "type": "text",
      "pluginOptions": {
        "i18n": { "localized": true }
      }
    },
    "published_date": {
      "type": "date"
    }
  }
}
