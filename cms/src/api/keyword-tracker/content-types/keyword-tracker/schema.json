{
  "kind": "collectionType",
  "collectionName": "keyword_trackers",
  "info": {
    "singularName": "keyword-tracker",
    "pluralName": "keyword-trackers",
    "displayName": "Keyword Tracker",
    "description": "Monitoraggio posizione keyword per SEO"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": false
    }
  },
  "attributes": {
    "keyword": {
      "type": "string",
      "required": true
    },
    "locale": {
      "type": "enumeration",
      "enum": ["en", "it", "es"],
      "default": "en",
      "required": true
    },
    "cluster": {
      "type": "enumeration",
      "enum": ["smoking", "grills", "thermometers", "brisket", "sauces", "uncategorized"],
      "default": "uncategorized"
    },
    "position": {
      "type": "decimal"
    },
    "impressions": {
      "type": "integer",
      "default": 0
    },
    "clicks": {
      "type": "integer",
      "default": 0
    },
    "ctr": {
      "type": "decimal"
    },
    "last_checked": {
      "type": "datetime"
    },
    "trend": {
      "type": "enumeration",
      "enum": ["rising", "stable", "falling"],
      "default": "stable"
    },
    "is_low_hanging": {
      "type": "boolean",
      "default": false
    }
  }
}
